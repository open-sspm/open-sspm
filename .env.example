# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/opensspm?sslmode=disable

# Server
HTTP_ADDR=:8080
# Internal metrics listener (set to "off" to disable).
# METRICS_ADDR=127.0.0.1:9090
# Structured logging (valid: json|text and debug|info|warn|error).
LOG_FORMAT=json
LOG_LEVEL=info
# Optional: absolute path to the built static assets directory (e.g. /opt/open-sspm/web/static).
# When unset, the server tries to locate web/static relative to the current working directory.
# STATIC_DIR=
AUTH_COOKIE_SECURE=0
# Optional: comma-separated ingress or proxy CIDRs to trust in X-Forwarded-For in addition to the default
# private/link-local/loopback ranges. Set this when your direct upstream uses public IPs.
# TRUSTED_PROXY_CIDRS=35.191.0.0/16,130.211.0.0/22
RESYNC_ENABLED=1
# Set to 0 to disable the full sync lane worker.
SYNC_FULL_ENABLED=1
# Set to 0 to disable the discovery sync lane entirely.
SYNC_DISCOVERY_ENABLED=1
# Set to 0 to disable event inbox receivers and the ingest lane.
# EVENT_INBOX_ENABLED=1
# `signal` is the default durable manual-sync queue handled by background workers.
# `inline` runs the sync directly in the request.
RESYNC_MODE=signal
GLOBAL_EVAL_MODE=best_effort

# Dev convenience: seed admin@admin.com / admin if no auth users exist.
# DEV_SEED_ADMIN=0
# Startup read-model refresh defaults to `auto`: only rebuild full projections when they are missing.
# Set to `always` to force a full rebuild during process startup.
# STARTUP_READ_MODEL_REBUILD_MODE=auto

# Connector credentials are configured in-app under Settings -> Connectors.
# Secret values are stored encrypted in Postgres and require a stable base64-encoded 32-byte key.
# Set either CONNECTOR_SECRET_KEY or CONNECTOR_SECRET_KEY_FILE.
# CONNECTOR_SECRET_KEY=
# CONNECTOR_SECRET_KEY_FILE=/path/to/connector-secret-key

# Sync
SYNC_INTERVAL=15m
SYNC_DISCOVERY_INTERVAL=15m
SYNC_TAIL_INTERVAL=5m

# Sync locking (recommended: lease-based locks; avoids pgxpool deadlocks on small pools)
# SYNC_LOCK_MODE=lease
# SYNC_LOCK_TTL=60s
# SYNC_LOCK_HEARTBEAT_INTERVAL=15s
# SYNC_LOCK_HEARTBEAT_TIMEOUT=15s
# Optional instance identifier for lock observability (defaults to HOSTNAME / os.Hostname()).
# SYNC_LOCK_INSTANCE_ID=

# Optional per-connector intervals (leave unset to use SYNC_INTERVAL cadence)
# SYNC_OKTA_INTERVAL=15m
# SYNC_ENTRA_INTERVAL=15m
# SYNC_GOOGLE_WORKSPACE_INTERVAL=15m
# SYNC_GITHUB_INTERVAL=15m
# SYNC_DATADOG_INTERVAL=15m
# SYNC_AWS_INTERVAL=15m
# SYNC_FAILURE_BACKOFF_MAX=2h

# Event inbox worker tuning
# EVENT_INBOX_BATCH_SIZE=500
# EVENT_INBOX_POLL_INTERVAL=5s
# EVENT_INBOX_CLEANUP_INTERVAL=1h
# EVENT_INBOX_RETRY_DELAY=30s
# EVENT_INBOX_RETRY_MAX_DELAY=15m
# EVENT_INBOX_STALE_PROCESSING_TIMEOUT=5m
# EVENT_INBOX_MAX_ATTEMPTS=10
# EVENT_INBOX_PROCESSED_RETENTION_DAYS=30
# EVENT_INBOX_DEAD_LETTER_RETENTION_DAYS=90

# Event evaluator worker tuning
# EVENT_EVALUATOR_WORKER_POLL_INTERVAL=5s
# EVENT_EVALUATOR_WORKER_BATCH_SIZE=100
# EVENT_EVALUATOR_WORKER_MAX_ATTEMPTS=10

# Canonical event partition maintenance
# EVENT_PARTITION_MAINTENANCE_INTERVAL=12h
# EVENT_PARTITION_FUTURE_DAYS=7
# EVENT_RETENTION_DAYS=90

SYNC_OKTA_WORKERS=3
SYNC_GITHUB_WORKERS=6
SYNC_DATADOG_WORKERS=3
