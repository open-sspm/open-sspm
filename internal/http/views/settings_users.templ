package views

import (
	"github.com/open-sspm/open-sspm/internal/http/events"
	"github.com/open-sspm/open-sspm/internal/http/viewmodels"
)

templ SettingsUsersPage(data viewmodels.SettingsUsersViewData) {
	@Layout(data.Layout) {
		@PageHeader("") {
			<a id="settings-users-add-trigger" class="btn-sm-primary" href="/settings/users?open=add" hx-get="/settings/users/new" hx-target="body" hx-swap="beforeend">Add user</a>
		}

		if data.Alert != nil && !data.OpenAdd && !data.OpenEdit && !data.OpenDelete {
			@Alert(data.Alert.Title, data.Alert.Destructive) {
				<p>{ data.Alert.Message }</p>
			}
		}

		@SettingsUsersPanel(data)
		if data.OpenAdd {
			@SettingsUsersAddDialog(data)
		}
		if data.OpenEdit {
			@SettingsUsersEditDialog(data)
		}
		if data.OpenDelete {
			@SettingsUsersDeleteDialog(data)
		}
	}
}

templ SettingsUsersPanel(data viewmodels.SettingsUsersViewData) {
	@settingsUsersPanel(data, false)
}

templ SettingsUsersPanelOOB(data viewmodels.SettingsUsersViewData) {
	@settingsUsersPanel(data, true)
}

templ settingsUsersPanel(data viewmodels.SettingsUsersViewData, oob bool) {
	<section
		id="settings-users-panel"
		class="space-y-3"
		hx-get="/settings/users"
		hx-trigger={ events.BusTrigger(events.SettingsUsersChanged) }
		hx-target="this"
		hx-sync="this:replace"
		if oob {
			hx-swap-oob="outerHTML"
		}
	>
		@settingsUsersPanelContent(data)
	</section>
}

templ settingsUsersPanelContent(data viewmodels.SettingsUsersViewData) {
		@ColumnsTable("") {
			<table class="table osspm-table-compact osspm-table-list">
				<caption class="sr-only">Local users, roles, status, last login, and account actions.</caption>
				<thead>
					<tr>
						<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Email</th>
						<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Group</th>
						<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Status</th>
						<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Last login</th>
						<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground"></th>
					</tr>
				</thead>
				<tbody>
					if data.HasUsers {
						for _, u := range data.Users {
							<tr>
								<td class="font-medium whitespace-normal break-words" hx-disable>{ u.Email }</td>
								<td>
									<span class={ AuthUserRoleBadgeClass(u.Role) }>{ HumanizeAuthUserRole(u.Role) }</span>
								</td>
								<td>
									<span class={ AuthUserStatusBadgeClass(u.IsActive) }>{ AuthUserStatusLabel(u.IsActive) }</span>
								</td>
								<td class="text-muted-foreground whitespace-nowrap" title={ u.LastLogin.Title }>{ u.LastLogin.Label }</td>
								<td class="text-right">
									<div class="dropdown-menu">
										<button type="button" id={ "settings-users-actions-" + FormatInt64(u.ID) + "-trigger" } aria-haspopup="menu" aria-controls={ "settings-users-actions-" + FormatInt64(u.ID) + "-menu" } aria-expanded="false" class="btn-icon-ghost cursor-pointer" aria-label={ "Actions for " + u.Email }>
											@IconEllipsis("size-4 text-muted-foreground")
										</button>
										<div data-popover data-side="bottom" data-align="end" aria-hidden="true" class="min-w-56">
											<div role="menu" id={ "settings-users-actions-" + FormatInt64(u.ID) + "-menu" } aria-labelledby={ "settings-users-actions-" + FormatInt64(u.ID) + "-trigger" }>
												<a id={ "settings-users-edit-trigger-" + FormatInt64(u.ID) } role="menuitem" class="cursor-pointer" href={ "/settings/users?open=edit&id=" + FormatInt64(u.ID) } hx-get={ "/settings/users/" + FormatInt64(u.ID) + "/edit" } hx-target="body" hx-swap="beforeend">
													@IconPencil("size-4 text-muted-foreground")
													Edit
												</a>
												if u.CanDelete {
													<a id={ "settings-users-delete-trigger-" + FormatInt64(u.ID) } role="menuitem" class="text-destructive cursor-pointer" href={ "/settings/users?open=delete&id=" + FormatInt64(u.ID) } hx-get={ "/settings/users/" + FormatInt64(u.ID) + "/delete" } hx-target="body" hx-swap="beforeend">
														@IconTrash2("size-4 text-destructive")
														Delete
													</a>
												} else {
													<div role="menuitem" class="text-destructive" aria-disabled="true">
														@IconTrash2("size-4 text-destructive")
														Delete
													</div>
												}
											</div>
										</div>
									</div>
								</td>
							</tr>
						}
					} else {
						<tr>
							<td colspan="5">
								@EmptyState("No users found", "Add a user to allow others to sign in.") {
									<a class="btn-sm-primary" href="/settings/users?open=add" hx-get="/settings/users/new" hx-target="body" hx-swap="beforeend">Add user</a>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
}

templ SettingsUsersAddDialog(data viewmodels.SettingsUsersViewData) {
	@HtmxFormDialog("settings-users-add-modal", data.OpenAdd, "Add user", "Create a new local user account.", "/settings/users", "Create user", data.Layout.CSRFToken) {
		if data.Alert != nil {
			@Alert(data.Alert.Title, data.Alert.Destructive) {
				<p>{ data.Alert.Message }</p>
			}
		}
		<label class="field">
			<span class="label">Email</span>
			<input type="email" name="email" class="input w-full" value={ data.Form.Email } placeholder="person@example.com" autocomplete="email"/>
		</label>
		<label class="field">
			<span class="label">Group</span>
			<select name="role" class="input w-full">
				<option value="viewer" selected?={ data.Form.Role == "viewer" }>Viewer</option>
				<option value="admin" selected?={ data.Form.Role == "admin" }>Admin</option>
			</select>
			<p class="text-xs text-muted-foreground">Admins can manage connectors, resync, and create users.</p>
		</label>
		<label class="field">
			<span class="label">Password</span>
			<input type="password" name="password" class="input w-full" autocomplete="new-password"/>
			<p class="text-xs text-muted-foreground">At least 8 characters.</p>
		</label>
		<label class="field">
			<span class="label">Confirm password</span>
			<input type="password" name="confirm_password" class="input w-full" autocomplete="new-password"/>
		</label>
	}
}

templ SettingsUsersEditDialog(data viewmodels.SettingsUsersViewData) {
	@HtmxFormDialog("settings-users-edit-modal", data.OpenEdit, "Edit user", "Update password and group.", "/settings/users/"+FormatInt64(data.EditForm.ID), "Save changes", data.Layout.CSRFToken) {
		if data.Alert != nil {
			@Alert(data.Alert.Title, data.Alert.Destructive) {
				<p>{ data.Alert.Message }</p>
			}
		}
		<label class="field">
			<span class="label">Email</span>
			<input type="email" class="input w-full" value={ data.EditForm.Email } disabled/>
		</label>
		<label class="field">
			<span class="label">Group</span>
			<select name="role" class="input w-full" disabled?={ data.EditForm.RoleDisabled }>
				<option value="viewer" selected?={ data.EditForm.Role == "viewer" }>Viewer</option>
				<option value="admin" selected?={ data.EditForm.Role == "admin" }>Admin</option>
			</select>
			if data.EditForm.RoleDisabledReason != "" {
				<p class="text-xs text-muted-foreground">{ data.EditForm.RoleDisabledReason }</p>
			}
		</label>
		<label class="field">
			<span class="label">New password</span>
			<input type="password" name="password" class="input w-full" autocomplete="new-password"/>
			<p class="text-xs text-muted-foreground">Leave blank to keep the current password.</p>
		</label>
		<label class="field">
			<span class="label">Confirm new password</span>
			<input type="password" name="confirm_password" class="input w-full" autocomplete="new-password"/>
		</label>
	}
}

templ SettingsUsersDeleteDialog(data viewmodels.SettingsUsersViewData) {
	@HtmxFormDialog("settings-users-delete-modal", data.OpenDelete, "Delete user", "This will permanently delete the user account.", "/settings/users/"+FormatInt64(data.Delete.ID)+"/delete", "Delete user", data.Layout.CSRFToken) {
		if data.Alert != nil {
			@Alert(data.Alert.Title, data.Alert.Destructive) {
				<p>{ data.Alert.Message }</p>
			}
		}
		<div class="space-y-2">
			<div class="text-sm font-medium">User</div>
			<div class="text-sm text-muted-foreground" hx-disable>{ data.Delete.Email }</div>
		</div>
	}
}
