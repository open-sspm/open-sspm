package views

import "github.com/open-sspm/open-sspm/internal/http/viewmodels"

templ CredentialShowPage(data viewmodels.CredentialShowViewData) {
	@Layout(data.Layout) {
		<div class="mx-auto w-full min-w-0 max-w-5xl space-y-10 py-2">
			@credentialShowHeader(data.Credential)
			@credentialShowMetadata(data.Credential)
			@credentialShowFindings(data)
			@credentialShowScope(data.Credential, data.ScopeJSON)
			@credentialShowActivity(data)
		</div>
	}
}

templ credentialShowHeader(c viewmodels.CredentialArtifactSummaryView) {
	<header class="space-y-4 border-b border-border/60 pb-6">
		<div>
			<a class="text-xs text-muted-foreground hover:text-foreground" href="/credentials">← Credentials</a>
		</div>
		<div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
			<div class="min-w-0 space-y-2">
				<p class="text-xs uppercase tracking-wide text-muted-foreground">
					<span>{ c.CredentialKind }</span>
					<span class="px-1.5 text-muted-foreground/50">·</span>
					<span>{ c.SourceKind }</span>
					if c.SourceName != "" {
							<span class="text-muted-foreground/70" hx-disable>{ " (" }{ c.SourceName }{ ")" }</span>
					}
				</p>
					<h1 class="text-2xl font-semibold leading-tight tracking-tight break-words md:text-3xl" hx-disable>{ c.DisplayName }</h1>
					<p class="font-mono text-xs text-muted-foreground break-all" hx-disable>{ c.ExternalID }</p>
			</div>
			<div class="flex flex-wrap items-center gap-2 md:justify-end md:pt-1">
				<span class={ CredentialStatusBadgeClass(c.Status) }>{ HumanizeCredentialStatus(c.Status) }</span>
				<span class={ CredentialRiskBadgeClass(c.RiskLevel) }>{ HumanizeCredentialRisk(c.RiskLevel) }{ " risk" }</span>
			</div>
		</div>
	</header>
}

templ credentialShowMetadata(c viewmodels.CredentialArtifactSummaryView) {
	<section aria-label="Credential details" class="space-y-6">
		<dl class="grid grid-cols-2 gap-x-6 gap-y-6 md:grid-cols-5">
			@credentialShowField("Created", c.CreatedAtSource.Label, c.CreatedAtSource.Relative, "")
			@credentialShowField("Expires", c.ExpiresAtSource.Label, c.ExpiresAtSource.Relative, "")
			@credentialShowField("Last used", c.LastUsedAtSource.Label, c.LastUsedAtSource.Relative, "")
			@credentialShowLinkField("Creator", c.CreatedBy, c.CreatedByHref)
			@credentialShowLinkField("Approver", c.ApprovedBy, c.ApprovedByHref)
		</dl>
		@credentialShowAssetField(c)
	</section>
}

templ credentialShowField(label, value, relative, valueClass string) {
	<div class="min-w-0 space-y-1">
		<dt class="text-[11px] font-medium uppercase tracking-wide text-muted-foreground">{ label }</dt>
		if value == "" || value == "—" {
			<dd class="text-sm text-muted-foreground/60">—</dd>
		} else {
			<dd class={ "text-sm font-medium break-words", valueClass }>{ value }</dd>
			if relative != "" {
				<dd class="text-xs text-muted-foreground">{ relative }</dd>
			}
		}
	</div>
}

templ credentialShowLinkField(label, value, href string) {
	<div class="min-w-0 space-y-1">
		<dt class="text-[11px] font-medium uppercase tracking-wide text-muted-foreground">{ label }</dt>
		if value == "" || value == "—" {
			<dd class="text-sm text-muted-foreground/60">—</dd>
		} else if href != "" {
			<dd class="min-w-0"><a class="btn-sm-link px-0 text-sm font-medium break-words" href={ href }>{ value }</a></dd>
		} else {
			<dd class="text-sm font-medium break-words">{ value }</dd>
		}
	</div>
}

templ credentialShowAssetField(c viewmodels.CredentialArtifactSummaryView) {
	<div class="min-w-0 space-y-1">
		<dt class="text-[11px] font-medium uppercase tracking-wide text-muted-foreground">Asset</dt>
		if c.AssetRefKind == "" || c.AssetRefKind == "—" {
			<dd class="text-sm text-muted-foreground/60">—</dd>
		} else if c.AssetHref != "" {
				<dd class="min-w-0 text-sm"><a class="btn-sm-link px-0 font-medium break-all" href={ c.AssetHref }><span hx-disable>{ c.AssetRefKind }{ " · " }{ c.AssetRefExternalID }</span></a></dd>
			} else {
				<dd class="text-sm font-medium break-all" hx-disable>{ c.AssetRefKind }{ " · " }{ c.AssetRefExternalID }</dd>
			}
	</div>
}

templ credentialShowFindings(data viewmodels.CredentialShowViewData) {
	<section aria-label="Risk findings" class="space-y-4">
		<div class="flex items-baseline justify-between">
			<h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">Risk findings</h2>
			if data.HasFindings {
				<span class="text-xs text-muted-foreground">{ FormatInt(len(data.RiskFindings)) }{ pluralizeSuffix(len(data.RiskFindings), " finding", " findings") }</span>
			}
		</div>
		if data.HasFindings {
			<ul class="divide-y divide-border/60 border-t border-border/60">
				for _, finding := range data.RiskFindings {
					<li class="flex flex-col gap-2 py-3 sm:flex-row sm:items-start sm:gap-4">
						<div class="flex min-w-[120px] items-center gap-2 pt-0.5">
							<span class={ "inline-block h-1.5 w-1.5 rounded-full", RiskSeverityDotClass(finding.Severity) }></span>
							<span class={ "text-xs font-medium", CredentialRiskTextClass(finding.Severity) }>{ HumanizeRiskSeverity(finding.Severity) }</span>
						</div>
						<div class="flex-1 space-y-0.5">
							<p class="text-sm font-medium">{ finding.Title }</p>
							if finding.Evidence != "" {
								<p class="text-xs text-muted-foreground">{ finding.Evidence }</p>
							}
						</div>
					</li>
				}
			</ul>
		} else {
			<p class="text-sm text-emerald-700 dark:text-emerald-400">No active findings. Credential metadata appears healthy.</p>
		}
	</section>
}

templ credentialShowScope(c viewmodels.CredentialArtifactSummaryView, scopeJSON string) {
	<section aria-label="Scope" class="space-y-3">
		<details class="group">
			<summary class="flex cursor-pointer list-none flex-wrap items-center gap-x-2 gap-y-1 text-sm font-semibold uppercase tracking-wide text-muted-foreground hover:text-foreground">
				<svg class="h-3 w-3 shrink-0 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path></svg>
				<span>Scope</span>
					<span class="min-w-0 break-all font-mono text-xs font-normal normal-case tracking-normal text-muted-foreground/80" hx-disable>{ c.AssetRefKind }{ " · " }{ c.AssetRefExternalID }</span>
			</summary>
			<pre class="mt-3 overflow-x-auto rounded-md border border-border/60 bg-muted/30 p-4 font-mono text-xs leading-relaxed"><code>{ scopeJSON }</code></pre>
		</details>
	</section>
}

templ credentialShowActivity(data viewmodels.CredentialShowViewData) {
	<section aria-label="Recent activity" class="space-y-4">
		<div class="flex items-baseline justify-between">
			<h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">Recent activity</h2>
			if data.HasEvents {
				<span class="text-xs text-muted-foreground">{ FormatInt(len(data.AuditEvents)) }{ pluralizeSuffix(len(data.AuditEvents), " event", " events") }</span>
			}
		</div>
		if data.HasEvents {
			<div class="overflow-x-auto border-t border-border/60">
				<table class="w-full text-sm">
					<thead>
						<tr class="border-b border-border/60 text-left">
							<th class="py-2 pr-4 text-xs font-medium uppercase tracking-wide text-muted-foreground">Time</th>
							<th class="py-2 pr-4 text-xs font-medium uppercase tracking-wide text-muted-foreground">Event</th>
							<th class="py-2 pr-4 text-xs font-medium uppercase tracking-wide text-muted-foreground">Actor</th>
							<th class="py-2 pr-4 text-xs font-medium uppercase tracking-wide text-muted-foreground">Target</th>
						</tr>
					</thead>
					<tbody>
						for _, event := range data.AuditEvents {
							<tr class="border-b border-border/40 last:border-0">
								<td class="py-2 pr-4 align-top whitespace-nowrap">{ event.EventTime.Label }</td>
								<td class="py-2 pr-4 align-top">{ event.EventType }</td>
								<td class="py-2 pr-4 align-top">{ event.Actor }</td>
								<td class="py-2 pr-4 align-top">{ event.Target }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		} else {
			<p class="text-sm text-muted-foreground">No audit events recorded for this credential.</p>
		}
	</section>
}
