package views

import "github.com/open-sspm/open-sspm/internal/http/viewmodels"

templ OktaAccountShowPage(data viewmodels.SourceAccountShowViewData) {
	@Layout(data.Layout) {
		@PageHeader("")
		<div class="mx-auto w-full min-w-0 max-w-5xl space-y-12 py-2">
			@oktaAccountShowHeader(data)
			if data.OktaSection != nil {
				@oktaAccountShowGroups(data.OktaSection.Groups)
				@oktaAccountShowAssignments(data.OktaSection)
			}
			@oktaAccountShowIdentityFooter(data)
		</div>
	}
}

templ oktaAccountShowHeader(data viewmodels.SourceAccountShowViewData) {
	<header class="space-y-4">
		<div>
			<a class="text-xs text-muted-foreground hover:text-foreground" href="/accounts/okta">← Okta accounts</a>
		</div>
		<div class="space-y-3">
			<h1 class="text-3xl font-semibold leading-tight tracking-tight break-words md:text-4xl">
				if data.Account.Email != "" {
					{ data.Account.Email }
				} else {
					{ data.Account.DisplayName }
				}
			</h1>
			<p class="text-sm text-muted-foreground break-words">
				@oktaAccountShowMetaLine(data)
			</p>
			if data.Account.ExternalID != "" {
				<div class="flex min-w-0 items-center gap-2">
					<span class="font-mono text-xs text-muted-foreground/80 break-all">{ data.Account.ExternalID }</span>
					@CopyTextButton(data.Account.ExternalID, "Copy external ID")
				</div>
			}
		</div>
	</header>
}

templ oktaAccountShowMetaLine(data viewmodels.SourceAccountShowViewData) {
	<span>{ HumanizeAccountStatus(data.Account.Status) }</span>
	{{ source := data.Account.SourceName }}
	if source != "" {
		<span class="px-1.5 text-muted-foreground/50">·</span>
		<span>{ source }</span>
	}
	if data.Account.DisplayName != "" && data.Account.DisplayName != data.Account.Email {
		<span class="px-1.5 text-muted-foreground/50">·</span>
		<span>{ data.Account.DisplayName }</span>
	}
	if data.LastLoginAt.Relative != "" && data.LastLoginAt.Relative != "—" {
		<span class="px-1.5 text-muted-foreground/50">·</span>
		<span>{ "Last login " }{ data.LastLoginAt.Relative }</span>
	} else if data.LastObservedAt.Relative != "" && data.LastObservedAt.Relative != "—" {
		<span class="px-1.5 text-muted-foreground/50">·</span>
		<span>{ "Last seen " }{ data.LastObservedAt.Relative }</span>
	}
}

templ oktaAccountShowGroups(groups []viewmodels.OktaGroupBadge) {
	<section aria-label="Group memberships" class="space-y-3">
		<div class="flex items-baseline justify-between">
			<h2 class="text-base font-medium">Groups</h2>
			if len(groups) > 0 {
				<span class="text-xs text-muted-foreground tabular-nums">{ FormatInt(len(groups)) }</span>
			}
		</div>
		if len(groups) > 0 {
			<div class="flex flex-wrap gap-1.5">
				for _, group := range groups {
					<span class="inline-flex items-center rounded-md border border-border/50 px-2 py-0.5 text-xs text-muted-foreground" title={ group.ExternalID }>{ group.Name }</span>
				}
			</div>
		} else {
			<p class="text-sm text-muted-foreground">Not a member of any synced groups.</p>
		}
	</section>
}

templ oktaAccountShowAssignments(section *viewmodels.OktaInspectorSection) {
	<section aria-label="App assignments" class="space-y-3">
		<div class="flex items-baseline justify-between">
			<h2 class="text-base font-medium">Apps</h2>
			if section.AssignmentCount > 0 {
				<span class="text-xs text-muted-foreground tabular-nums">{ FormatInt(section.AssignmentCount) }</span>
			}
		</div>
		if section.AssignmentCount > 0 {
			@ColumnsTable("") {
				<table class="table min-w-[52rem] osspm-table-fixed osspm-table-compact osspm-table-list">
					<caption class="sr-only">Okta apps assigned to this account.</caption>
					<colgroup>
						<col class="w-[42%]"/>
						<col class="w-[20%]"/>
						<col class="w-[32%]"/>
						<col class="w-[6%]"/>
					</colgroup>
					<thead>
						<tr>
							<th>App</th>
							<th>Assigned via</th>
							<th>Attributes</th>
							<th aria-hidden="true"></th>
						</tr>
					</thead>
					<tbody>
						for _, a := range section.Assignments {
							<tr class="app-row group" data-row-href={ a.AppHref }>
								<td class="pr-3">
									<div class="flex min-w-0 items-center gap-3">
										@ProductIcon(a.AppLabel, a.AppName, "", "size-8")
										<span class="min-w-0 flex-1">
											if a.AppHref != "" {
												<a class="osspm-truncate font-medium text-foreground no-underline hover:underline" href={ a.AppHref } title={ a.AppLabel }>{ a.AppLabel }</a>
											} else {
												<span class="osspm-truncate font-medium text-foreground" title={ a.AppLabel }>{ a.AppLabel }</span>
											}
											if a.AppName != "" && a.AppName != a.AppLabel {
												<span class="osspm-truncate text-xs text-muted-foreground/70" title={ a.AppName }>{ a.AppName }</span>
											}
										</span>
									</div>
								</td>
								<td class="px-3">
									<span class="osspm-cell-primary font-normal text-muted-foreground">{ a.AssignedVia }</span>
									if a.AssignedVia == "Group" && len(a.Groups) > 0 {
										<span class="osspm-cell-secondary truncate" title={ a.Groups[0] }>
											{ a.Groups[0] }
											if len(a.Groups) > 1 {
												<span class="text-muted-foreground/50">{ " +" }{ FormatInt(len(a.Groups) - 1) }</span>
											}
										</span>
									}
								</td>
								<td class="px-3">
									if len(a.Attributes) > 0 {
										<span class="osspm-cell-primary truncate font-normal text-muted-foreground" title={ a.Attributes[0].Text }>{ a.Attributes[0].Text }</span>
										if len(a.Attributes) > 1 {
											<span class="osspm-cell-secondary">
												{ "+" }{ FormatInt(len(a.Attributes) - 1) }{ " attributes" }
											</span>
										}
									}
								</td>
								<td class="pl-3 text-right align-middle">
									if a.AppHref != "" {
										@IconChevronRight("inline-block h-3.5 w-3.5 text-muted-foreground/30 transition-colors group-hover:text-muted-foreground")
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		} else {
			@EmptyState("No apps assigned", "No apps assigned to this account.")
		}
	</section>
}

templ oktaAccountShowIdentityFooter(data viewmodels.SourceAccountShowViewData) {
	if data.IdentityHref != "" {
		<div class="pt-4">
			<a class="text-sm text-muted-foreground hover:text-foreground" href={ data.IdentityHref }>
				{ "← Part of identity " }
				if data.IdentityName != "" {
					<span class="font-medium text-foreground">{ data.IdentityName }</span>
				}
			</a>
		</div>
	}
}
