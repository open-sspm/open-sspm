package views

import "github.com/open-sspm/open-sspm/internal/http/viewmodels"

templ CredentialsPage(data viewmodels.CredentialsViewData) {
	@Layout(data.Layout) {
		@CredentialsPageFilters(data)
		@CredentialsPageResults(data)
	}
}

templ CredentialsPageFilters(data viewmodels.CredentialsViewData) {
		<form
			method="get"
			action="/credentials"
			data-enter-only-query="q"
			hx-get="/credentials"
			hx-trigger="change delay:150ms from:[data-table-query-trigger], submit"
			hx-sync="this:replace"
			hx-target="#credentials-results"
			hx-push-url="true"
			class="osspm-list-form-tight"
		>
			<div class="osspm-list-toolbar">
				<div class="min-w-0 flex-1">
					@AskBar(CredentialsAskBar(data)) {
						@credentialsAskBarSort(data)
					}
					@AskBarGrammarHints(CredentialsAskBar(data))
				</div>
			</div>
			<button class="sr-only" type="submit">Apply filters</button>
		</form>
}

templ CredentialsPageResults(data viewmodels.CredentialsViewData) {
	<div id="credentials-results" class="space-y-5">
		@BusyInlineIndicator("Updating results...", false)
		@KPIStrip(CredentialsKPICards(data))
		@credentialsListMeta(data)

		<section class="space-y-3">
			if data.HasItems {
				<div class="space-y-3 md:hidden">
					for _, item := range data.Items {
						@credentialCardMobile(item, data.HasLastUsedData)
					}
				</div>
				@ColumnsTable("hidden md:block") {
					<table class="table osspm-table-fixed osspm-table-compact osspm-table-list osspm-table-credentials">
						<caption class="sr-only">Credentials with state, expiration, and bound asset metadata.</caption>
						<colgroup>
							<col class="osspm-col-credential"/>
							<col class="osspm-col-kind"/>
							<col class="osspm-col-asset"/>
							<col class="osspm-col-time"/>
							<col class="osspm-col-risk"/>
							if data.HasLastUsedData {
								<col class="osspm-col-time"/>
							}
						</colgroup>
						<thead>
							<tr>
								<th>Credential</th>
								<th>Kind</th>
								<th>Asset</th>
								<th class="osspm-num">Expires</th>
								<th>State</th>
								if data.HasLastUsedData {
									<th class="osspm-num">Last used</th>
								}
							</tr>
						</thead>
						<tbody>
							for _, item := range data.Items {
								@credentialRowDesktop(item, data.HasLastUsedData)
							}
						</tbody>
					</table>
				}
			} else {
				@EmptyState("No credentials found", data.EmptyStateMsg) {
					if data.Layout.IsAdmin {
						<a class="btn-sm-outline" href="/settings/connectors">Configure connectors</a>
					}
				}
			}
			if data.TotalPages > 1 {
				<div class="osspm-list-pagination">
					<div class="text-sm text-muted-foreground">{ "Page " }{ FormatInt(data.Page) }{ " of " }{ FormatInt(data.TotalPages) }</div>
					<div class="button-group ml-auto">
						if data.Page > 1 {
							<a class="btn-sm-outline" href={ data.Query.WithPage(data.Page-1).Href() } hx-get={ data.Query.WithPage(data.Page-1).Href() } hx-target="#credentials-results" hx-swap="outerHTML show:top" hx-push-url="true">Previous</a>
						} else {
							<span class="btn-sm-outline opacity-50" aria-disabled="true">Previous</span>
						}
						if data.Page < data.TotalPages {
							<a class="btn-sm-outline" href={ data.Query.WithPage(data.Page+1).Href() } hx-get={ data.Query.WithPage(data.Page+1).Href() } hx-target="#credentials-results" hx-swap="outerHTML show:top" hx-push-url="true">Next</a>
						} else {
							<span class="btn-sm-outline opacity-50" aria-disabled="true">Next</span>
						}
					</div>
				</div>
			}
		</section>
	</div>
}

templ credentialsAskBarSort(data viewmodels.CredentialsViewData) {
	<label class="osspm-askbar-action">
		<span class="osspm-askbar-action-label">Sort:</span>
		<select class="osspm-askbar-action-select" name="sort_by" data-table-query-trigger aria-label="Sort credentials">
			<option value="expires_soonest" selected?={ data.Query.SortBy == "" || data.Query.SortBy == "expires_soonest" }>Expires soonest</option>
			<option value="risk" selected?={ data.Query.SortBy == "risk" }>Highest risk</option>
			<option value="asset" selected?={ data.Query.SortBy == "asset" }>Asset</option>
			<option value="credential" selected?={ data.Query.SortBy == "credential" }>Credential</option>
		</select>
	</label>
}

templ credentialsListMeta(data viewmodels.CredentialsViewData) {
	<div class="osspm-list-meta" role="status">
		<div class="osspm-list-meta-summary">
			<span class="osspm-list-meta-count">{ FormatInt64(data.TotalCount) }{ " matching" }</span>
		</div>
		<div class="osspm-list-meta-actions">
			<a class="btn-sm-outline osspm-export-button" href={ data.Query.ExportHref() } hx-boost="false" download="credentials-export.csv" aria-label="Export credentials">
				@IconDownload("h-3.5 w-3.5")
				<span>Export</span>
			</a>
		</div>
	</div>
}

templ credentialCardMobile(item viewmodels.CredentialArtifactListItem, hasLastUsed bool) {
	<a href={ templ.SafeURL("/credentials/" + FormatInt64(item.ID)) } class="osspm-identity-card">
		<div class="flex items-start justify-between gap-3">
			<div class="min-w-0">
				<div class="flex min-w-0 items-center gap-2">
					@ProductIconMark(HumanizeProgrammaticKind(item.SourceKind), item.SourceKind, "", "h-4 w-4 shrink-0 text-muted-foreground")
					<span class="font-medium truncate" title={ item.DisplayName }>{ item.NamePrimary }</span>
					if item.VersionCount > 1 {
						<span class="osspm-version-pill">+{ FormatInt64(item.VersionCount - 1) }{ " older" }</span>
					}
				</div>
				if item.NameSecondary != "" {
					<div class="text-sm text-muted-foreground truncate">{ item.NameSecondary }</div>
				}
				<div class="mt-1 text-xs text-muted-foreground">
					{ HumanizeCredentialKind(item.CredentialKind) }
					if credentialShouldShowStatusInline(item.Status) {
						{ " · " }{ HumanizeCredentialStatus(item.Status) }
					}
				</div>
			</div>
			<span class={ CredentialRowStateBadgeClass(item.RowStateTone) }>{ item.RowStateLabel }</span>
		</div>
		<dl class="mt-3 grid grid-cols-2 gap-x-3 gap-y-2 text-sm">
			<div class="col-span-2 min-w-0">
				<dt class="osspm-stat-label">Asset</dt>
				<dd class="min-w-0">
					if item.AssetName != "" {
						<div class="truncate" title={ item.AssetName }>{ item.AssetName }</div>
						<code class="osspm-token truncate text-muted-foreground" title={ item.AssetRefID }>{ ShortIdentifier(item.AssetRefID) }</code>
					} else {
						<code class="osspm-token truncate text-muted-foreground" title={ item.AssetRefID }>{ ShortIdentifier(item.AssetRefID) }</code>
					}
				</dd>
			</div>
			<div>
				<dt class="osspm-stat-label">Expires</dt>
				<dd class={ "truncate " + item.ExpiresTone }>
					if item.ExpiresAt.Relative != "" {
						<span title={ item.ExpiresAt.Label }>{ item.ExpiresAt.Relative }</span>
					} else if item.ExpiresAt.Label != "" {
						{ item.ExpiresAt.Label }
					} else {
						<span class="text-muted-foreground">—</span>
					}
				</dd>
			</div>
			if hasLastUsed {
				<div>
					<dt class="osspm-stat-label">Last used</dt>
					<dd class="truncate">
						if item.LastUsedAt.Relative != "" {
							<span title={ item.LastUsedAt.Label }>{ item.LastUsedAt.Relative }</span>
						} else if item.LastUsedAt.Label != "" {
							{ item.LastUsedAt.Label }
						} else {
							<span class="text-muted-foreground">—</span>
						}
					</dd>
				</div>
			}
		</dl>
	</a>
}

templ credentialRowDesktop(item viewmodels.CredentialArtifactListItem, hasLastUsed bool) {
	<tr data-row-href={ "/credentials/" + FormatInt64(item.ID) }>
		<td>
			<a class="osspm-identity-link" href={ templ.SafeURL("/credentials/" + FormatInt64(item.ID)) }>
				<span class="osspm-identity-name flex min-w-0 items-center gap-2" data-tooltip={ item.DisplayName } data-side="top" data-align="start">
					<span class="truncate">{ item.NamePrimary }</span>
					if item.VersionCount > 1 {
						<span class="osspm-version-pill" title={ FormatInt64(item.VersionCount) + " versions" }>+{ FormatInt64(item.VersionCount - 1) }{ " older" }</span>
					}
				</span>
				<span class="osspm-identity-meta">
					if item.NameSecondary != "" {
						<span class="osspm-identity-email truncate" title={ item.NameSecondary }>{ item.NameSecondary }</span>
					}
					if credentialShouldShowStatusInline(item.Status) {
						<span class="osspm-identity-status">{ HumanizeCredentialStatus(item.Status) }</span>
					}
				</span>
			</a>
		</td>
		<td>
			<span class="osspm-cell-primary font-normal truncate" title={ item.CredentialKind }>{ HumanizeCredentialKind(item.CredentialKind) }</span>
		</td>
		<td>
			if item.AssetName != "" {
				<span class="osspm-cell-primary truncate" title={ item.AssetName }>{ item.AssetName }</span>
				<code class="osspm-cell-secondary osspm-token truncate text-muted-foreground" title={ item.AssetRefID }>{ ShortIdentifier(item.AssetRefID) }</code>
			} else {
				<div class="flex min-w-0 items-center gap-2">
					<code class="osspm-token truncate text-muted-foreground" title={ item.AssetRefID }>{ ShortIdentifier(item.AssetRefID) }</code>
					@CopyTextButton(item.AssetRefID, "Copy asset reference")
				</div>
			}
		</td>
		<td class="osspm-num tabular-nums">
			if item.ExpiresAt.Relative != "" {
				<span class={ item.ExpiresTone } title={ item.ExpiresAt.Label }>{ item.ExpiresAt.Relative }</span>
			} else if item.ExpiresAt.Label != "" {
				<span class={ item.ExpiresTone }>{ item.ExpiresAt.Label }</span>
			} else {
				<span class="text-muted-foreground">—</span>
			}
		</td>
		<td><span class={ CredentialRowStateBadgeClass(item.RowStateTone) }>{ item.RowStateLabel }</span></td>
		if hasLastUsed {
			<td class="osspm-num tabular-nums">
				if item.LastUsedAt.Relative != "" {
					<span title={ item.LastUsedAt.Label }>{ item.LastUsedAt.Relative }</span>
				} else if item.LastUsedAt.Label != "" {
					{ item.LastUsedAt.Label }
				} else {
					<span class="text-muted-foreground">—</span>
				}
			</td>
		}
	</tr>
}
