package views

import "github.com/open-sspm/open-sspm/internal/http/viewmodels"

templ CredentialsPage(data viewmodels.CredentialsViewData) {
	@Layout(data.Layout) {
		@CredentialsPageResults(data)
	}
}

templ CredentialsPageResults(data viewmodels.CredentialsViewData) {
	<div id="credentials-results" class="space-y-6">
		@BusyInlineIndicator("Updating results...", false)
			<form
				method="get"
				action="/credentials"
				data-enter-only-query="q"
				hx-get="/credentials"
				hx-trigger="change delay:150ms from:[data-table-query-trigger], submit"
				hx-target="#credentials-results"
				hx-swap="outerHTML"
				hx-push-url="true"
					class="osspm-list-form"
				>
					<div class="osspm-list-toolbar">
						<div class="min-w-0 flex-1">
							@TableQueryBar(CredentialsTableQueryBar(data))
						</div>
						<div class="osspm-list-summary">
							if data.TotalCount > 0 {
								{ "Showing " }{ FormatInt(data.ShowingFrom) }{ "-" }{ FormatInt(data.ShowingTo) }{ " of " }{ FormatInt64(data.TotalCount) }
							} else {
								Showing 0
							}
						</div>
					</div>
				<button class="sr-only" type="submit">Apply filters</button>
			</form>

		<section class="space-y-3">
			if data.HasItems {
				<div class="space-y-3 md:hidden">
					for _, item := range data.Items {
						<a href={ templ.SafeURL("/credentials/" + FormatInt64(item.ID)) } class="osspm-identity-card">
							<div class="flex items-start justify-between gap-3">
								<div class="min-w-0">
									<div class="font-medium truncate">{ item.DisplayName }</div>
									<div class="text-sm text-muted-foreground truncate">
										{ HumanizeCredentialKind(item.CredentialKind) }
										{ " · " }{ HumanizeProgrammaticKind(item.SourceKind) }
									</div>
								</div>
								<span class={ CredentialRiskBadgeClass(item.RiskLevel) }>{ HumanizeCredentialRisk(item.RiskLevel) }</span>
							</div>
							<dl class="mt-3 grid grid-cols-2 gap-x-3 gap-y-2 text-sm">
								<div class="col-span-2 min-w-0">
									<dt class="osspm-stat-label">Asset</dt>
									<dd class="flex min-w-0 items-center gap-2">
										<code class="osspm-token truncate text-muted-foreground" title={ item.AssetRefID }>{ ShortIdentifier(item.AssetRefID) }</code>
										@CopyTextButton(item.AssetRefID, "Copy asset reference")
									</dd>
								</div>
								<div>
									<dt class="osspm-stat-label">Expires</dt>
									<dd class="truncate">{ item.ExpiresAt.Label }</dd>
								</div>
								<div>
									<dt class="osspm-stat-label">Last used</dt>
									<dd class="truncate">{ item.LastUsedAt.Label }</dd>
								</div>
							</dl>
						</a>
					}
				</div>
				@ColumnsTable("hidden md:block") {
					<table class="table osspm-table-fixed osspm-table-compact osspm-table-list osspm-table-credentials">
						<caption class="sr-only">Credentials with source, risk, expiration, and asset metadata.</caption>
						<colgroup>
							<col class="osspm-col-credential"/>
							<col class="osspm-col-kind"/>
							<col class="osspm-col-asset"/>
							<col class="osspm-col-risk"/>
							<col class="osspm-col-time"/>
							<col class="osspm-col-time"/>
						</colgroup>
						<thead>
							<tr>
								<th>Credential</th>
								<th>Kind</th>
								<th>Asset</th>
								<th>Risk</th>
								<th class="osspm-num">Expires</th>
								<th class="osspm-num">Last used</th>
							</tr>
						</thead>
						<tbody>
							for _, item := range data.Items {
								<tr data-row-href={ "/credentials/" + FormatInt64(item.ID) }>
									<td>
										<a class="osspm-identity-link" href={ templ.SafeURL("/credentials/" + FormatInt64(item.ID)) }>
											<span class="osspm-identity-name">{ item.DisplayName }</span>
											<span class="osspm-identity-meta">
												<span class="truncate">{ HumanizeProgrammaticKind(item.SourceKind) }</span>
												if credentialShouldShowStatusInline(item.Status) {
													<span class="osspm-identity-status">{ item.Status }</span>
												}
											</span>
										</a>
									</td>
									<td>
										<span class="osspm-cell-primary font-normal truncate" title={ item.CredentialKind }>{ HumanizeCredentialKind(item.CredentialKind) }</span>
									</td>
									<td>
										<div class="flex min-w-0 items-center gap-2">
											<code class="osspm-token truncate text-muted-foreground" title={ item.AssetRefID }>{ ShortIdentifier(item.AssetRefID) }</code>
											@CopyTextButton(item.AssetRefID, "Copy asset reference")
										</div>
										<span class="osspm-cell-secondary">{ HumanizeProgrammaticKind(item.AssetRefKind) }</span>
									</td>
									<td><span class={ CredentialRiskBadgeClass(item.RiskLevel) }>{ HumanizeCredentialRisk(item.RiskLevel) }</span></td>
									<td class="osspm-num tabular-nums">
										if item.ExpiresAt.Label != "" {
											{ item.ExpiresAt.Label }
										} else {
											<span class="text-muted-foreground">—</span>
										}
									</td>
									<td class="osspm-num tabular-nums">
										if item.LastUsedAt.Label != "" {
											{ item.LastUsedAt.Label }
										} else {
											<span class="text-muted-foreground">—</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
			} else {
					@EmptyState("No credentials found", data.EmptyStateMsg) {
						if data.Layout.IsAdmin {
							<a class="btn-sm-outline" href="/settings/connectors">Configure connectors</a>
						}
					}
				}
				if data.TotalPages > 1 {
						<div class="osspm-list-pagination">
						<div class="text-sm text-muted-foreground">{ "Page " }{ FormatInt(data.Page) }{ " of " }{ FormatInt(data.TotalPages) }</div>
						<div class="button-group ml-auto">
							if data.Page > 1 {
									<a class="btn-sm-outline" href={ data.Query.WithPage(data.Page-1).Href() } hx-get={ data.Query.WithPage(data.Page-1).Href() } hx-target="#credentials-results" hx-swap="outerHTML" hx-push-url="true">Previous</a>
							} else {
								<span class="btn-sm-outline opacity-50" aria-disabled="true">Previous</span>
							}
							if data.Page < data.TotalPages {
									<a class="btn-sm-outline" href={ data.Query.WithPage(data.Page+1).Href() } hx-get={ data.Query.WithPage(data.Page+1).Href() } hx-target="#credentials-results" hx-swap="outerHTML" hx-push-url="true">Next</a>
							} else {
								<span class="btn-sm-outline opacity-50" aria-disabled="true">Next</span>
							}
						</div>
					</div>
				}
		</section>
	</div>
}
