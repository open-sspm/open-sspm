package views

import "github.com/open-sspm/open-sspm/internal/http/viewmodels"

templ GlobalViewPage(data viewmodels.GlobalViewData) {
	@Layout(data.Layout) {
		<section class="space-y-1">
			<h2 class="text-lg font-semibold tracking-tight">Connector coverage</h2>
			<p class="text-sm text-muted-foreground">Identity and application sources configured in this workspace, with current coverage and state.</p>
		</section>

		if len(data.Cards) == 0 {
			@EmptyState("No connectors yet", "Configure a connector to start tracking identity coverage and connector health from one place.") {
				if data.Layout.IsAdmin {
					<a class="btn-sm-outline" href="/settings/connectors">Manage connectors</a>
				}
			}
		} else {
			@GlobalViewSummary(data.Cards)
			@GlobalViewGroup("Active", "Reporting coverage now", GlobalViewActiveCards(data.Cards), true)
			@GlobalViewGroup("Needs setup", "Disabled, unconfigured, or invalid", GlobalViewInactiveCards(data.Cards), false)
			if data.Layout.IsAdmin {
				<div class="flex justify-end pt-2">
					<a class="btn-sm-outline" href="/settings/connectors">Manage connectors</a>
				</div>
			}
		}
	}
}

templ GlobalViewSummary(cards []viewmodels.GlobalViewAppCard) {
	<section aria-label="Summary" class="grid grid-cols-2 gap-x-8 gap-y-5 border-y border-border py-5 sm:grid-cols-4">
		@globalViewStat("Connectors", FormatInt(len(cards)))
		@globalViewStat("Active", FormatInt(GlobalViewEnabledCount(cards)))
		@globalViewStat("Needs setup", FormatInt(GlobalViewAttentionCount(cards)))
		<div class="space-y-2">
			<p class="text-sm text-muted-foreground">Average score</p>
			if GlobalViewHasActiveScore(cards) {
				<p class="text-2xl font-semibold tabular-nums tracking-tight">{ FormatInt(GlobalViewAverageScore(cards)) }%</p>
				<div
					class="global-view-bar"
					role="progressbar"
					aria-label="Average connector score"
					aria-valuemin="0"
					aria-valuemax="100"
					aria-valuenow={ FormatInt(GlobalViewAverageScore(cards)) }
				>
					<div
						class={ templ.Classes("h-full rounded-full transition-[width] duration-500", GlobalViewScoreBarClass(GlobalViewAverageScore(cards))) }
						style={ "width: " + FormatInt(GlobalViewAverageScore(cards)) + "%" }
					></div>
				</div>
			} else {
				<p class="text-2xl font-semibold tabular-nums tracking-tight text-muted-foreground">—</p>
				<p class="text-xs text-muted-foreground">No active connectors yet</p>
			}
		</div>
	</section>
}

templ globalViewStat(label, value string) {
	<div class="space-y-1">
		<p class="text-sm text-muted-foreground">{ label }</p>
		<p class="text-2xl font-semibold tabular-nums tracking-tight">{ value }</p>
	</div>
}

templ GlobalViewGroup(title, hint string, cards []viewmodels.GlobalViewAppCard, active bool) {
	if len(cards) > 0 {
		<section aria-label={ title } class="space-y-3 pt-2">
			<header class="flex items-baseline justify-between gap-3">
				<div class="flex items-baseline gap-2">
					<h3 class="text-sm font-semibold tracking-tight">{ title }</h3>
					<span class="text-xs text-muted-foreground">{ FormatInt(len(cards)) }</span>
				</div>
				<p class="text-xs text-muted-foreground">{ hint }</p>
			</header>
			<div class="divide-y divide-border">
				for _, card := range cards {
					@GlobalViewRow(card, active)
				}
			</div>
		</section>
	}
}

templ GlobalViewRow(card viewmodels.GlobalViewAppCard, active bool) {
	<article class={ templ.Classes(
		"grid gap-4 py-4 md:grid-cols-[minmax(18rem,1.6fr)_minmax(12rem,1fr)_minmax(0,1.1fr)_auto] md:items-center md:gap-6",
		templ.KV("opacity-75", !active),
	) }>
		<div class="flex min-w-0 items-center gap-3">
			<div class="grid h-8 w-8 shrink-0 place-items-center rounded-md border border-border bg-muted/30 text-muted-foreground">
				@GlobalAppIcon(card.Kind)
			</div>
			<div class="min-w-0">
				<div class="flex flex-wrap items-baseline gap-x-2">
					<h4 class="text-sm font-semibold tracking-tight text-foreground">{ card.Name }</h4>
					if card.CategoryLabel != "" {
						<span class="text-xs text-muted-foreground">{ card.CategoryLabel }</span>
					}
				</div>
				if card.Subtitle != "" {
					<p class="truncate text-sm text-muted-foreground" title={ card.Subtitle }>{ card.Subtitle }</p>
				}
			</div>
		</div>

		if card.ShowScore {
			<div class="space-y-1.5">
				<div class="flex items-baseline justify-between gap-3">
					<span class="text-xs text-muted-foreground">{ card.ScoreLabel }</span>
					<span class="text-sm font-semibold tabular-nums">{ FormatInt(card.ScoreValue) }%</span>
				</div>
				<div
					class="global-view-bar"
					role="progressbar"
					aria-label={ card.Name + " " + card.ScoreLabel }
					aria-valuemin="0"
					aria-valuemax="100"
					aria-valuenow={ FormatInt(card.ScoreValue) }
				>
					<div
						class={ templ.Classes("h-full rounded-full transition-[width] duration-500", GlobalViewScoreBarClass(card.ScoreValue)) }
						style={ "width: " + FormatInt(card.ScoreValue) + "%" }
					></div>
				</div>
			</div>
		} else {
			<div class="text-xs text-muted-foreground">Not reporting</div>
		}

		<dl class="flex flex-wrap gap-x-6 gap-y-1 empty:hidden">
			for _, metric := range card.Metrics {
				<div class="min-w-0">
					<dt class="text-xs text-muted-foreground">{ metric.Label }</dt>
					<dd class="text-sm font-medium tabular-nums text-foreground">{ metric.Value }</dd>
				</div>
			}
		</dl>

		<div class="flex flex-wrap items-center gap-3 md:justify-end">
			<span class={ GlobalViewStatusClass(card.StatusTone) }>{ card.StatusLabel }</span>
			if card.PrimaryHref != "" && card.PrimaryLabel != "" {
				<a class="btn-sm-ghost" href={ templ.SafeURL(card.PrimaryHref) }>{ card.PrimaryLabel }<span aria-hidden="true"> →</span></a>
			}
			if card.SecondaryHref != "" && card.SecondaryLabel != "" {
				<a class="text-xs text-muted-foreground no-underline hover:text-foreground" href={ templ.SafeURL(card.SecondaryHref) }>{ card.SecondaryLabel }</a>
			}
		</div>
	</article>
}

templ GlobalAppIcon(kind string) {
	if kind == "okta" {
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4 shrink-0" aria-hidden="true">
			<circle cx="12" cy="12" r="6" fill="none" stroke="currentColor" stroke-width="3"/>
		</svg>
	} else if kind == "entra" {
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" class="h-4 w-4 shrink-0" aria-hidden="true">
			<path d="M12 3 3 20h18L12 3Z"/>
			<path d="M12 9 7.5 17h9L12 9Z"/>
		</svg>
	} else if kind == "google_workspace" {
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 shrink-0" aria-hidden="true">
			<path d="M21 12a9 9 0 1 1-3-6.7"/>
			<path d="M21 4v5h-5"/>
		</svg>
	} else if kind == "github" {
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4 shrink-0" aria-hidden="true">
			<path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.56 9.56 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.35 4.69-4.58 4.94.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/>
		</svg>
	} else if kind == "datadog" {
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 shrink-0" aria-hidden="true">
			<path d="M4 12c0 4 3 7 8 7s8-3 8-7-3-7-8-7-8 3-8 7Z"/>
			<circle cx="10" cy="12" r="1.25" fill="currentColor" stroke="none"/>
			<path d="M14 10.5v3"/>
		</svg>
	} else if kind == "aws_identity_center" {
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 shrink-0" aria-hidden="true">
			<path d="M4 8v8l8 4 8-4V8l-8-4-8 4Z"/>
			<path d="M4 8l8 4 8-4"/>
			<path d="M12 12v8"/>
		</svg>
	} else if kind == "vault" {
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 shrink-0" aria-hidden="true">
			<rect x="4" y="10" width="16" height="11" rx="2"/>
			<path d="M8 10V7a4 4 0 0 1 8 0v3"/>
			<circle cx="12" cy="15.5" r="1.25" fill="currentColor" stroke="none"/>
		</svg>
	} else {
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4 shrink-0" aria-hidden="true">
			<rect x="4" y="4" width="16" height="16" rx="3"/>
		</svg>
	}
}
