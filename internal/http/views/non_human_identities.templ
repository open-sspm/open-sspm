package views

import "github.com/open-sspm/open-sspm/internal/http/viewmodels"

templ NonHumanIdentitiesPage(data viewmodels.NonHumanIdentitiesViewData) {
	@Layout(data.Layout) {
		@NonHumanIdentitiesPageResults(data)
	}
}

templ NonHumanIdentitiesPageResults(data viewmodels.NonHumanIdentitiesViewData) {
	<div id="non-human-identities-results" class="space-y-6">
		@NonHumanIdentitiesPageFilters(data)
		@NonHumanIdentitiesInventoryResults(data)
	</div>
}

templ NonHumanIdentitiesInventorySwap(data viewmodels.NonHumanIdentitiesViewData) {
	@NonHumanIdentitiesInventoryResults(data)
}

templ NonHumanIdentitiesPageFilters(data viewmodels.NonHumanIdentitiesViewData) {
	<div id="non-human-identities-filters">
		@NonHumanIdentitiesFiltersForm(data)
	</div>
}

templ NonHumanIdentitiesFiltersForm(data viewmodels.NonHumanIdentitiesViewData) {
		<form
			method="get"
			action="/non-human-identities"
			data-enter-only-query="q"
			hx-get="/non-human-identities"
			hx-trigger="change delay:150ms from:[data-table-query-trigger], submit"
			hx-sync="this:replace"
			hx-target="#non-human-identities-inventory"
			hx-push-url="true"
				class="osspm-list-form"
			>
					<div class="osspm-list-toolbar">
						<div class="min-w-0 flex-1">
							@AskBar(NonHumanIdentitiesAskBar(data))
						</div>
					</div>
				<button class="sr-only" type="submit">Apply filters</button>
			</form>
}

templ NonHumanIdentitiesInventoryResults(data viewmodels.NonHumanIdentitiesViewData) {
	{{ cfg := NonHumanIdentitiesTableConfig(data) }}
	@TableResults(cfg) {
		@TableMobile() {
					for _, item := range data.Items {
						<a href={ templ.SafeURL("/non-human-identities/" + item.PrincipalRef) } class="osspm-identity-card">
							<div class="flex items-start justify-between gap-3">
								<div class="min-w-0">
										<div class="font-medium truncate" hx-disable>{ item.DisplayName }</div>
										if item.SecondaryName != "" {
											<div class="text-sm text-muted-foreground truncate" hx-disable>{ item.SecondaryName }</div>
										}
									<div class="mt-1 text-xs text-muted-foreground">
											{ HumanizeNonHumanPrincipalType(item.PrincipalType) }
											{ " · " }{ HumanizeConnectorKind(item.SourceKind) }
											if item.SourceName != "" {
												<span hx-disable>{ " · " }{ item.SourceName }</span>
											}
									</div>
								</div>
								<span class={ CredentialRiskBadgeClass(item.RiskLevel) }>{ HumanizeCredentialRisk(item.RiskLevel) }</span>
							</div>
							<dl class="mt-3 grid grid-cols-3 gap-x-3 gap-y-2 text-sm">
								<div>
									<dt class="osspm-stat-label">Owner</dt>
										<dd class="truncate">
											if item.AccountableOwner != "" {
												<span hx-disable>{ item.AccountableOwner }</span>
											} else {
											<span class="text-muted-foreground">—</span>
										}
									</dd>
								</div>
								<div>
									<dt class="osspm-stat-label">Links</dt>
									<dd class="tabular-nums">{ FormatInt64(item.LinkedAssetsCount) }{ " · " }{ FormatInt64(item.LinkedCredentialsCount) }</dd>
								</div>
								<div>
									<dt class="osspm-stat-label">Last seen</dt>
									<dd class="truncate">{ item.LastSeen.Label }</dd>
								</div>
							</dl>
						</a>
					}
		}

		@TableDesktop() {
			@ColumnsTable("") {
					<table class="table osspm-table-fixed osspm-table-compact osspm-table-list osspm-table-non-human-identities">
						@TableCaption(cfg.Caption)
						<colgroup>
							<col class="osspm-col-principal"/>
							<col class="osspm-col-owner"/>
							<col class="osspm-col-risk"/>
							<col class="osspm-col-activity"/>
							<col class="osspm-col-links"/>
						</colgroup>
						<thead>
							<tr>
								for _, column := range NonHumanIdentitiesColumns() {
									@TableColumnHeader(column, TableSortConfig{})
								}
							</tr>
						</thead>
						<tbody>
							for _, item := range data.Items {
								<tr data-row-href={ "/non-human-identities/" + item.PrincipalRef }>
									<td>
										<a class="osspm-identity-link" href={ templ.SafeURL("/non-human-identities/" + item.PrincipalRef) }>
												<span class="osspm-identity-name" hx-disable>{ item.DisplayName }</span>
											<span class="osspm-identity-meta">
												<span class="truncate">
														{ HumanizeNonHumanPrincipalType(item.PrincipalType) }
														{ " · " }{ HumanizeConnectorKind(item.SourceKind) }
														if item.SourceName != "" {
															<span hx-disable>{ " · " }{ item.SourceName }</span>
														}
												</span>
												if nonHumanShouldShowGovernance(item.GovernanceState) {
													<span class="osspm-identity-status">{ HumanizeAppAssetGovernanceState(item.GovernanceState) }</span>
												}
											</span>
										</a>
									</td>
									<td>
											if item.AccountableOwnerHref != "" {
												<a class="osspm-cell-primary no-underline hover:underline" href={ item.AccountableOwnerHref }><span hx-disable>{ item.AccountableOwner }</span></a>
											} else if item.AccountableOwner != "" {
												<span class="osspm-cell-primary font-normal" hx-disable>{ item.AccountableOwner }</span>
										} else {
											<span class="text-muted-foreground">—</span>
										}
										<span class="osspm-cell-secondary">{ HumanizeNonHumanOwnerPresence(item.OwnerPresence) }</span>
									</td>
									<td><span class={ CredentialRiskBadgeClass(item.RiskLevel) }>{ HumanizeCredentialRisk(item.RiskLevel) }</span></td>
									<td>
										if item.LastSeen.Label != "" {
											<span class="osspm-cell-primary">{ item.LastSeen.Label }</span>
										} else {
											<span class="text-muted-foreground">—</span>
										}
											if nonHumanShouldShowActivity(item.ActivityState, item.FreshnessState) {
												<span class="osspm-cell-secondary">
													{ HumanizeNonHumanActivityState(item.ActivityState) }
													if item.FreshnessState != "" && item.FreshnessState != "current" {
														{ " · " }{ HumanizeNonHumanFreshnessState(item.FreshnessState) }
													}
												</span>
											}
									</td>
									<td class="osspm-table-column-optional osspm-num">
										<span class="font-medium tabular-nums">{ FormatInt64(item.LinkedAssetsCount) }</span>
										<span class="osspm-cell-secondary">{ FormatInt64(item.LinkedCredentialsCount) }{ " creds" }</span>
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
			}
}
}
