package views

import "github.com/open-sspm/open-sspm/internal/http/viewmodels"

templ NonHumanAccessPage(data viewmodels.NonHumanAccessViewData) {
	@Layout(data.Layout) {
		@NonHumanAccessPageResults(data)
	}
}

templ NonHumanAccessPageResults(data viewmodels.NonHumanAccessViewData) {
	<div id="non-human-access-results" class="space-y-6">
		@NonHumanAccessPageFilters(data)
		@NonHumanAccessInventoryResults(data)
	</div>
}

templ NonHumanAccessInventorySwap(data viewmodels.NonHumanAccessViewData) {
	@NonHumanAccessPageFiltersOOB(data)
	@NonHumanAccessInventoryResults(data)
}

templ NonHumanAccessPageFilters(data viewmodels.NonHumanAccessViewData) {
	<div id="non-human-access-filters">
		@NonHumanAccessFiltersForm(data)
	</div>
}

templ NonHumanAccessPageFiltersOOB(data viewmodels.NonHumanAccessViewData) {
	<div id="non-human-access-filters" hx-swap-oob="outerHTML">
		@NonHumanAccessFiltersForm(data)
	</div>
}

templ NonHumanAccessFiltersForm(data viewmodels.NonHumanAccessViewData) {
		<form
			method="get"
			action="/non-human-access"
			data-enter-only-query="q"
			hx-get="/non-human-access"
			hx-trigger="change delay:150ms from:[data-table-query-trigger], submit"
			hx-target="#non-human-access-inventory"
			hx-swap="outerHTML"
			hx-push-url="true"
				class="osspm-list-form"
			>
					<div class="osspm-list-toolbar">
						<div class="min-w-0 flex-1">
							@TableQueryBar(NonHumanAccessTableQueryBar(data))
						</div>
						<div class="osspm-list-summary">
							if data.TotalCount > 0 {
								{ "Showing " }{ FormatInt(data.ShowingFrom) }{ "-" }{ FormatInt(data.ShowingTo) }{ " of " }{ FormatInt64(data.TotalCount) }
							} else {
								Showing 0
							}
						</div>
					</div>
				<button class="sr-only" type="submit">Apply filters</button>
			</form>
}

templ NonHumanAccessInventoryResults(data viewmodels.NonHumanAccessViewData) {
	<div id="non-human-access-inventory" class="space-y-6">
		@BusyInlineIndicator("Updating results...", false)
		<section class="space-y-3">
			if data.HasItems {
				<div class="space-y-3 lg:hidden">
					for _, item := range data.Items {
						<a href={ templ.SafeURL("/non-human-access/" + item.PrincipalRef) } class="osspm-identity-card">
							<div class="flex items-start justify-between gap-3">
								<div class="min-w-0">
									<div class="font-medium truncate">{ item.DisplayName }</div>
									if item.SecondaryName != "" {
										<div class="text-sm text-muted-foreground truncate">{ item.SecondaryName }</div>
									}
									<div class="mt-1 text-xs text-muted-foreground">
										{ HumanizeNonHumanPrincipalType(item.PrincipalType) }
										{ " · " }{ HumanizeConnectorKind(item.SourceKind) }
										if item.SourceName != "" {
											{ " · " }{ item.SourceName }
										}
									</div>
								</div>
								<span class={ CredentialRiskBadgeClass(item.RiskLevel) }>{ HumanizeCredentialRisk(item.RiskLevel) }</span>
							</div>
							<dl class="mt-3 grid grid-cols-3 gap-x-3 gap-y-2 text-sm">
								<div>
									<dt class="osspm-stat-label">Owner</dt>
									<dd class="truncate">
										if item.AccountableOwner != "" {
											{ item.AccountableOwner }
										} else {
											<span class="text-muted-foreground">—</span>
										}
									</dd>
								</div>
								<div>
									<dt class="osspm-stat-label">Links</dt>
									<dd class="tabular-nums">{ FormatInt64(item.LinkedAssetsCount) }{ " · " }{ FormatInt64(item.LinkedCredentialsCount) }</dd>
								</div>
								<div>
									<dt class="osspm-stat-label">Last seen</dt>
									<dd class="truncate">{ item.LastSeen.Label }</dd>
								</div>
							</dl>
						</a>
					}
				</div>

				@ColumnsTable("hidden lg:block") {
					<table class="table osspm-table-fixed osspm-table-compact osspm-table-list osspm-table-non-human-access">
						<caption class="sr-only">Non-human principals with ownership, credential risk, and activity.</caption>
						<colgroup>
							<col class="osspm-col-principal"/>
							<col class="osspm-col-owner"/>
							<col class="osspm-col-risk"/>
							<col class="osspm-col-activity"/>
							<col class="osspm-col-links"/>
						</colgroup>
						<thead>
							<tr>
								<th>Principal</th>
								<th>Owner</th>
								<th>Risk</th>
								<th>Activity</th>
								<th class="osspm-num">Links</th>
							</tr>
						</thead>
						<tbody>
							for _, item := range data.Items {
								<tr data-row-href={ "/non-human-access/" + item.PrincipalRef }>
									<td>
										<a class="osspm-identity-link" href={ templ.SafeURL("/non-human-access/" + item.PrincipalRef) }>
											<span class="osspm-identity-name">{ item.DisplayName }</span>
											<span class="osspm-identity-meta">
												<span class="truncate">
													{ HumanizeNonHumanPrincipalType(item.PrincipalType) }
													{ " · " }{ HumanizeConnectorKind(item.SourceKind) }
													if item.SourceName != "" {
														{ " · " }{ item.SourceName }
													}
												</span>
												if nonHumanShouldShowGovernance(item.GovernanceState) {
													<span class="osspm-identity-status">{ HumanizeAppAssetGovernanceState(item.GovernanceState) }</span>
												}
											</span>
										</a>
									</td>
									<td>
										if item.AccountableOwnerHref != "" {
											<a class="osspm-cell-primary no-underline hover:underline" href={ item.AccountableOwnerHref }>{ item.AccountableOwner }</a>
										} else if item.AccountableOwner != "" {
											<span class="osspm-cell-primary font-normal">{ item.AccountableOwner }</span>
										} else {
											<span class="text-muted-foreground">—</span>
										}
										<span class="osspm-cell-secondary">{ HumanizeNonHumanOwnerPresence(item.OwnerPresence) }</span>
									</td>
									<td><span class={ CredentialRiskBadgeClass(item.RiskLevel) }>{ HumanizeCredentialRisk(item.RiskLevel) }</span></td>
									<td>
										if item.LastSeen.Label != "" {
											<span class="osspm-cell-primary">{ item.LastSeen.Label }</span>
										} else {
											<span class="text-muted-foreground">—</span>
										}
										if nonHumanShouldShowActivity(item.ActivityState, item.FreshnessState) {
											<span class="osspm-cell-secondary">
												{ HumanizeNonHumanActivityState(item.ActivityState) }
												if item.FreshnessState != "" && item.FreshnessState != "fresh" {
													{ " · " }{ HumanizeNonHumanFreshnessState(item.FreshnessState) }
												}
											</span>
										}
									</td>
									<td class="osspm-num">
										<span class="font-medium tabular-nums">{ FormatInt64(item.LinkedAssetsCount) }</span>
										<span class="osspm-cell-secondary">{ FormatInt64(item.LinkedCredentialsCount) }{ " creds" }</span>
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
			} else {
				@EmptyState("No non-human principals", data.EmptyStateMsg)
			}
		</section>

			if data.TotalPages > 1 {
					<div class="osspm-list-pagination-split">
					<p class="text-sm text-muted-foreground">Page { FormatInt(data.Page) }{ " of " }{ FormatInt(data.TotalPages) }</p>
					<div class="flex items-center gap-2">
						if data.Page > 1 {
							<a class="btn-sm-outline" href={ data.Query.WithPage(data.Page-1).Href() } hx-get={ data.Query.WithPage(data.Page-1).Href() } hx-target="#non-human-access-inventory" hx-swap="outerHTML" hx-push-url="true">Previous</a>
						} else {
							<span class="btn-sm-outline opacity-50" aria-disabled="true">Previous</span>
						}
						if data.Page < data.TotalPages {
							<a class="btn-sm-outline" href={ data.Query.WithPage(data.Page+1).Href() } hx-get={ data.Query.WithPage(data.Page+1).Href() } hx-target="#non-human-access-inventory" hx-swap="outerHTML" hx-push-url="true">Next</a>
						} else {
							<span class="btn-sm-outline opacity-50" aria-disabled="true">Next</span>
						}
					</div>
			</div>
		}
	</div>
}
