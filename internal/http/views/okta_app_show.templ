package views

import "github.com/open-sspm/open-sspm/internal/http/viewmodels"

templ OktaAppShowPage(data viewmodels.OktaAppShowViewData) {
	@Layout(data.Layout) {
		@PageHeader("")

		<section class="mb-8">
			<div class="max-w-4xl">
				<div class="flex min-w-0 items-start gap-4">
					@ProductIcon(data.App.Label, data.App.Name, "", "size-12")
					<div class="min-w-0 space-y-2">
						<div class="flex flex-wrap items-center gap-x-3 gap-y-1">
							<h1 class="text-2xl font-semibold tracking-tight break-words">{ data.App.Label }</h1>
							<span class="inline-flex items-center gap-1.5 text-sm">
								<span class={ "inline-block h-2 w-2 shrink-0 rounded-full", AppStatusDotClass(data.App.Status) }></span>
								<span class={ StatusTextClass(data.App.Status) }>{ HumanizeStatus(data.App.Status) }</span>
							</span>
						</div>
						@OktaAppMetaLine(data.App)
					</div>
				</div>
			</div>
		</section>

		<section class="space-y-3">
			<form method="get" class="osspm-list-form-tight">
				<div class="osspm-list-toolbar">
					<div class="min-w-0">
						<div class="text-sm font-medium">
							{ FormatInt64(data.TotalCount) } { Pluralize(data.TotalCount, "account", "accounts") }
						</div>
						@OktaAppAssignmentSummaryLine(data.Summary)
					</div>
					<div class="min-w-0 flex-1 sm:max-w-sm">
						@AskBar(StateAskBar(data.Query, "Search name, email, or Okta ID", ""))
					</div>
				</div>
				<button class="sr-only" type="submit">Apply filters</button>
			</form>

			if data.HasAccounts {
				<!-- Mobile list -->
				<ul class="divide-y divide-border lg:hidden">
					for _, account := range data.Accounts {
						<li class="py-3">
							<div class="flex items-start justify-between gap-3">
								<div class="min-w-0 space-y-0.5">
										<a class="btn-sm-link px-0 font-medium" href={ account.AccountHref }><span hx-disable>{ account.AccountDisplayName }</span></a>
										if account.AccountEmail != "" {
											<div class="text-sm text-muted-foreground break-all" hx-disable>{ account.AccountEmail }</div>
										} else if account.OktaAccountExternalID != "" {
											<div class="text-sm text-muted-foreground break-all" hx-disable>{ account.OktaAccountExternalID }</div>
										}
								</div>
								<span class={ StatusBadgeClass(account.OktaAccountStatus) }>{ account.OktaAccountStatus }</span>
							</div>
								if !data.Summary.UniformAssignedVia || len(account.Groups) > 0 || len(account.Attributes) > 0 {
								<div class="mt-2 space-y-1.5 text-sm">
									if !data.Summary.UniformAssignedVia {
										<div class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1">
											<span class="text-muted-foreground">Assigned via</span>
											<span class="text-foreground">{ account.AssignedVia }</span>
										</div>
									}
									if len(account.Groups) > 0 {
										<div class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1">
											<span class="text-muted-foreground">Groups</span>
											<div class="space-y-0.5 text-foreground">
												for _, group := range account.Groups {
													<div class="break-words">{ group }</div>
												}
											</div>
										</div>
									}
										if len(account.Attributes) > 0 {
											<div class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1">
												<span class="text-muted-foreground">Attributes</span>
												<div class="space-y-0.5 text-foreground">
													for _, attr := range account.Attributes {
														<div class="break-words">{ attr.Text }</div>
													}
												</div>
											</div>
									}
								</div>
							}
						</li>
					}
				</ul>

				<!-- Desktop table -->
				<div class="hidden lg:block">
					{{ showGroups := data.Summary.AnyGroups || !data.Summary.SinglePage }}
						{{ showAttributes := data.Summary.AnyAttributes || !data.Summary.SinglePage }}
					@ColumnsTable("") {
						<table class="table osspm-table-fixed osspm-table-compact osspm-table-list">
							<caption class="sr-only">Okta accounts assigned to this app.</caption>
							<thead>
								<tr>
									<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Account</th>
									<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Status</th>
									if !data.Summary.UniformAssignedVia {
										<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Assigned via</th>
									}
									if showGroups {
										<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Group(s)</th>
									}
										if showAttributes {
											<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Attributes</th>
										}
								</tr>
							</thead>
							<tbody>
								for _, account := range data.Accounts {
									<tr>
										<td>
												<a class="btn-sm-link px-0 font-medium" href={ account.AccountHref }><span hx-disable>{ account.AccountDisplayName }</span></a>
												if account.AccountEmail != "" {
													<div class="text-xs text-muted-foreground break-all" hx-disable>{ account.AccountEmail }</div>
												} else if account.OktaAccountExternalID != "" {
													<div class="text-xs text-muted-foreground break-all" hx-disable>{ account.OktaAccountExternalID }</div>
												}
										</td>
										<td><span class={ StatusBadgeClass(account.OktaAccountStatus) }>{ account.OktaAccountStatus }</span></td>
										if !data.Summary.UniformAssignedVia {
											<td class="text-sm text-muted-foreground">{ account.AssignedVia }</td>
										}
										if showGroups {
											<td>
												if len(account.Groups) > 0 {
													<div class="space-y-1 text-sm text-foreground">
														for _, group := range account.Groups {
															<div class="break-words">{ group }</div>
														}
													</div>
												}
											</td>
										}
										if showAttributes {
											<td>
												if len(account.Attributes) > 0 {
													<div class="space-y-1 text-sm text-foreground">
														for _, attr := range account.Attributes {
															<div class="break-words">{ attr.Text }</div>
														}
													</div>
												}
											</td>
										}
									</tr>
								}
							</tbody>
						</table>
					}
				</div>
			} else {
				@EmptyState("No assigned accounts found", data.EmptyStateMsg)
			}

			if data.TotalPages > 1 {
				<div class="osspm-list-pagination">
					<div class="text-sm text-muted-foreground">
						{ "Showing " }{ FormatInt(data.ShowingFrom) }{ "–" }{ FormatInt(data.ShowingTo) }{ " of " }{ FormatInt64(data.TotalCount) }
					</div>
					<div class="button-group ml-auto">
						if data.Page > 1 {
							<a class="btn-sm-outline" href={ data.Query.WithPage(data.Page-1).Href() }>Previous</a>
						} else {
							<span class="btn-sm-outline opacity-50" aria-disabled="true">Previous</span>
						}
						if data.Page < data.TotalPages {
							<a class="btn-sm-outline" href={ data.Query.WithPage(data.Page+1).Href() }>Next</a>
						} else {
							<span class="btn-sm-outline opacity-50" aria-disabled="true">Next</span>
						}
					</div>
				</div>
			}
		</section>
	}
}

templ OktaAppMetaLine(app viewmodels.OktaAppSummaryView) {
	{{ parts := OktaAppMetaParts(app) }}
	if len(parts) > 0 {
		<p class="mt-1 text-sm text-muted-foreground">
			for i, part := range parts {
				if i > 0 {
					<span class="mx-2 text-muted-foreground/50">·</span>
				}
				if part.Mono {
					<span class="font-mono">{ part.Text }</span>
				} else {
					<span>{ part.Text }</span>
				}
			}
		</p>
	}
}

templ OktaAppAssignmentSummaryLine(summary viewmodels.OktaAppAssignmentSummary) {
	{{ parts := OktaAppSummaryParts(summary) }}
	if len(parts) > 0 {
		<p class="mt-0.5 text-sm text-muted-foreground">
			for i, part := range parts {
				if i > 0 {
					<span class="mx-1.5 text-muted-foreground/50">·</span>
				}
				<span>{ part }</span>
			}
		</p>
	}
}
