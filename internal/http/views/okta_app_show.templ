package views

import "github.com/open-sspm/open-sspm/internal/http/viewmodels"

templ OktaAppShowPage(data viewmodels.OktaAppShowViewData) {
	@Layout(data.Layout) {
		@PageHeader("")

		<section class="mb-6 border-b border-border pb-5">
			<div class="max-w-4xl space-y-3">
				<div class="space-y-1.5">
					<h1 class="text-2xl font-semibold tracking-tight break-words">{ data.App.Label }</h1>
					if data.App.Name != "" {
						<p class="text-sm text-muted-foreground break-all">{ data.App.Name }</p>
					}
				</div>
				<div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
					<span class="flex items-center gap-1.5">
						<span class={ "inline-block h-2 w-2 shrink-0 rounded-full", AppStatusDotClass(data.App.Status) }></span>
						<span>{ data.App.Status }</span>
					</span>
					if data.App.SignOnMode != "" {
						<span class="text-muted-foreground">{ data.App.SignOnMode }</span>
					}
					<span class="badge-outline text-xs">{ "Okta ID " }{ data.App.ExternalID }</span>
				</div>
			</div>
		</section>

		<section class="space-y-3">
			<form method="get" class="osspm-list-form-tight">
					<div class="osspm-list-toolbar">
						<div class="flex items-baseline gap-2">
							<h2 class="text-base font-semibold">Assigned accounts</h2>
							<span class="text-sm text-muted-foreground">({ FormatInt64(data.TotalCount) })</span>
						</div>
						<div class="min-w-0 flex-1 sm:max-w-xl">
							@TableQueryBar(ActiveInactiveStateTableQueryBar(data.Query, "Search name, email, or Okta ID"))
						</div>
					</div>
				<button class="sr-only" type="submit">Apply filters</button>
			</form>

			if data.HasAccounts {
				<!-- Mobile card view -->
				<div class="divide-y divide-border lg:hidden">
					for _, account := range data.Accounts {
						<article class="py-4">
							<div class="flex items-start justify-between gap-3">
								<div class="min-w-0 space-y-0.5">
									<a class="btn-sm-link px-0 font-medium" href={ account.AccountHref }>{ account.AccountDisplayName }</a>
									if account.AccountEmail != "" {
										<div class="text-sm text-muted-foreground break-all">{ account.AccountEmail }</div>
									} else if account.OktaAccountExternalID != "" {
										<div class="text-sm text-muted-foreground break-all">{ account.OktaAccountExternalID }</div>
									}
								</div>
								<span class={ StatusBadgeClass(account.OktaAccountStatus) }>{ account.OktaAccountStatus }</span>
							</div>
							<div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
								<div class="flex items-baseline gap-1.5">
									<span class="text-muted-foreground">Via</span>
									<span class="badge-outline">{ account.AssignedVia }</span>
								</div>
								if len(account.Groups) > 0 {
									<div class="flex items-baseline gap-1.5">
										<span class="text-muted-foreground">Groups</span>
										<div class="flex flex-wrap gap-1">
											for _, group := range account.Groups {
												<span class="badge-outline">{ group }</span>
											}
										</div>
									</div>
								}
								if len(account.Permissions) > 0 {
									<div class="flex items-baseline gap-1.5">
										<span class="text-muted-foreground">Attrs</span>
										<div class="flex flex-wrap gap-1">
											for _, p := range account.Permissions {
												<span class="badge-outline">{ p.Text }</span>
											}
										</div>
									</div>
								}
							</div>
						</article>
					}
				</div>

				<!-- Desktop table -->
				<div class="hidden lg:block">
					@ColumnsTable("") {
						<table class="table osspm-table-fixed osspm-table-compact osspm-table-list">
							<caption class="sr-only">Okta accounts assigned to this app, including assignment source, groups, and permission attributes.</caption>
							<thead>
								<tr>
									<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Account</th>
									<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Status</th>
									<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Assigned via</th>
									<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Group(s)</th>
									<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Attributes</th>
								</tr>
							</thead>
							<tbody>
								for _, account := range data.Accounts {
									<tr class="align-top">
										<td>
											<a class="btn-sm-link px-0 font-medium" href={ account.AccountHref }>{ account.AccountDisplayName }</a>
											if account.AccountEmail != "" {
												<div class="text-xs text-muted-foreground break-all">{ account.AccountEmail }</div>
											} else if account.OktaAccountExternalID != "" {
												<div class="text-xs text-muted-foreground break-all">{ account.OktaAccountExternalID }</div>
											}
										</td>
										<td><span class={ StatusBadgeClass(account.OktaAccountStatus) }>{ account.OktaAccountStatus }</span></td>
										<td><span class="badge-outline">{ account.AssignedVia }</span></td>
										<td>
											if len(account.Groups) > 0 {
												<div class="flex flex-wrap gap-2">
													for _, group := range account.Groups {
														<span class="badge-outline">{ group }</span>
													}
												</div>
											} else {
												<span class="text-muted-foreground">&mdash;</span>
											}
										</td>
										<td>
											if len(account.Permissions) > 0 {
												<div class="flex flex-wrap gap-2">
													for _, p := range account.Permissions {
														<span class="badge-outline">{ p.Text }</span>
													}
												</div>
											} else {
												<span class="text-muted-foreground">&mdash;</span>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					}
				</div>
			} else {
				@EmptyState("No assigned accounts found", data.EmptyStateMsg)
			}

			if data.TotalPages > 1 {
				<div class="osspm-list-pagination">
					<div class="text-sm text-muted-foreground">
						{ "Showing " }{ FormatInt(data.ShowingFrom) }{ "–" }{ FormatInt(data.ShowingTo) }{ " of " }{ FormatInt64(data.TotalCount) }
					</div>
					<div class="button-group ml-auto">
						if data.Page > 1 {
							<a class="btn-sm-outline" href={ data.Query.WithPage(data.Page-1).Href() }>Previous</a>
						} else {
							<span class="btn-sm-outline opacity-50" aria-disabled="true">Previous</span>
						}
						if data.Page < data.TotalPages {
							<a class="btn-sm-outline" href={ data.Query.WithPage(data.Page+1).Href() }>Next</a>
						} else {
							<span class="btn-sm-outline opacity-50" aria-disabled="true">Next</span>
						}
					</div>
				</div>
			}
		</section>
	}
}
