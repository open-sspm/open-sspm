package views

// AskBar is the shared chip-in-input filter bar used by every list page.
// Active chips render server-side from the page's query state; the JS layer
// hydrates from the chip DOM attributes and the config JSON so the bar stays
// driven by canonical URL params even when JS is slow to boot. The children
// slot is rendered as the right-hand action group (sort, save view, etc.).
templ AskBar(cfg AskBarConfig) {
	<div class="osspm-askbar-container" data-osspm-askbar data-osspm-askbar-config={ AskBarConfigJSON(cfg) }>
		<div class="osspm-askbar-row">
			<label class="osspm-askbar" data-osspm-askbar-bar>
				<span class="sr-only">{ AskBarAriaLabel(cfg) }</span>
				<span class="osspm-askbar-leading" aria-hidden="true">
					@IconSearch("h-4 w-4")
				</span>
				<span class="osspm-askbar-chips" data-osspm-askbar-chips>
					for _, chip := range cfg.Chips {
						@askBarChip(chip)
					}
				</span>
				<input
					type="text"
					class="osspm-askbar-input"
					data-osspm-askbar-input
					autocomplete="off"
					spellcheck="false"
					placeholder={ AskBarPlaceholder(cfg) }
				/>
				<button type="button" class="osspm-askbar-filter-add" data-osspm-askbar-add-filter aria-label="Add filter">
					@IconPlus("h-3.5 w-3.5")
					<span>Filter</span>
				</button>
			</label>
			if cfg.HasRightActions {
				<div class="osspm-askbar-actions">
					{ children... }
				</div>
			}
		</div>
		<div class="osspm-askbar-suggest" data-osspm-askbar-suggest hidden></div>
		<div class="hidden" aria-hidden="true" data-osspm-askbar-bank data-table-query-trigger>
			for _, h := range AskBarHiddenInputs(cfg) {
				<input type="hidden" name={ h.Name } value={ h.Value }/>
			}
		</div>
	</div>
}

templ askBarChip(chip AskBarChip) {
	<span
		class={ AskBarChipClass(chip.Tone) }
		data-osspm-askbar-chip
		data-chip-field={ chip.Field }
		data-chip-value={ chip.Value }
		data-chip-label={ chip.Label }
		data-chip-tone={ chip.Tone }
		tabindex="-1"
		role="group"
		aria-label={ "Filter " + chip.Label }
	>
		if chip.KeyLabel != "" {
			<span class="osspm-askbar-chip-key">{ chip.KeyLabel }</span>
			<span class="osspm-askbar-chip-sep">:</span>
		}
		<span class="osspm-askbar-chip-label">{ chip.Label }</span>
		<button
			type="button"
			class="osspm-askbar-chip-remove"
			data-osspm-askbar-chip-remove
			aria-label={ "Remove " + chip.Label }
		>&times;</button>
	</span>
}

// AskBarGrammarHints renders a code-token Try row beneath the bar. Each hint is
// a monospace pill showing the literal grammar token (e.g. `expires:<30d`) so
// the user learns the syntax by seeing it. Clicking a hint applies the same
// canonical querystate as the matching saved query.
templ AskBarGrammarHints(cfg AskBarConfig) {
	if len(cfg.GrammarHints) > 0 {
		<div class="osspm-askbar-hints" aria-label="Try suggestions">
			<span class="osspm-askbar-hints-label">Try</span>
			for _, hint := range cfg.GrammarHints {
				@askBarGrammarHint(hint, cfg.HxTarget)
			}
		</div>
	}
}

templ askBarGrammarHint(hint AskBarGrammarHint, hxTarget string) {
	<a
		href={ templ.SafeURL(hint.Href) }
		hx-get={ hint.Href }
		hx-target={ hxTarget }
		hx-swap="outerHTML show:top"
		hx-push-url="true"
		class="osspm-askbar-hint"
		aria-current={ AriaCurrentBool(hint.Active) }
	>{ hint.Token }</a>
}

// AskBarSavedQueries renders the prototype-style saved-query pill row beneath
// the bar. Each pill is a plain anchor that navigates to a canonical querystate
// URL so back/forward, no-JS, and htmx all work.
templ AskBarSavedQueries(cfg AskBarConfig) {
	if len(cfg.SavedQueries) > 0 {
		<nav class="osspm-saved-queries" aria-label="Saved queries">
			<span class="osspm-saved-queries-label">Try:</span>
			for _, pill := range cfg.SavedQueries {
				@askBarSavedQueryPill(pill, cfg.HxTarget)
			}
		</nav>
	}
}

templ askBarSavedQueryPill(pill AskBarSavedQuery, hxTarget string) {
	<a
		href={ templ.SafeURL(pill.Href) }
		hx-get={ pill.Href }
		hx-target={ hxTarget }
		hx-swap="outerHTML show:top"
		hx-push-url="true"
		class="osspm-saved-queries-pill"
		aria-current={ AriaCurrentBool(pill.Active) }
	>{ pill.Label }</a>
}
