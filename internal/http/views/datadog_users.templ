package views

import "github.com/open-sspm/open-sspm/internal/http/viewmodels"

templ DatadogUserMobileRow(user viewmodels.DatadogUserListItem) {
	<article class="rounded-lg border border-border/70 bg-card p-4">
		<div class="flex items-start justify-between gap-3">
			<div class="min-w-0">
				<div class="font-medium break-all">{ user.UserName }</div>
				if user.RolesDisplay != "" {
					<div class="mt-1 text-sm text-muted-foreground">{ user.RolesDisplay }</div>
				}
			</div>
			if user.Status != "" {
				<span class={ StatusBadgeClass(user.Status) }>{ user.Status }</span>
			} else {
				<span class="text-sm text-muted-foreground">—</span>
			}
		</div>
	</article>
}

templ DatadogUsersPage(data viewmodels.DatadogUsersViewData) {
	@Layout(data.Layout) {
		@PageHeader("") {
			if data.Layout.DatadogConfigured && data.Layout.DatadogEnabled {
				<a class="btn-sm-outline" href={ "/accounts/unlinked/datadog/" + data.Layout.DatadogSite }>Unlinked</a>
			} else {
				<a class="btn-sm-outline" href="/settings/connectors?open=datadog">Configure</a>
			}
		}

		if !data.Layout.DatadogConfigured || !data.Layout.DatadogEnabled {
			@Alert("Datadog sync disabled", true) {
				<p>
					{ data.EmptyStateMsg } <a class="btn-sm-link px-1" href={ data.EmptyStateHref }>Configure Datadog</a>.
				</p>
			}
		}

		@DatadogUsersPageResults(data)
	}
}

templ DatadogUsersPageResults(data viewmodels.DatadogUsersViewData) {
	<div id="datadog-users-results" class="space-y-5">
		@BusyInlineIndicator("Updating results...", false)
		<form
			method="get"
			action="/accounts/datadog"
			data-enter-only-query="q"
			hx-get="/accounts/datadog"
			hx-trigger="change delay:150ms from:[data-table-query-trigger], submit"
			hx-target="#datadog-users-results"
			hx-swap="outerHTML"
			hx-push-url="true"
			class="osspm-list-form"
		>
			<div class="osspm-list-toolbar">
				<div class="min-w-0 flex-1">
					@AskBar(StateAskBar(data.Query, "Search name or email", "#datadog-users-results"))
				</div>
			</div>
			<button class="sr-only" type="submit">Apply filters</button>
		</form>

		<section class="space-y-3">
			@ListSectionHeader("Datadog users", "Datadog users and their role assignments.")
			if data.HasUsers {
				<div class="space-y-3 lg:hidden">
					for _, u := range data.Users {
						@DatadogUserMobileRow(u)
					}
				</div>
			} else {
				<div class="lg:hidden">
					@EmptyState("No users found", data.EmptyStateMsg)
				</div>
			}
			@ColumnsTable("hidden lg:block") {
				<table class="table osspm-table-fixed osspm-table-compact osspm-table-list">
					<caption class="sr-only">Datadog users with status and assigned role summaries.</caption>
					<thead>
						<tr>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">User Name</th>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Status</th>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Roles</th>
						</tr>
					</thead>
					<tbody>
						if data.HasUsers {
							for _, u := range data.Users {
								<tr>
									<td class="font-medium">{ u.UserName }</td>
									<td>
										if u.Status != "" {
											<span class={ StatusBadgeClass(u.Status) }>{ u.Status }</span>
										} else {
											<span class="text-muted-foreground">-</span>
										}
									</td>
									<td>
										if u.RolesDisplay != "" {
											{ u.RolesDisplay }
										} else {
											<span class="text-muted-foreground">-</span>
										}
									</td>
								</tr>
							}
						} else {
							<tr>
								<td colspan="3">
									@EmptyState("No users found", data.EmptyStateMsg)
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
			if data.TotalPages > 1 {
				@ListPagination("datadog-users-results", data.Page, data.TotalPages, BasicListPageHref(data.Query))
			}
		</section>
	</div>
}
