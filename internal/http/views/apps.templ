package views

import "github.com/open-sspm/open-sspm/internal/http/viewmodels"
import "strconv"

templ AppsPage(data viewmodels.AppsViewData) {
	@Layout(data.Layout) {
		<div class="space-y-1">
			<h1 class="text-2xl font-semibold tracking-tight">Assigned apps</h1>
			<p class="text-sm text-muted-foreground">Apps discovered from Okta assignments.</p>
		</div>
		@AppsPageResults(data)
	}
}

templ AppsPageResults(data viewmodels.AppsViewData) {
	<div id="apps-results" class="space-y-5">
		@BusyInlineIndicator("Updating results...", false)
		<form
			method="get"
			action="/assigned-apps"
			data-enter-only-query="q"
			hx-get="/assigned-apps"
			hx-trigger="change delay:150ms from:[data-table-query-trigger], submit"
			hx-target="#apps-results"
			hx-swap="outerHTML"
			hx-push-url="true"
			class="osspm-list-form"
		>
			<div class="osspm-list-toolbar">
				<div class="min-w-0 flex-1">
					@TableQueryBar(AppsTableQueryBar(data))
				</div>
				<p class="osspm-list-summary">
					if data.TotalCount > 0 {
						<span class="font-medium text-foreground">{ FormatInt64(data.TotalCount) }</span>
						if data.Query.HasFilters() {
							{ " results" }
						} else {
							{ " apps" }
						}
					} else {
						0 results
					}
				</p>
			</div>
			<button class="sr-only" type="submit">Apply filters</button>
		</form>

		if data.HasApps {
			<!-- Mobile list -->
			<div class="divide-y divide-border/60 lg:hidden">
				for i, app := range data.Apps {
					@AppRowMobile(app, data.Layout.IsAdmin, data.Layout.CSRFToken, i)
				}
			</div>
			<!-- Desktop table -->
			<div class="hidden lg:block">
				<div class="overflow-x-auto">
					<table class="table osspm-table-fixed osspm-table-compact osspm-table-list">
						<caption class="sr-only">Assigned apps with status, sign-on mode, and integration state.</caption>
						<thead>
							<tr>
								<th class="pr-3 text-left text-xs font-medium tracking-wide text-muted-foreground">App</th>
								if appsHasStatusVariance(data.Apps) {
									<th class="w-28 px-3 text-left text-xs font-medium tracking-wide text-muted-foreground">Status</th>
								}
								<th class="w-40 px-3 text-left text-xs font-medium tracking-wide text-muted-foreground">Sign-on</th>
								if appsHasAnyIntegration(data.Apps) {
									<th class="w-32 px-3 text-left text-xs font-medium tracking-wide text-muted-foreground">Integration</th>
								}
								<th class="w-10 pl-3 text-right" aria-hidden="true"></th>
							</tr>
						</thead>
						<tbody>
							for i, app := range data.Apps {
								@AppRowDesktop(app, data.Layout.IsAdmin, data.Layout.CSRFToken, i, appsHasStatusVariance(data.Apps), appsHasAnyIntegration(data.Apps))
							}
						</tbody>
					</table>
				</div>
			</div>
		} else {
			@EmptyState("No apps found", data.EmptyStateMsg)
		}

		if data.TotalPages > 1 {
			<div class="osspm-list-pagination-split">
				<p class="text-sm tabular-nums text-muted-foreground">
					{ FormatInt(data.ShowingFrom) }–{ FormatInt(data.ShowingTo) }{ " of " }{ FormatInt64(data.TotalCount) }
				</p>
				<div class="button-group">
					if data.Page > 1 {
						<a class="btn-sm-outline" href={ data.Query.WithPage(data.Page-1).Href() } hx-get={ data.Query.WithPage(data.Page-1).Href() } hx-target="#apps-results" hx-swap="outerHTML" hx-push-url="true">Previous</a>
					} else {
						<span class="btn-sm-outline opacity-40" aria-disabled="true">Previous</span>
					}
					if data.Page < data.TotalPages {
						<a class="btn-sm-outline" href={ data.Query.WithPage(data.Page+1).Href() } hx-get={ data.Query.WithPage(data.Page+1).Href() } hx-target="#apps-results" hx-swap="outerHTML" hx-push-url="true">Next</a>
					} else {
						<span class="btn-sm-outline opacity-40" aria-disabled="true">Next</span>
					}
				</div>
			</div>
		}
	</div>
}

templ AppRowDesktop(app viewmodels.AppListItem, isAdmin bool, csrfToken string, index int, showStatus, showIntegration bool) {
	<tr
		class="app-row group cursor-pointer"
		style={ "animation-delay:" + strconv.Itoa(index*25) + "ms" }
		data-row-href={ AppDetailURL(app.IntegratedHref, app.ExternalID) }
	>
		<!-- App -->
		<td class="py-3 pr-3">
			<a href={ AppDetailURL(app.IntegratedHref, app.ExternalID) } class="flex min-w-0 items-center gap-3 no-underline">
				@ProductIcon(app.Label, app.Name, "", "size-8")
				<span class="min-w-0 flex-1">
					<span class="osspm-truncate font-medium text-foreground">{ app.Label }</span>
					if app.Name != "" {
						<span class="osspm-truncate text-xs text-muted-foreground/70">{ app.Name }</span>
					}
				</span>
			</a>
		</td>
		if showStatus {
			<!-- Status -->
			<td class="py-3 px-3">
				<span class="inline-flex items-center gap-1.5 text-xs text-muted-foreground">
					<span class={ "h-1.5 w-1.5 rounded-full", AppStatusDotClass(app.Status) }></span>
					<span class={ StatusTextClass(app.Status) }>{ fallbackHumanized(app.Status) }</span>
				</span>
			</td>
		}
		<!-- Sign-on -->
		<td class="py-3 px-3 text-sm text-muted-foreground">
			{ HumanizeSignOnMode(app.SignOnMode) }
		</td>
		if showIntegration {
			<!-- Integration -->
			<td class="py-3 px-3">
				if app.IntegratedHref != "" {
					<span class="inline-flex items-center gap-1.5 text-xs text-emerald-700 dark:text-emerald-400">
						@IconCheck("h-3.5 w-3.5")
						Connected
					</span>
				} else if isAdmin && app.SuggestedKind != "" {
					<form method="post" action="/assigned-apps/map" class="inline-flex">
						@CSRFInput(csrfToken)
						<input type="hidden" name="integration_kind" value={ app.SuggestedKind }/>
						<input type="hidden" name="okta_app_external_id" value={ app.ExternalID }/>
						<button class="btn-sm-ghost h-7 px-2 text-xs opacity-0 transition-opacity group-hover:opacity-100" type="submit">
							{ SuggestedIntegrationActionLabel(app.SuggestedKind) }
						</button>
					</form>
				} else {
					<span class="text-xs text-muted-foreground/40">—</span>
				}
			</td>
		}
		<!-- Chevron -->
		<td class="py-3 pl-3 text-right align-middle">
			@IconChevronRight("inline-block h-3.5 w-3.5 text-muted-foreground/30 transition-colors group-hover:text-muted-foreground")
		</td>
	</tr>
}

templ AppRowMobile(app viewmodels.AppListItem, isAdmin bool, csrfToken string, index int) {
	<a
		href={ AppDetailURL(app.IntegratedHref, app.ExternalID) }
		class="app-row flex items-center gap-3 py-3.5 no-underline transition-colors hover:bg-muted/30"
		style={ "animation-delay:" + strconv.Itoa(index*25) + "ms" }
	>
		@ProductIcon(app.Label, app.Name, "", "size-8")
		<span class="min-w-0 flex-1">
			<span class="flex items-center gap-2">
				<span class="truncate text-sm font-medium text-foreground">{ app.Label }</span>
				<span class={ "ml-auto inline-flex shrink-0 items-center gap-1 text-xs", StatusTextClass(app.Status) }>
					<span class={ "h-1.5 w-1.5 rounded-full", AppStatusDotClass(app.Status) }></span>
					{ fallbackHumanized(app.Status) }
				</span>
			</span>
			<span class="flex items-center gap-2 text-xs text-muted-foreground">
				<span>{ HumanizeSignOnMode(app.SignOnMode) }</span>
				if app.IntegratedHref != "" {
					<span class="text-border/60" aria-hidden="true">·</span>
					<span class="text-emerald-700 dark:text-emerald-400">Connected</span>
				}
			</span>
		</span>
		@IconChevronRight("h-4 w-4 shrink-0 text-muted-foreground/30")
	</a>
}
