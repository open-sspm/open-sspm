package views

import "github.com/open-sspm/open-sspm/internal/http/viewmodels"

templ AppsPage(data viewmodels.AppsViewData) {
	@Layout(data.Layout) {
		@PageHeader([]Breadcrumb{
			{Label: "Dashboard", Href: "/"},
			{Label: "Assigned Apps"},
		}, "Apps discovered from Okta assignments.")
		@AppsPageResults(data)
	}
}

templ AssignedAppMobileRow(app viewmodels.AppListItem, isAdmin bool, csrfToken string) {
	<article class="rounded-lg border border-border/70 bg-card p-4">
		<div class="flex items-start justify-between gap-3">
			<div class="min-w-0">
				<a class="block font-medium text-foreground no-underline hover:underline" href={ AppDetailURL(app.IntegratedHref, app.ExternalID) } title={ app.Label }>
					<span class="osspm-truncate">{ app.Label }</span>
				</a>
				if app.Name != "" {
					<span class="block text-sm text-muted-foreground" title={ app.Name }>
						<span class="osspm-truncate">{ app.Name }</span>
					</span>
				}
			</div>
			<span class={ StatusBadgeClass(app.Status) }>{ app.Status }</span>
		</div>
		<div class="mt-3 grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
			<div>
				<div class="text-xs uppercase tracking-wide text-muted-foreground">Sign-on</div>
				<div>{ fallbackHumanized(app.SignOnMode) }</div>
			</div>
			<div>
				<div class="text-xs uppercase tracking-wide text-muted-foreground">Integration</div>
				<span class={ AssignedAppIntegrationBadgeClass(app.IntegratedHref != "") }>{ AssignedAppIntegrationLabel(app.IntegratedHref != "") }</span>
			</div>
		</div>
		<div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-border/60 pt-3 text-sm">
			<a class="btn-sm-link px-0" href={ AppDetailURL(app.IntegratedHref, app.ExternalID) } aria-label={ "View users for " + app.Label }>View</a>
			if isAdmin && app.IntegratedHref == "" && app.SuggestedKind != "" {
				<form method="post" action="/assigned-apps/map" class="inline-flex">
					@CSRFInput(csrfToken)
					<input type="hidden" name="integration_kind" value={ app.SuggestedKind }/>
					<input type="hidden" name="okta_app_external_id" value={ app.ExternalID }/>
					<button class="btn-sm-link px-0" type="submit">{ SuggestedIntegrationActionLabel(app.SuggestedKind) }</button>
				</form>
			}
		</div>
	</article>
}

templ AppsPageResults(data viewmodels.AppsViewData) {
	<div id="apps-results" class="space-y-6">
		@BusyInlineIndicator("Updating results...", false)
				<form
				method="get"
				action="/assigned-apps"
				data-enter-only-query="q"
				hx-get="/assigned-apps"
				hx-trigger="change delay:150ms from:select, submit"
				hx-target="#apps-results"
				hx-swap="outerHTML"
				hx-push-url="true"
				class="space-y-4 border-b border-border/70 pb-5"
			>
			<div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
				<label class="field w-full lg:max-w-xl">
					<span class="sr-only">Query</span>
					<div class="relative">
						<input type="search" name="q" value={ data.Query.Q } placeholder="Search label, name, or Okta ID" class="input pr-10"/>
						if data.Query.Q != "" {
							<a
								class="btn-icon-ghost absolute right-2 top-1/2 -translate-y-1/2"
								aria-label="Clear query"
								href={ data.Query.ClearQuery().Href() }
								hx-get={ data.Query.ClearQuery().Href() }
								hx-target="#apps-results"
								hx-swap="outerHTML"
								hx-push-url="true"
							>
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
									<path fill-rule="evenodd" d="M4.293 4.293a1 1 0 0 1 1.414 0L10 8.586l4.293-4.293a1 1 0 1 1 1.414 1.414L11.414 10l4.293 4.293a1 1 0 0 1-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 0 1-1.414-1.414L8.586 10 4.293 5.707a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"></path>
								</svg>
							</a>
						}
					</div>
				</label>
				<div class="text-sm text-muted-foreground lg:text-right">
					if data.TotalCount > 0 {
						{ "Showing " }{ FormatInt(data.ShowingFrom) }{ "-" }{ FormatInt(data.ShowingTo) }{ " of " }{ FormatInt64(data.TotalCount) }
					} else {
						Showing 0
					}
				</div>
			</div>
			<button class="sr-only" type="submit">Apply filters</button>
		</form>

			<section class="space-y-3">
				<div class="flex items-center gap-3">
					<div>
						<h2 class="text-base font-semibold">Assigned Apps</h2>
						<p class="text-sm text-muted-foreground">Browse apps discovered from Okta assignments.</p>
					</div>
				</div>
				if data.HasApps {
					<div class="space-y-3 lg:hidden">
						for _, app := range data.Apps {
							@AssignedAppMobileRow(app, data.Layout.IsAdmin, data.Layout.CSRFToken)
						}
					</div>
				} else {
					<div class="lg:hidden">
						@EmptyState("No apps found", data.EmptyStateMsg)
					</div>
				}
				@ColumnsTable("hidden lg:block") {
					<table class="table osspm-table-fixed osspm-table-compact osspm-table-list">
						<caption class="sr-only">Discovered apps with status, integration state, and user access actions.</caption>
						<thead>
							<tr>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">App</th>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Status</th>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Sign-on</th>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Integration</th>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">View Users</th>
						</tr>
					</thead>
					<tbody>
						if data.HasApps {
							for _, a := range data.Apps {
								<tr data-row-href={ AppDetailURL(a.IntegratedHref, a.ExternalID) } class="cursor-pointer hover:bg-muted/50">
									<td>
										<div class="flex min-w-0 flex-col">
											<a class="block px-0 font-medium no-underline hover:underline" href={ AppDetailURL(a.IntegratedHref, a.ExternalID) } data-tooltip={ a.Label } data-side="top" data-align="start">
												<span class="osspm-truncate">{ a.Label }</span>
											</a>
											if a.Name != "" {
												<span class="block text-muted-foreground" data-tooltip={ a.Name } data-side="top" data-align="start">
													<span class="osspm-truncate">{ a.Name }</span>
												</span>
											}
										</div>
									</td>
									<td><span class={ StatusBadgeClass(a.Status) }>{ a.Status }</span></td>
									<td class="text-muted-foreground">{ a.SignOnMode }</td>
									<td>
										if a.IntegratedHref != "" {
											<div class="inline-flex items-center justify-center">
												<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5 text-emerald-700 dark:text-emerald-300" aria-hidden="true">
													<path fill-rule="evenodd" d="M16.704 5.293a1 1 0 0 1 0 1.414l-8 8a1 1 0 0 1-1.414 0l-4-4a1 1 0 0 1 1.414-1.414L8 12.586l7.296-7.293a1 1 0 0 1 1.408 0Z" clip-rule="evenodd"/>
												</svg>
												<span class="sr-only">Integrated</span>
											</div>
										} else {
											<span class="text-muted-foreground">-</span>
										}
									</td>
									<td>
											<div class="flex flex-wrap items-center gap-3">
												<a class="btn-sm-link px-0" href={ AppDetailURL(a.IntegratedHref, a.ExternalID) } aria-label={ "View users for " + a.Label }>View</a>
												if data.Layout.IsAdmin && a.IntegratedHref == "" && a.SuggestedKind != "" {
													<form method="post" action="/assigned-apps/map" class="inline-flex">
														@CSRFInput(data.Layout.CSRFToken)
														<input type="hidden" name="integration_kind" value={ a.SuggestedKind }/>
														<input type="hidden" name="okta_app_external_id" value={ a.ExternalID }/>
														<button class="btn-sm-link px-0" type="submit">{ SuggestedIntegrationActionLabel(a.SuggestedKind) }</button>
													</form>
												}
											</div>
										</td>
								</tr>
							}
						} else {
							<tr>
								<td colspan="5">
									@EmptyState("No apps found", data.EmptyStateMsg)
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
			if data.TotalPages > 1 {
				<div class="flex flex-wrap items-center gap-3 border-t py-3">
						<div class="text-sm text-muted-foreground">{ "Page " }{ FormatInt(data.Page) }{ " of " }{ FormatInt(data.TotalPages) }</div>
						<div class="button-group ml-auto">
							if data.Page > 1 {
								<a class="btn-sm-outline" href={ data.Query.WithPage(data.Page-1).Href() } hx-get={ data.Query.WithPage(data.Page-1).Href() } hx-target="#apps-results" hx-swap="outerHTML" hx-push-url="true">Previous</a>
							} else {
								<span class="btn-sm-outline opacity-50" aria-disabled="true">Previous</span>
							}
							if data.Page < data.TotalPages {
								<a class="btn-sm-outline" href={ data.Query.WithPage(data.Page+1).Href() } hx-get={ data.Query.WithPage(data.Page+1).Href() } hx-target="#apps-results" hx-swap="outerHTML" hx-push-url="true">Next</a>
							} else {
								<span class="btn-sm-outline opacity-50" aria-disabled="true">Next</span>
							}
					</div>
				</div>
			}
		</section>
	</div>
}
