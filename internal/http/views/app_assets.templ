package views

import "github.com/open-sspm/open-sspm/internal/http/viewmodels"

templ AppAssetMobileRow(item viewmodels.AppAssetListItem) {
	<article class="rounded-lg border border-border/70 bg-card p-4">
		<div class="flex items-start justify-between gap-3">
			<div class="min-w-0">
				<a class="block font-medium no-underline hover:underline" href={ "/app-assets/" + FormatInt64(item.ID) } title={ item.DisplayName }>
					<span class="osspm-truncate">{ item.DisplayName }</span>
				</a>
				<div class="mt-2 flex flex-wrap items-center gap-2">
					<span class="badge-outline">{ HumanizeProgrammaticKind(item.SourceKind) }</span>
					<span class="badge-outline">{ HumanizeProgrammaticKind(item.AssetKind) }</span>
				</div>
				<div class="mt-2 text-sm text-muted-foreground">{ item.Status }</div>
				<div class="text-sm text-muted-foreground break-all">
					<code class="osspm-token">{ item.ExternalID }</code>
				</div>
			</div>
		</div>
		<div class="mt-3 grid grid-cols-3 gap-x-4 gap-y-3 text-sm">
			<div>
				<div class="text-xs uppercase tracking-wide text-muted-foreground">Owners</div>
				<div><span class="badge-outline">{ FormatInt(item.OwnersCount) }</span></div>
			</div>
			<div>
				<div class="text-xs uppercase tracking-wide text-muted-foreground">Credentials</div>
				<div><span class="badge-outline">{ FormatInt(item.CredentialsCount) }</span></div>
			</div>
			<div>
				<div class="text-xs uppercase tracking-wide text-muted-foreground">Last seen</div>
				<div>{ item.LastSeen.Label }</div>
			</div>
		</div>
	</article>
}

templ AppAssetsPage(data viewmodels.AppAssetsViewData) {
	@Layout(data.Layout) {
		@AppAssetsPageResults(data)
	}
}

templ AppAssetsPageResults(data viewmodels.AppAssetsViewData) {
	if data.GoogleOAuthView != nil {
		@ConnectedAppsPageResults(*data.GoogleOAuthView)
	} else {
	<div id="app-assets-results" class="space-y-6">
		@BusyInlineIndicator("Updating results...", false)
			<form
				method="get"
				action="/app-assets"
				data-enter-only-query="q"
				hx-get="/app-assets"
				hx-trigger="change delay:150ms from:[data-table-query-trigger], submit"
				hx-target="#app-assets-results"
				hx-swap="outerHTML"
				hx-push-url="true"
					class="osspm-list-form"
				>
					<div class="osspm-list-toolbar">
						<div class="min-w-0 flex-1">
							@TableQueryBar(AppAssetsTableQueryBar(data))
						</div>
						<div class="osspm-list-summary">
							if data.TotalCount > 0 {
								{ "Showing " }{ FormatInt(data.ShowingFrom) }{ "-" }{ FormatInt(data.ShowingTo) }{ " of " }{ FormatInt64(data.TotalCount) }
							} else {
								Showing 0
							}
						</div>
					</div>
				<button class="sr-only" type="submit">Apply filters</button>
			</form>

		<section class="space-y-3">
			if data.HasItems {
				<div class="space-y-3 lg:hidden">
					for _, item := range data.Items {
						@AppAssetMobileRow(item)
					}
				</div>
			} else {
				<div class="lg:hidden">
					@EmptyState("No app assets found", data.EmptyStateMsg) {
						if data.Layout.IsAdmin {
							<a class="btn-sm-outline" href="/settings/connectors">Configure connectors</a>
						}
					}
				</div>
			}
					@ColumnsTable("hidden lg:block") {
					<table class="table osspm-table-compact osspm-table-list">
						<caption class="sr-only">Programmatic app assets with source, kind, owner counts, credential counts, and last-seen time.</caption>
						<thead>
							<tr>
								<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Source</th>
								<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Kind</th>
								<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Name</th>
								<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">External ID</th>
								<th class="osspm-num text-xs font-medium uppercase tracking-wide text-muted-foreground">Owners</th>
								<th class="osspm-num text-xs font-medium uppercase tracking-wide text-muted-foreground">Credentials</th>
								<th class="osspm-num text-xs font-medium uppercase tracking-wide text-muted-foreground">Last seen</th>
							</tr>
						</thead>
							<tbody>
								if data.HasItems {
									for _, item := range data.Items {
										<tr data-row-href={ "/app-assets/" + FormatInt64(item.ID) } class="cursor-pointer hover:bg-muted/50">
											<td>
												<span class="badge-outline">{ HumanizeProgrammaticKind(item.SourceKind) }</span>
											</td>
											<td><span class="badge-outline">{ HumanizeProgrammaticKind(item.AssetKind) }</span></td>
											<td class="whitespace-normal">
												<a class="btn-sm-link px-0 font-medium" href={ "/app-assets/" + FormatInt64(item.ID) } title={ item.DisplayName }>{ item.DisplayName }</a>
												<div class="text-sm text-muted-foreground">{ item.Status }</div>
											</td>
											<td class="text-muted-foreground">
												<code class="osspm-token osspm-truncate" title={ item.ExternalID }>{ item.ExternalID }</code>
											</td>
											<td class="osspm-num"><span class="badge-outline">{ FormatInt(item.OwnersCount) }</span></td>
											<td class="osspm-num"><span class="badge-outline">{ FormatInt(item.CredentialsCount) }</span></td>
											<td class="osspm-num text-muted-foreground">{ item.LastSeen.Label }</td>
										</tr>
									}
								} else {
								<tr>
									<td colspan="7">
										@EmptyState("No app assets found", data.EmptyStateMsg) {
											if data.Layout.IsAdmin {
												<a class="btn-sm-outline" href="/settings/connectors">Configure connectors</a>
											}
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
				if data.TotalPages > 1 {
						<div class="osspm-list-pagination">
						<div class="text-sm text-muted-foreground">{ "Page " }{ FormatInt(data.Page) }{ " of " }{ FormatInt(data.TotalPages) }</div>
						<div class="button-group ml-auto">
							if data.Page > 1 {
									<a class="btn-sm-outline" href={ data.Query.WithPage(data.Page-1).Href() } hx-get={ data.Query.WithPage(data.Page-1).Href() } hx-target="#app-assets-results" hx-swap="outerHTML" hx-push-url="true">Previous</a>
							} else {
								<span class="btn-sm-outline opacity-50" aria-disabled="true">Previous</span>
							}
							if data.Page < data.TotalPages {
									<a class="btn-sm-outline" href={ data.Query.WithPage(data.Page+1).Href() } hx-get={ data.Query.WithPage(data.Page+1).Href() } hx-target="#app-assets-results" hx-swap="outerHTML" hx-push-url="true">Next</a>
							} else {
								<span class="btn-sm-outline opacity-50" aria-disabled="true">Next</span>
							}
						</div>
					</div>
				}
		</section>
	</div>
	}
}
