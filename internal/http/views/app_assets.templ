package views

import "github.com/open-sspm/open-sspm/internal/http/viewmodels"

templ AppAssetMobileRow(item viewmodels.AppAssetListItem) {
	<article class="osspm-mobile-list-row">
		<div class="flex items-start justify-between gap-3">
			<div class="flex min-w-0 items-start gap-3">
				@ProductIcon(item.DisplayName, item.SourceKind, item.AssetKind, "size-8")
				<div class="min-w-0">
						<a class="block font-medium no-underline hover:underline" href={ "/app-assets/" + FormatInt64(item.ID) } title={ item.DisplayName }>
							<span class="osspm-truncate" hx-disable>{ item.DisplayName }</span>
					</a>
					<div class="mt-1 text-sm text-muted-foreground">
						{ HumanizeProgrammaticKind(item.SourceKind) }{ " · " }{ HumanizeProgrammaticKind(item.AssetKind) }
					</div>
					<div class="mt-2 text-sm text-muted-foreground">{ item.Status }</div>
					<div class="text-sm text-muted-foreground break-all">
							<code class="osspm-token" hx-disable>{ item.ExternalID }</code>
					</div>
				</div>
			</div>
		</div>
		<div class="mt-3 grid grid-cols-3 gap-x-4 gap-y-3 text-sm">
			<div>
				<div class="text-xs uppercase tracking-wide text-muted-foreground">Owners</div>
				<div class="font-medium tabular-nums">{ FormatInt(item.OwnersCount) }</div>
			</div>
			<div>
				<div class="text-xs uppercase tracking-wide text-muted-foreground">Credentials</div>
				<div class="font-medium tabular-nums">{ FormatInt(item.CredentialsCount) }</div>
			</div>
			<div>
				<div class="text-xs uppercase tracking-wide text-muted-foreground">Last seen</div>
				<div>{ item.LastSeen.Label }</div>
			</div>
		</div>
	</article>
}

templ AppAssetsPage(data viewmodels.AppAssetsViewData) {
	@Layout(data.Layout) {
		if data.GoogleOAuthView != nil {
			@ConnectedAppsPageFilters(*data.GoogleOAuthView)
			@ConnectedAppsPageResults(*data.GoogleOAuthView)
		} else {
			@AppAssetsPageFilters(data)
			@AppAssetsPageResults(data)
		}
	}
}

templ AppAssetsPageFilters(data viewmodels.AppAssetsViewData) {
			<form
				method="get"
				action="/app-assets"
				data-enter-only-query="q"
				hx-get="/app-assets"
				hx-trigger="change delay:150ms from:[data-table-query-trigger], submit"
				hx-sync="this:replace"
				hx-target="#app-assets-results"
				hx-push-url="true"
					class="osspm-list-form"
				>
					<div class="osspm-list-toolbar">
						<div class="min-w-0 flex-1">
							@AskBar(AppAssetsAskBar(data))
						</div>
					</div>
				<button class="sr-only" type="submit">Apply filters</button>
			</form>
}

templ AppAssetsPageResults(data viewmodels.AppAssetsViewData) {
	if data.GoogleOAuthView != nil {
		@ConnectedAppsPageResults(*data.GoogleOAuthView)
	} else {
		{{ cfg := AppAssetsTableConfig(data) }}
		@TableResults(cfg) {
			@TableMobile() {
				for _, item := range data.Items {
					@AppAssetMobileRow(item)
				}
			}
			@TableDesktop() {
				@ColumnsTable("") {
					<table class="table osspm-table-fixed osspm-table-compact osspm-table-list">
						@TableCaption(cfg.Caption)
						<thead>
							<tr>
								for _, column := range AppAssetsColumns() {
									@TableColumnHeader(column, TableSortConfig{})
								}
							</tr>
						</thead>
						<tbody>
							for _, item := range data.Items {
										<tr data-row-href={ "/app-assets/" + FormatInt64(item.ID) } class="cursor-pointer hover:bg-muted/50">
											<td class="whitespace-normal">
												<div class="flex min-w-0 items-center gap-3">
													@ProductIcon(item.DisplayName, item.SourceKind, item.AssetKind, "size-8")
													<div class="min-w-0 flex-1">
													<a class="btn-sm-link px-0 font-medium" href={ "/app-assets/" + FormatInt64(item.ID) } title={ item.DisplayName }>{ item.DisplayName }</a>
													<div class="text-sm text-muted-foreground">{ HumanizeProgrammaticKind(item.SourceKind) }{ " · " }{ HumanizeProgrammaticKind(item.AssetKind) }{ " · " }{ item.Status }</div>
													<code class="osspm-token mt-1 block max-w-full truncate text-xs" title={ item.ExternalID }>{ item.ExternalID }</code>
												</div>
											</div>
										</td>
											<td class="osspm-num">{ FormatInt(item.OwnersCount) }</td>
											<td class="osspm-num">{ FormatInt(item.CredentialsCount) }</td>
											<td class="osspm-num text-muted-foreground">{ item.LastSeen.Label }</td>
										</tr>
							}
						</tbody>
					</table>
				}
			}
		}
	}
}
