package views

import "github.com/open-sspm/open-sspm/internal/http/viewmodels"

templ GitHubUserMobileRow(user viewmodels.GitHubUserListItem) {
	<article class="rounded-lg border border-border/70 bg-card p-4">
		<div class="flex items-start justify-between gap-3">
			<div class="min-w-0">
					<div class="font-medium break-all" hx-disable>{ user.ExternalID }</div>
				if user.DisplayName != "" {
					<div class="text-sm text-muted-foreground" title={ user.DisplayName }>
							<span class="osspm-truncate" hx-disable>{ user.DisplayName }</span>
					</div>
				}
			</div>
		</div>
		<div class="mt-3 grid grid-cols-1 gap-3 text-sm">
			<div>
				<div class="text-xs uppercase tracking-wide text-muted-foreground">Identity</div>
				if user.IdentityID > 0 {
					<a class="btn-sm-link px-0" href={ "/identities/" + FormatInt64(user.IdentityID) }>{ "Identity #" }{ FormatInt64(user.IdentityID) }</a>
				} else {
					<div class="text-muted-foreground">—</div>
				}
			</div>
		</div>
	</article>
}

templ GitHubUsersPage(data viewmodels.GitHubUsersViewData) {
	@Layout(data.Layout) {
			@PageHeader("") {
				if data.Layout.GitHubConfigured && data.Layout.GitHubEnabled {
					<a class="btn-sm-outline" href={ "/accounts/needs-anchor/github/" + data.Layout.GitHubOrg }>Needs anchor</a>
				} else {
					@ConnectorConfigureLink("/settings/connectors?open=github", "btn-sm-outline") {
						Configure
					}
				}
			}

		if data.Layout.GitHubConfigured && data.Layout.GitHubEnabled {
				@Alert("Linking", false) {
					<p>
						When a GitHub account is anchored, you can jump straight to the identity page. Accounts without an anchor show “—”. Use
						<a class="btn-sm-link px-1" href={ "/accounts/needs-anchor/github/" + data.Layout.GitHubOrg }>Needs anchor</a>
						to resolve them.
					</p>
				}
		} else {
			@Alert("GitHub sync disabled", true) {
				<p>
					{ data.EmptyStateMsg } @ConnectorConfigureLink(data.EmptyStateHref, "btn-sm-link px-1") {
						Configure GitHub
					}.
				</p>
			}
		}

		@GitHubUsersPageFilters(data)
		@GitHubUsersPageResults(data)
	}
}

templ GitHubUsersPageFilters(data viewmodels.GitHubUsersViewData) {
		<form
			method="get"
			action="/accounts/github"
			data-enter-only-query="q"
			hx-get="/accounts/github"
			hx-trigger="change delay:150ms from:[data-table-query-trigger], submit"
			hx-sync="this:replace"
			hx-target="#github-users-results"
			hx-push-url="true"
			class="osspm-list-form"
		>
			<div class="osspm-list-toolbar">
				<div class="min-w-0 flex-1">
					@AskBar(SearchOnlyAskBar(data.Query, "Search login or name", "#github-users-results"))
				</div>
			</div>
			<button class="sr-only" type="submit">Apply filters</button>
		</form>
}

templ GitHubUsersPageResults(data viewmodels.GitHubUsersViewData) {
	<div id="github-users-results" class="space-y-5">
		@BusyInlineIndicator("Updating results...", false)
		<section class="space-y-3">
			@ListSectionHeader("GitHub users", "GitHub accounts synced from your organization.")
			if data.HasUsers {
				<div class="space-y-3 lg:hidden">
					for _, u := range data.Users {
						@GitHubUserMobileRow(u)
					}
				</div>
			} else {
				<div class="lg:hidden">
					@EmptyState("No users found", data.EmptyStateMsg)
				</div>
			}
			@ColumnsTable("hidden lg:block") {
				<table class="table osspm-table-fixed osspm-table-compact osspm-table-list">
					<caption class="sr-only">GitHub users with display names and linked identity references.</caption>
					<thead>
						<tr>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">GitHub login</th>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Name</th>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Identity</th>
						</tr>
					</thead>
					<tbody>
						if data.HasUsers {
							for _, u := range data.Users {
								<tr>
										<td class="font-medium" hx-disable>{ u.ExternalID }</td>
										<td class="text-muted-foreground" hx-disable>{ u.DisplayName }</td>
									<td>
										if u.IdentityID > 0 {
											<a class="btn-sm-link" href={ "/identities/" + FormatInt64(u.IdentityID) }>{ "Identity #" }{ FormatInt64(u.IdentityID) }</a>
										} else {
											<span class="text-muted-foreground">&mdash;</span>
										}
									</td>
								</tr>
							}
						} else {
							<tr>
								<td colspan="3">
									@EmptyState("No users found", data.EmptyStateMsg)
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
			if data.TotalPages > 1 {
				@ListPagination("github-users-results", data.Page, data.TotalPages, BasicListPageHref(data.Query))
			}
		</section>
	</div>
}
