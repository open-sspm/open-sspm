package views

import (
	"github.com/open-sspm/open-sspm/internal/http/querystate"
	"github.com/open-sspm/open-sspm/internal/http/viewmodels"
)

templ GoogleWorkspaceGroupMobileRow(group viewmodels.GoogleWorkspaceGroupListItem) {
	<article class="rounded-lg border border-border/70 bg-card p-4">
		<div class="min-w-0">
			<div class="font-medium" title={ group.DisplayName }>
				<span class="osspm-truncate">{ group.DisplayName }</span>
			</div>
			if group.Email != "" {
				<div class="text-sm text-muted-foreground break-all">{ group.Email }</div>
			} else if group.ExternalID != "" {
				<div class="text-sm text-muted-foreground break-all">{ group.ExternalID }</div>
			}
		</div>
		<div class="mt-3 grid grid-cols-3 gap-x-4 gap-y-3 text-sm">
			<div>
				<div class="text-xs uppercase tracking-wide text-muted-foreground">Members</div>
				<div><span class="badge-outline">{ FormatInt(group.MemberCount) }</span></div>
			</div>
			<div>
				<div class="text-xs uppercase tracking-wide text-muted-foreground">Owners</div>
				<div><span class="badge-outline">{ FormatInt(group.OwnerCount) }</span></div>
			</div>
			<div>
				<div class="text-xs uppercase tracking-wide text-muted-foreground">Managers</div>
				<div><span class="badge-outline">{ FormatInt(group.ManagerCount) }</span></div>
			</div>
		</div>
	</article>
}

templ GoogleWorkspaceGroupsPage(data viewmodels.GoogleWorkspaceGroupsViewData) {
	@Layout(data.Layout) {
		@PageHeader("Synced Google Workspace groups with membership visibility.") {
			<a class="btn-sm-outline" href="/accounts/google-workspace">Users</a>
			<a class="btn-sm-outline" href={ querystate.ConnectedAppsQuery{}.Href() }>OAuth Apps</a>
		}

		if !data.Layout.GoogleWorkspaceConfigured || !data.Layout.GoogleWorkspaceEnabled {
			@Alert("Google Workspace sync disabled", true) {
				<p>
					{ data.EmptyStateMsg } <a class="btn-sm-link px-1" href={ data.EmptyStateHref }>Configure Google Workspace</a>.
				</p>
			}
		}

			<form method="get" class="osspm-list-form">
				<div class="osspm-list-toolbar">
				<div class="min-w-0 flex-1">
					@TableQueryBar(SearchOnlyBasicListQueryBar(data.Query, "Search email, name, or group ID"))
				</div>
					<div class="osspm-list-summary">
					if data.TotalCount > 0 {
						{ "Showing " }{ FormatInt(data.ShowingFrom) }{ "-" }{ FormatInt(data.ShowingTo) }{ " of " }{ FormatInt64(data.TotalCount) }
					} else {
						Showing 0
					}
				</div>
			</div>
			<button class="sr-only" type="submit">Apply filters</button>
		</form>

		<section class="space-y-3">
				<div class="osspm-list-section-header">
				<div>
					<h2 class="text-base font-semibold">Google Workspace groups</h2>
					<p class="text-sm text-muted-foreground">Google Workspace groups with membership counts.</p>
				</div>
			</div>
			if data.HasGroups {
				<div class="space-y-3 lg:hidden">
					for _, g := range data.Groups {
						@GoogleWorkspaceGroupMobileRow(g)
					}
				</div>
			} else {
				<div class="lg:hidden">
					@EmptyState("No groups found", data.EmptyStateMsg)
				</div>
			}
			@ColumnsTable("hidden lg:block") {
				<table class="table osspm-table-fixed osspm-table-compact osspm-table-list">
					<caption class="sr-only">Google Workspace groups with member and owner counts.</caption>
					<thead>
						<tr>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Group</th>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Email</th>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Members</th>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Owners</th>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Managers</th>
						</tr>
					</thead>
					<tbody>
						if data.HasGroups {
							for _, g := range data.Groups {
								<tr>
									<td>
										<div class="space-y-1">
											<div class="font-medium">{ g.DisplayName }</div>
											if g.ExternalID != "" {
												<div class="text-xs text-muted-foreground">{ g.ExternalID }</div>
											}
										</div>
									</td>
									<td>
										if g.Email != "" {
											{ g.Email }
										} else {
											<span class="text-muted-foreground">&mdash;</span>
										}
									</td>
									<td><span class="badge-outline">{ FormatInt(g.MemberCount) }</span></td>
									<td><span class="badge-outline">{ FormatInt(g.OwnerCount) }</span></td>
									<td><span class="badge-outline">{ FormatInt(g.ManagerCount) }</span></td>
								</tr>
							}
						} else {
							<tr>
								<td colspan="5">
									@EmptyState("No groups found", data.EmptyStateMsg)
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
			if data.TotalPages > 1 {
					<div class="osspm-list-pagination">
						<div class="text-sm text-muted-foreground">{ "Page " }{ FormatInt(data.Page) }{ " of " }{ FormatInt(data.TotalPages) }</div>
						<div class="button-group ml-auto">
							if data.Page > 1 {
								<a class="btn-sm-outline" href={ data.Query.WithPage(data.Page-1).Href() }>Previous</a>
							} else {
								<span class="btn-sm-outline opacity-50" aria-disabled="true">Previous</span>
							}
							if data.Page < data.TotalPages {
								<a class="btn-sm-outline" href={ data.Query.WithPage(data.Page+1).Href() }>Next</a>
							} else {
								<span class="btn-sm-outline opacity-50" aria-disabled="true">Next</span>
							}
					</div>
				</div>
			}
		</section>
	}
}
