package views

import "github.com/open-sspm/open-sspm/internal/http/viewmodels"

templ EntraUserMobileRow(user viewmodels.EntraUserListItem) {
	<article class="rounded-lg border border-border/70 bg-card p-4">
		<div class="flex items-start justify-between gap-3">
			<div class="min-w-0">
				<div class="font-medium" title={ user.DisplayName }>
					<span class="osspm-truncate">{ user.DisplayName }</span>
				</div>
				if user.Email != "" {
					<div class="text-sm text-muted-foreground break-all">{ user.Email }</div>
				} else if user.ExternalID != "" {
					<div class="text-sm text-muted-foreground break-all">{ user.ExternalID }</div>
				}
			</div>
		</div>
		<div class="mt-3 grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
			<div>
				<div class="text-xs uppercase tracking-wide text-muted-foreground">Directory roles</div>
				<div><span class="badge-outline">{ FormatInt(user.DirectoryRoleCount) }</span></div>
			</div>
			<div>
				<div class="text-xs uppercase tracking-wide text-muted-foreground">Enterprise apps</div>
				<div><span class="badge-outline">{ FormatInt(user.EnterpriseAppCount) }</span></div>
			</div>
			<div class="col-span-2">
				<div class="text-xs uppercase tracking-wide text-muted-foreground">Identity</div>
				if user.IdentityID > 0 {
					<a class="btn-sm-link px-0" href={ "/identities/" + FormatInt64(user.IdentityID) }>{ "Identity #" }{ FormatInt64(user.IdentityID) }</a>
				} else {
					<div class="text-muted-foreground">—</div>
				}
			</div>
		</div>
	</article>
}

templ EntraUsersPage(data viewmodels.EntraUsersViewData) {
	@Layout(data.Layout) {
			@PageHeader("") {
				if data.Layout.EntraConfigured && data.Layout.EntraEnabled {
					<a class="btn-sm-outline" href="/accounts/needs-anchor/entra">Needs anchor</a>
				} else {
					<a class="btn-sm-outline" href="/settings/connectors?open=entra">Configure</a>
				}
			}

		if data.Layout.EntraConfigured && data.Layout.EntraEnabled {
				@Alert("Linking", false) {
					<p>
						Anchored users let you jump straight to their identity page. Users without an anchor show “—”. Use
						<a class="btn-sm-link px-1" href="/accounts/needs-anchor/entra">Needs anchor</a>
						to resolve them.
					</p>
				}
		} else {
			@Alert("Microsoft Entra ID sync disabled", true) {
				<p>
					{ data.EmptyStateMsg } <a class="btn-sm-link px-1" href={ data.EmptyStateHref }>Configure Microsoft Entra ID</a>.
				</p>
			}
		}

		@EntraUsersPageFilters(data)
		@EntraUsersPageResults(data)
	}
}

templ EntraUsersPageFilters(data viewmodels.EntraUsersViewData) {
		<form
			method="get"
			action="/accounts/entra"
			data-enter-only-query="q"
			hx-get="/accounts/entra"
			hx-trigger="change delay:150ms from:[data-table-query-trigger], submit"
			hx-target="#entra-users-results"
			hx-swap="outerHTML"
			hx-push-url="true"
			class="osspm-list-form"
		>
			<div class="osspm-list-toolbar">
				<div class="min-w-0 flex-1">
					@AskBar(SearchOnlyAskBar(data.Query, "Search email, name, or user ID", "#entra-users-results"))
				</div>
			</div>
			<button class="sr-only" type="submit">Apply filters</button>
		</form>
}

templ EntraUsersPageResults(data viewmodels.EntraUsersViewData) {
	<div id="entra-users-results" class="space-y-5">
		@BusyInlineIndicator("Updating results...", false)
		<section class="space-y-3">
			@ListSectionHeader("Microsoft Entra ID users", "Microsoft Entra ID users and their access entitlements.")
			if data.HasUsers {
				<div class="space-y-3 lg:hidden">
					for _, u := range data.Users {
						@EntraUserMobileRow(u)
					}
				</div>
			} else {
				<div class="lg:hidden">
					@EmptyState("No users found", data.EmptyStateMsg)
				</div>
			}
			@ColumnsTable("hidden lg:block") {
				<table class="table osspm-table-fixed osspm-table-compact osspm-table-list">
					<caption class="sr-only">Microsoft Entra ID users with directory role counts, enterprise app counts, and linked identities.</caption>
					<thead>
						<tr>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">User</th>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Email</th>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Directory roles</th>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Enterprise apps</th>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Identity</th>
						</tr>
					</thead>
					<tbody>
						if data.HasUsers {
							for _, u := range data.Users {
								<tr>
									<td>
										<div class="space-y-1">
											<div class="font-medium">{ u.DisplayName }</div>
											if u.ExternalID != "" {
												<div class="text-xs text-muted-foreground">{ u.ExternalID }</div>
											}
										</div>
									</td>
									<td>
										if u.Email != "" {
											{ u.Email }
										} else {
											<span class="text-muted-foreground">&mdash;</span>
										}
									</td>
									<td>
										<span class="badge-outline">{ FormatInt(u.DirectoryRoleCount) }</span>
									</td>
									<td>
										<span class="badge-outline">{ FormatInt(u.EnterpriseAppCount) }</span>
									</td>
									<td>
										if u.IdentityID > 0 {
											<a class="btn-sm-link" href={ "/identities/" + FormatInt64(u.IdentityID) }>{ "Identity #" }{ FormatInt64(u.IdentityID) }</a>
										} else {
											<span class="text-muted-foreground">&mdash;</span>
										}
									</td>
								</tr>
							}
						} else {
							<tr>
								<td colspan="5">
									@EmptyState("No users found", data.EmptyStateMsg)
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
			if data.TotalPages > 1 {
				@ListPagination("entra-users-results", data.Page, data.TotalPages, BasicListPageHref(data.Query))
			}
		</section>
	</div>
}
