package views

import "github.com/open-sspm/open-sspm/internal/http/viewmodels"

templ OverviewMap(graph viewmodels.OverviewMapGraph) {
	if len(graph.Sources) > 0 {
		<section class="overview-map" aria-label="Relationship map" data-testid="overview-map">
			<header class="overview-map-header">
				<div>
					<h2>Relationship map</h2>
					<p>Configured identity sources, managed account coverage, and highest-risk privileged buckets.</p>
				</div>
				<a class="btn-sm-ghost" href="/global-view">Connector coverage <span aria-hidden="true">→</span></a>
			</header>

			<div class="overview-map-surface hidden lg:block">
				<svg class="overview-map-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
					for _, source := range graph.Sources {
						<path class="overview-map-edge" d={ OverviewMapEdgePath(graph.CenterX, graph.CenterY, source.X, source.Y) } data-testid="overview-map-edge"></path>
					}
				</svg>
				<div class="overview-map-node overview-map-center" style={ OverviewMapNodeStyle(graph.CenterX, graph.CenterY) } data-testid="overview-map-center">
					<div class="overview-map-center-icon" aria-hidden="true">
						@IconUsers("size-7")
					</div>
					<p>Identities</p>
					<span class="overview-map-center-count">{ FormatInt64(graph.IdentityCount) }</span>
					<span>{ FormatInt64(graph.AccountCount) } source accounts</span>
				</div>
				for _, source := range graph.Sources {
					@overviewMapSourceNode(source)
				}
			</div>

			<div class="overview-map-list lg:hidden">
				for _, source := range graph.Sources {
					@overviewMapSourceListItem(source)
				}
			</div>
		</section>
	}
}

templ overviewMapSourceNode(source viewmodels.OverviewMapSourceNode) {
	@overviewMapMaybeLink(source.Href, OverviewMapSourceClass(source.Tone), OverviewMapNodeStyle(source.X, source.Y), "overview-map-node") {
		@overviewMapSourceNodeContent(source)
	}
}

templ overviewMapSourceNodeContent(source viewmodels.OverviewMapSourceNode) {
	<div class="overview-map-source-main">
		<div class="overview-map-source-icon" aria-hidden="true">
			@GlobalAppIcon(source.Kind)
		</div>
		<div class="min-w-0">
			<div class="overview-map-source-title">
				<span>{ source.Label }</span>
				<span class="overview-map-source-count">{ FormatInt64(source.AccountCount) }</span>
			</div>
			if source.SourceName != "" {
				<p title={ source.SourceName }>{ source.SourceName }</p>
			}
		</div>
	</div>
	<div class="overview-map-meter" role="progressbar" aria-label={ source.Label + " managed account coverage" } aria-valuemin="0" aria-valuemax="100" aria-valuenow={ FormatInt(source.CoveragePercent) }>
		<div style={ "width: " + FormatInt(source.CoveragePercent) + "%" }></div>
	</div>
	<div class="overview-map-source-stats">
		<span>{ FormatInt64(source.IdentityCount) } identities</span>
		<span>{ FormatInt64(source.UnmanagedAccountCount) } unmanaged</span>
	</div>
	@overviewMapBuckets(source.Buckets, "overview-risk-buckets")
}

templ overviewMapSourceListItem(source viewmodels.OverviewMapSourceNode) {
	@overviewMapMaybeLink(source.Href, "overview-map-list-item", "", "overview-map-list-item") {
		@overviewMapSourceListContent(source)
	}
}

templ overviewMapSourceListContent(source viewmodels.OverviewMapSourceNode) {
	<div class="flex min-w-0 items-center gap-3">
		<div class="overview-map-source-icon" aria-hidden="true">
			@GlobalAppIcon(source.Kind)
		</div>
		<div class="min-w-0">
			<div class="flex items-baseline gap-2">
				<p class="truncate text-sm font-semibold">{ source.Label }</p>
				<span class="text-xs text-muted-foreground">{ FormatInt64(source.AccountCount) } accounts</span>
			</div>
			if source.SourceName != "" {
				<p class="truncate text-xs text-muted-foreground">{ source.SourceName }</p>
			}
		</div>
	</div>
	<div class="mt-3 flex flex-wrap gap-2">
		<span class="badge-outline">{ FormatInt(source.CoveragePercent) }% managed</span>
		if source.UnmanagedAccountCount > 0 {
			<span class="badge-outline">{ FormatInt64(source.UnmanagedAccountCount) } unmanaged</span>
		}
		@overviewMapBuckets(source.Buckets, "contents")
	</div>
}

templ overviewMapMaybeLink(href, className, style, testID string) {
	if href != "" {
		if style != "" {
			<a class={ className } style={ style } href={ templ.SafeURL(href) } data-testid={ testID }>
				{ children... }
			</a>
		} else {
			<a class={ className } href={ templ.SafeURL(href) } data-testid={ testID }>
				{ children... }
			</a>
		}
	} else {
		if style != "" {
			<div class={ className } style={ style } data-testid={ testID }>
				{ children... }
			</div>
		} else {
			<div class={ className } data-testid={ testID }>
				{ children... }
			</div>
		}
	}
}

templ overviewMapBuckets(buckets []viewmodels.OverviewMapBucket, wrapperClass string) {
	if len(buckets) > 0 {
		<div class={ wrapperClass }>
			for _, bucket := range buckets {
				@overviewMapBucket(bucket)
			}
		</div>
	}
}

templ overviewMapBucket(bucket viewmodels.OverviewMapBucket) {
	<span class={ OverviewMapSeverityClass(bucket.Severity) } data-testid="overview-map-bucket">
		<span>{ bucket.Label }</span>
		<span class="overview-risk-bucket-count">{ FormatInt64(bucket.AffectedCount) }</span>
	</span>
}
