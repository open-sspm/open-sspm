package views

templ PageHeader(description string) {
	if description != "" {
		<div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
			<div class="space-y-2">
				<p class="text-muted-foreground">{ description }</p>
			</div>
			<div class="flex flex-wrap items-center justify-start gap-2 md:ml-auto md:justify-end empty:hidden">
				{ children... }
			</div>
		</div>
	} else {
		<div class="flex flex-wrap items-center justify-start gap-2 md:ml-auto md:justify-end empty:hidden">
			{ children... }
		</div>
	}
}

templ Alert(title string, destructive bool) {
	<div
		role={ AlertRole(destructive) }
		aria-live={ AlertAriaLive(destructive) }
		aria-atomic="true"
		class={ templ.Classes("alert", templ.KV("alert-destructive", destructive)) }
	>
		if title != "" {
			<h3>{ title }</h3>
		}
		<section class="empty:hidden">
			{ children... }
		</section>
	</div>
}

templ EmptyState(title, description string) {
	<div class="flex flex-col items-center justify-center gap-2 py-12 text-center">
		@IconInfo("size-4 text-muted-foreground")
		<h2 class="text-lg font-semibold">{ title }</h2>
		if description != "" {
			<p class="max-w-md text-muted-foreground">{ description }</p>
		}
		<div class="pt-2 empty:hidden">
			{ children... }
		</div>
	</div>
}

templ ConnectorConfigureLink(href string, class string) {
	if dialogHref := ConnectorDialogHref(href); dialogHref != "" {
		<a class={ class } href={ href } hx-get={ dialogHref } hx-target="body" hx-swap="beforeend" hx-push-url="false">{ children... }</a>
	} else {
		<a class={ class } href={ href }>{ children... }</a>
	}
}

templ BusyInlineIndicator(label string, initiallyVisible bool) {
	<div
		data-busy-inline-indicator
		data-busy-inline-indicator-active?={ initiallyVisible }
		role="status"
		aria-live="polite"
		aria-atomic="true"
		class="items-center gap-2 text-xs text-muted-foreground"
	>
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-3.5 w-3.5 animate-spin" aria-hidden="true">
			<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" fill="none" class="opacity-25"></circle>
			<path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round" fill="none" class="opacity-90"></path>
		</svg>
		<span>{ label }</span>
	</div>
}

templ ListSectionHeader(title, description string) {
	<div class="osspm-list-section-header">
		<div>
			<h2 class="text-base font-semibold">{ title }</h2>
			if description != "" {
				<p class="text-sm text-muted-foreground">{ description }</p>
			}
		</div>
	</div>
}

templ ListPagination(targetID string, page, totalPages int, hrefForPage func(int) string) {
	<div class="osspm-list-pagination">
		<div class="text-sm text-muted-foreground">{ "Page " }{ FormatInt(page) }{ " of " }{ FormatInt(totalPages) }</div>
		<div class="button-group ml-auto">
			@paginationButton(targetID, hrefForPage, page-1, page > 1, "Previous")
			@paginationButton(targetID, hrefForPage, page+1, page < totalPages, "Next")
		</div>
	</div>
}

// paginationButton renders either an active anchor (with htmx swap) or a
// disabled <a> element. Disabled state uses aria-disabled and tabindex=-1 so
// keyboard users skip past it; styling is via .btn-sm-outline + opacity-50.
templ paginationButton(targetID string, hrefForPage func(int) string, targetPage int, enabled bool, label string) {
	if enabled {
		{{ href := hrefForPage(targetPage) }}
		<a class="btn-sm-outline" href={ href } hx-get={ href } hx-target={ "#" + targetID } hx-swap="outerHTML show:top" hx-push-url="true">{ label }</a>
	} else {
		<a class="btn-sm-outline opacity-50" aria-disabled="true" tabindex="-1" role="link">{ label }</a>
	}
}

templ ColumnsTable(containerClass string) {
	<div class={ templ.Classes("min-w-0", templ.KV(containerClass, containerClass != "")) }>
		<div class="min-w-0 overflow-x-auto">
			{ children... }
		</div>
	</div>
}

templ FilterPopover(label string, activeCount int, open bool, panelClass string) {
	<details class="relative osspm-filters-disclosure" open?={ open }>
		<summary class="osspm-filter-summary">
			@IconFilter("h-4 w-4 text-muted-foreground")
			<span>{ label }</span>
			if activeCount > 0 {
				<span class="flex h-5 min-w-5 items-center justify-center rounded-full bg-primary px-1 text-[11px] font-medium text-primary-foreground">
					{ FormatInt(activeCount) }
				</span>
			}
		</summary>
		<div class={ templ.Classes("filter-popover osspm-filter-panel-popover", templ.KV(panelClass, panelClass != "")) }>
			{ children... }
		</div>
	</details>
}

templ CSRFInput(token string) {
	<input type="hidden" name="csrf" value={ token }/>
}

// ConfirmDialogShell renders the always-present <dialog> that the confirm.js
// listener populates when htmx:confirm fires. Lives once in the layout; the
// JS sets the title/body/buttons at confirm time, then issues the original
// htmx request when accepted.
templ ConfirmDialogShell() {
	<dialog id="osspm-confirm-dialog" class="dialog" data-osspm-confirm-dialog aria-labelledby="osspm-confirm-title" aria-describedby="osspm-confirm-description">
		<form method="dialog" data-osspm-confirm-form>
			<button type="button" class="btn-icon-ghost" aria-label="Close" data-dialog-close data-osspm-confirm-cancel>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
					<path fill-rule="evenodd" d="M4.293 4.293a1 1 0 0 1 1.414 0L10 8.586l4.293-4.293a1 1 0 1 1 1.414 1.414L11.414 10l4.293 4.293a1 1 0 0 1-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 0 1-1.414-1.414L8.586 10 4.293 5.707a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"/>
				</svg>
			</button>
			<header>
				<h2 id="osspm-confirm-title" data-osspm-confirm-title>Confirm</h2>
				<p id="osspm-confirm-description" data-osspm-confirm-description class="sr-only"></p>
			</header>
			<section class="space-y-3">
				<p class="text-sm" data-osspm-confirm-body></p>
				<label class="block text-sm" data-osspm-confirm-reason hidden>
					<span class="mb-1 block text-sm font-medium" data-osspm-confirm-reason-label>Reason</span>
					<textarea data-osspm-confirm-reason-input name="reason" rows="3" class="w-full rounded-md border border-border bg-background p-2 text-sm"></textarea>
				</label>
			</section>
			<footer>
				<button type="button" class="btn-ghost" data-dialog-close data-osspm-confirm-cancel>Cancel</button>
				<button type="button" class="btn-primary" data-osspm-confirm-accept>Confirm</button>
			</footer>
		</form>
	</dialog>
}

templ CopyTextButton(value string, label string) {
	if CopyableValue(value) {
		<button
			type="button"
			class="btn-icon-ghost h-5 w-5 shrink-0 rounded-sm"
			aria-label={ label }
			title={ label }
			data-copy-text={ value }
			data-copy-label={ label }
		>
			@IconCopy("size-3.5")
		</button>
	}
}

templ FormDialog(id string, open bool, title string, description string, closeHref string, formAction string, submitLabel string, csrfToken string) {
	<dialog id={ id } class="dialog" data-open?={ open } data-close-href={ closeHref } aria-labelledby={ id + "-title" } aria-describedby={ id + "-description" }>
		<form method="post" action={ formAction }>
			@CSRFInput(csrfToken)
			<button type="button" class="btn-icon-ghost" aria-label="Close" data-dialog-close>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
					<path fill-rule="evenodd" d="M4.293 4.293a1 1 0 0 1 1.414 0L10 8.586l4.293-4.293a1 1 0 1 1 1.414 1.414L11.414 10l4.293 4.293a1 1 0 0 1-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 0 1-1.414-1.414L8.586 10 4.293 5.707a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"/>
				</svg>
			</button>
			<header>
				<h2 id={ id + "-title" }>{ title }</h2>
				<p id={ id + "-description" } class={ templ.Classes(templ.KV("sr-only", description == "")) }>{ description }</p>
			</header>
			<section class="space-y-4">
				{ children... }
			</section>
			<footer>
				<button type="button" class="btn-ghost" data-dialog-close>Cancel</button>
				<button type="submit" class="btn-primary">{ submitLabel }</button>
			</footer>
		</form>
	</dialog>
}

templ HtmxFormDialog(id string, open bool, title string, description string, formAction string, submitLabel string, csrfToken string) {
	{{ mutationAttrs := MutationFormAttrs() }}
	<dialog id={ id } class="dialog" data-open?={ open } data-remove-on-close aria-labelledby={ id + "-title" } aria-describedby={ id + "-description" }>
		<form method="post" action={ formAction } hx-post={ formAction } hx-target="closest dialog" { mutationAttrs... }>
			@CSRFInput(csrfToken)
			<button type="button" class="btn-icon-ghost" aria-label="Close" data-dialog-close>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
					<path fill-rule="evenodd" d="M4.293 4.293a1 1 0 0 1 1.414 0L10 8.586l4.293-4.293a1 1 0 1 1 1.414 1.414L11.414 10l4.293 4.293a1 1 0 0 1-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 0 1-1.414-1.414L8.586 10 4.293 5.707a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"/>
				</svg>
			</button>
			<header>
				<h2 id={ id + "-title" }>{ title }</h2>
				<p id={ id + "-description" } class={ templ.Classes(templ.KV("sr-only", description == "")) }>{ description }</p>
			</header>
			<section class="space-y-4">
				{ children... }
			</section>
			<footer>
				<button type="button" class="btn-ghost" data-dialog-close>Cancel</button>
				<button type="submit" class="btn-primary">{ submitLabel }</button>
			</footer>
		</form>
	</dialog>
}
