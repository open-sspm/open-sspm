package views

import "github.com/open-sspm/open-sspm/internal/http/viewmodels"

templ IdentitiesPage(data viewmodels.IdentitiesViewData) {
	@Layout(data.Layout) {
		@PageHeader("Unified identities resolved across configured connectors.") {
		}
		@IdentitiesPageResults(data)
	}
}

templ IdentitiesPageResults(data viewmodels.IdentitiesViewData) {
	<div id="identities-results" class="space-y-6">
		@BusyInlineIndicator("Updating results...", false)
		<form
			method="get"
			action="/identities"
			data-enter-only-query="q"
			hx-get="/identities"
			hx-trigger="change delay:150ms from:[data-table-query-trigger], submit"
			hx-target="#identities-results"
			hx-swap="outerHTML"
			hx-push-url="true"
				class="osspm-list-form"
			>
					<div class="osspm-list-toolbar">
						<div class="min-w-0 flex-1">
							@TableQueryBar(IdentitiesTableQueryBar(data))
						</div>
						<div class="osspm-list-summary">
							if data.TotalCount > 0 {
								{ "Showing " }{ FormatInt(data.ShowingFrom) }{ "-" }{ FormatInt(data.ShowingTo) }{ " of " }{ FormatInt64(data.TotalCount) }
							} else {
								Showing 0
							}
						</div>
					</div>
				<button class="sr-only" type="submit">Apply filters</button>
			</form>

		<section class="space-y-3">
			if data.HasIdentities {
				<div class="space-y-3 lg:hidden">
					for _, item := range data.Items {
						<article class="rounded-lg border border-border/70 bg-card p-4">
							<div class="flex items-start justify-between gap-3">
								<div class="min-w-0">
									<a class="block font-medium no-underline hover:underline" href={ "/identities/" + FormatInt64(item.ID) } title={ item.NamePrimary }>
										<span class="osspm-truncate">{ item.NamePrimary }</span>
									</a>
									if item.NameSecondary != "" {
										<span class="block text-sm text-muted-foreground" title={ item.NameSecondary }>
											<span class="osspm-truncate">{ item.NameSecondary }</span>
										</span>
									}
								</div>
								<span class={ IdentityRowStateBadgeClass(item.RowState) }>{ HumanizeIdentityRowState(item.RowState) }</span>
							</div>
							<div class="mt-2 flex flex-wrap items-center gap-2">
								<span class={ IdentityManagedBadgeClass(item.Managed) }>
									if item.Managed {
										Managed
									} else {
										Unmanaged
									}
								</span>
								<span class={ IdentityStatusBadgeClass(item.Status) }>{ HumanizeIdentityStatus(item.Status) }</span>
								if item.PrivilegedRoles > 0 {
									<span class={ "badge " + IdentityPrivilegedRoleClass(item.PrivilegedRoles) }>{ FormatInt64(item.PrivilegedRoles) }{ " privileged" }</span>
								}
							</div>
							<div class="mt-3 grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
								<div>
									<div class="text-xs uppercase tracking-wide text-muted-foreground">Type</div>
									<div>{ HumanizeIdentityType(item.IdentityType) }</div>
								</div>
								<div>
									<div class="text-xs uppercase tracking-wide text-muted-foreground">Source</div>
									if item.SourceKind != "" {
										<div>{ HumanizeProgrammaticKind(item.SourceKind) }</div>
										if item.SourceName != "" {
											<div class="osspm-truncate text-xs text-muted-foreground" title={ item.SourceName }>{ item.SourceName }</div>
										}
										if item.IntegrationsCount > 1 {
											<div class="text-xs text-muted-foreground">{ FormatInt64(item.IntegrationsCount) }{ " sources" }</div>
										}
									} else {
										<div class="text-muted-foreground">—</div>
									}
								</div>
								<div>
									<div class="text-xs uppercase tracking-wide text-muted-foreground">Privileged roles</div>
									<div class={ IdentityPrivilegedRoleClass(item.PrivilegedRoles) }>{ FormatInt64(item.PrivilegedRoles) }</div>
								</div>
								<div>
									<div class="text-xs uppercase tracking-wide text-muted-foreground">Last seen</div>
									<div>{ item.LastSeen.Label }</div>
									if item.LastSeen.Relative != "" {
										<div class="text-xs text-muted-foreground">{ item.LastSeen.Relative }</div>
									}
								</div>
							</div>
						</article>
					}
				</div>
			} else {
				<div class="lg:hidden">
					@EmptyState("No identities found", data.EmptyStateMsg)
				</div>
			}
			@ColumnsTable("hidden lg:block") {
				<table class="table osspm-table-fixed osspm-table-compact osspm-table-list">
						<caption class="sr-only">Identity inventory with source, status, privilege, and activity context.</caption>
						<thead>
							<tr>
								<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Identity</th>
								<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Type</th>
								<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Managed</th>
								<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Source</th>
								<th class="osspm-num text-xs font-medium uppercase tracking-wide text-muted-foreground">Privileged roles</th>
								<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">State</th>
								<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Status</th>
								<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Last seen</th>
								<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">First seen</th>
							</tr>
						</thead>
						<tbody>
							if data.HasIdentities {
								for _, item := range data.Items {
									<tr data-row-href={ "/identities/" + FormatInt64(item.ID) } class={ IdentityRowClass(item.RowState) }>
										<td>
											<div class="flex min-w-0 flex-col">
												<a class="block px-0 font-medium no-underline hover:underline" href={ "/identities/" + FormatInt64(item.ID) } data-tooltip={ item.NamePrimary } data-side="top" data-align="start">
													<span class="osspm-truncate">{ item.NamePrimary }</span>
												</a>
												if item.NameSecondary != "" {
													<span class="block text-muted-foreground" data-tooltip={ item.NameSecondary } data-side="top" data-align="start">
														<span class="osspm-truncate">{ item.NameSecondary }</span>
													</span>
												}
											</div>
										</td>
										<td class="text-sm">{ HumanizeIdentityType(item.IdentityType) }</td>
										<td>
											<span class={ IdentityManagedBadgeClass(item.Managed) }>
												if item.Managed {
													Managed
												} else {
													Unmanaged
												}
											</span>
										</td>
										<td>
											if item.SourceKind != "" {
												<span class="osspm-cell-primary font-normal">{ HumanizeProgrammaticKind(item.SourceKind) }</span>
												if item.SourceName != "" {
													<span class="osspm-cell-secondary osspm-truncate" title={ item.SourceName }>{ item.SourceName }</span>
												}
												if item.IntegrationsCount > 1 {
													<span class="osspm-cell-secondary">{ FormatInt64(item.IntegrationsCount) }{ " sources" }</span>
												}
											} else {
												<span class="text-muted-foreground">—</span>
											}
										</td>
										<td class={ "osspm-num text-center " + IdentityPrivilegedRoleClass(item.PrivilegedRoles) }>{ FormatInt64(item.PrivilegedRoles) }</td>
										<td><span class={ IdentityRowStateBadgeClass(item.RowState) }>{ HumanizeIdentityRowState(item.RowState) }</span></td>
										<td>
											<span class={ IdentityStatusBadgeClass(item.Status) }>{ HumanizeIdentityStatus(item.Status) }</span>
										</td>
										<td>
											<span class="osspm-cell-primary">{ item.LastSeen.Label }</span>
											if item.LastSeen.Relative != "" {
												<span class="osspm-cell-secondary">{ item.LastSeen.Relative }</span>
											}
										</td>
										<td>{ item.FirstSeen.Label }</td>
									</tr>
								}
							} else {
								<tr>
									<td colspan="9">
										@EmptyState("No identities found", data.EmptyStateMsg)
									</td>
								</tr>
							}
						</tbody>
				</table>
			}
			if data.TotalPages > 1 {
					<div class="osspm-list-pagination">
					<div class="text-sm text-muted-foreground">{ "Page " }{ FormatInt(data.Page) }{ " of " }{ FormatInt(data.TotalPages) }</div>
					<div class="button-group ml-auto">
						if data.Page > 1 {
								<a class="btn-sm-outline" href={ data.Query.WithPage(data.Page-1).Href() } hx-get={ data.Query.WithPage(data.Page-1).Href() } hx-target="#identities-results" hx-swap="outerHTML" hx-push-url="true">Previous</a>
						} else {
							<span class="btn-sm-outline opacity-50" aria-disabled="true">Previous</span>
						}
						if data.Page < data.TotalPages {
								<a class="btn-sm-outline" href={ data.Query.WithPage(data.Page+1).Href() } hx-get={ data.Query.WithPage(data.Page+1).Href() } hx-target="#identities-results" hx-swap="outerHTML" hx-push-url="true">Next</a>
						} else {
							<span class="btn-sm-outline opacity-50" aria-disabled="true">Next</span>
						}
					</div>
				</div>
			}
		</section>
	</div>
}
