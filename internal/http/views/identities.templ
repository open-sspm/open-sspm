package views

import (
	"fmt"

	"github.com/open-sspm/open-sspm/internal/http/querystate"
	"github.com/open-sspm/open-sspm/internal/http/viewmodels"
)

templ IdentitiesPage(data viewmodels.IdentitiesViewData) {
	@Layout(data.Layout) {
		@IdentitiesPageResults(data)
	}
}

templ IdentitiesPageResults(data viewmodels.IdentitiesViewData) {
	<div id="identities-results" class="space-y-5">
		@BusyInlineIndicator("Updating results...", false)
		@identitiesStatStrip(data)
		@identitiesSegmentChips(data.Query, data.Summary)
		<form
			method="get"
			action="/identities"
			data-enter-only-query="q"
			hx-get="/identities"
			hx-trigger="change delay:150ms from:[data-table-query-trigger], submit"
			hx-target="#identities-results"
			hx-swap="outerHTML"
			hx-push-url="true"
			class="osspm-list-form-tight"
		>
			<div class="osspm-list-toolbar">
				<div class="min-w-0 flex-1">
					@TableQueryBar(IdentitiesTableQueryBar(data))
				</div>
				<div class="osspm-list-summary">
					if data.TotalCount > 0 {
						{ "Showing " }{ FormatInt(data.ShowingFrom) }{ "-" }{ FormatInt(data.ShowingTo) }{ " of " }{ FormatInt64(data.TotalCount) }
					} else {
						Showing 0
					}
				</div>
			</div>
			<button class="sr-only" type="submit">Apply filters</button>
		</form>
		<section class="space-y-3">
			if data.HasIdentities {
				<div class="space-y-3 lg:hidden">
					for _, item := range data.Items {
						@identityCardMobile(item)
					}
				</div>
			} else {
				<div class="lg:hidden">
					@EmptyState("No identities found", data.EmptyStateMsg)
				</div>
			}
			@ColumnsTable("hidden lg:block") {
				<table class="table osspm-table-fixed osspm-table-compact osspm-table-list osspm-identities-table">
					<caption class="sr-only">Identity inventory with source, privilege, and activity context.</caption>
					<colgroup>
						<col class="osspm-col-identity"/>
						<col class="osspm-col-type"/>
						<col class="osspm-col-source"/>
						<col class="osspm-col-num"/>
						<col class="osspm-col-managed"/>
						<col class="osspm-col-state"/>
						<col class="osspm-col-lastseen"/>
					</colgroup>
					<thead>
						<tr>
							<th>Identity</th>
							<th>Type</th>
							<th>Source</th>
							<th class="osspm-num">Privileged</th>
							<th>Managed</th>
							<th>State</th>
							<th>Last seen</th>
						</tr>
					</thead>
					<tbody>
						if data.HasIdentities {
							for _, item := range data.Items {
								@identityRowDesktop(item)
							}
						} else {
							<tr>
								<td colspan="7">
									@EmptyState("No identities found", data.EmptyStateMsg)
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
			if data.TotalPages > 1 {
				<div class="osspm-list-pagination">
					<div class="text-sm text-muted-foreground">{ "Page " }{ FormatInt(data.Page) }{ " of " }{ FormatInt(data.TotalPages) }</div>
					<div class="button-group ml-auto">
						if data.Page > 1 {
							<a class="btn-sm-outline" href={ data.Query.WithPage(data.Page-1).Href() } hx-get={ data.Query.WithPage(data.Page-1).Href() } hx-target="#identities-results" hx-swap="outerHTML" hx-push-url="true">Previous</a>
						} else {
							<span class="btn-sm-outline opacity-50" aria-disabled="true">Previous</span>
						}
						if data.Page < data.TotalPages {
							<a class="btn-sm-outline" href={ data.Query.WithPage(data.Page+1).Href() } hx-get={ data.Query.WithPage(data.Page+1).Href() } hx-target="#identities-results" hx-swap="outerHTML" hx-push-url="true">Next</a>
						} else {
							<span class="btn-sm-outline opacity-50" aria-disabled="true">Next</span>
						}
					</div>
				</div>
			}
		</section>
		@OverviewMap(data.OverviewMap)
	</div>
}

// identitiesStatStrip renders the top summary line: total plus four operator
// numbers. Uses typographic hierarchy only — no cards, no tiles, no borders
// between stats. Each number is tabular so they align vertically across syncs.
templ identitiesStatStrip(data viewmodels.IdentitiesViewData) {
	<section class="osspm-stat-strip" aria-label="Identity inventory summary">
		@identityStat(FormatInt64(data.Summary.Total), "identities in scope", "")
		@identityStat(FormatInt64(data.Summary.ActionRequired), "need action", identityStatTone(data.Summary.ActionRequired, "danger"))
		@identityStat(FormatInt64(data.Summary.Privileged), "privileged", identityStatTone(data.Summary.Privileged, "warn"))
		@identityStat(FormatInt64(data.Summary.Unmanaged), "unmanaged", "")
		@identityStat(FormatInt64(data.Summary.Suspended), "suspended", "")
	</section>
}

templ identityStat(value, label, tone string) {
	<div class="osspm-stat">
		<div class={ "osspm-stat-value " + tone }>{ value }</div>
		<div class="osspm-stat-label">{ label }</div>
	</div>
}

// identitiesSegmentChips renders quick-filter links that scope the table to a
// single operator-meaningful segment. Each chip is a plain anchor (GET-based,
// per repo convention) rather than a toggle so it survives HTMX pushState and
// plays nicely with the Back button.
templ identitiesSegmentChips(q querystate.IdentitiesQuery, s viewmodels.IdentitiesSummary) {
	<nav class="osspm-segment-chips" aria-label="Identity segments">
		@segmentChip(q.ClearSegments().Href(), "All", FormatInt64(s.Total), !q.HasSegment(), "")
		@segmentChip(q.SegmentNeedsAction().Href(), "Needs action", FormatInt64(s.ActionRequired), q.RowState == "action_required", "danger")
		@segmentChip(q.SegmentPrivilegedUnmanaged().Href(), "Privileged unmanaged", FormatInt64(s.PrivilegedUnmanaged), q.PrivilegedOnly && q.ManagedState == "unmanaged" && q.RowState == "", "warn")
		@segmentChip(q.SegmentStalePrivileged().Href(), "Stale privileged", FormatInt64(s.StalePrivileged), q.PrivilegedOnly && q.ActivityState == "stale" && q.RowState == "", "warn")
		@segmentChip(q.ClearSegments().WithStatus("suspended").Href(), "Suspended", FormatInt64(s.Suspended), q.Status == "suspended", "")
		@segmentChip(q.SegmentReview().Href(), "Review", FormatInt64(s.Review), q.RowState == "review", "warn")
	</nav>
}

templ segmentChip(href, label, count string, active bool, tone string) {
	<a
		href={ templ.SafeURL(href) }
		hx-get={ href }
		hx-target="#identities-results"
		hx-swap="outerHTML"
		hx-push-url="true"
		class={ segmentChipClass(active, tone) }
		aria-current={ AriaCurrentBool(active) }
	>
		<span>{ label }</span>
		<span class="osspm-segment-chip-count">{ count }</span>
	</a>
}

templ identityCardMobile(item viewmodels.IdentityListItem) {
	<a
		href={ templ.SafeURL(fmt.Sprintf("/identities/%d", item.ID)) }
		class="osspm-identity-card"
	>
		<div class="flex items-start justify-between gap-3">
			<div class="min-w-0">
				<div class="font-medium truncate">{ item.NamePrimary }</div>
				if item.NameSecondary != "" {
					<div class="text-sm text-muted-foreground truncate">{ item.NameSecondary }</div>
				}
				<div class="mt-1 text-xs text-muted-foreground">
					{ HumanizeIdentityType(item.IdentityType) }
					if item.Status != "" && item.Status != "active" {
						{ " · " }{ HumanizeIdentityStatus(item.Status) }
					}
				</div>
			</div>
			<span class={ IdentityRowStateBadgeClass(item.RowState) }>{ HumanizeIdentityRowState(item.RowState) }</span>
		</div>
		<dl class="mt-3 grid grid-cols-3 gap-x-3 gap-y-2 text-sm">
			<div>
				<dt class="osspm-stat-label">Source</dt>
				<dd class="truncate">
					if item.SourceKind != "" {
						{ HumanizeProgrammaticKind(item.SourceKind) }
					} else {
						<span class="text-muted-foreground">—</span>
					}
				</dd>
			</div>
			<div>
				<dt class="osspm-stat-label">Privileged</dt>
				<dd class={ "tabular-nums " + IdentityPrivilegedRoleClass(item.PrivilegedRoles) }>{ FormatInt64(item.PrivilegedRoles) }</dd>
			</div>
			<div>
				<dt class="osspm-stat-label">Last seen</dt>
				<dd class="truncate">
					if item.LastSeen.Relative != "" {
						{ item.LastSeen.Relative }
					} else {
						{ item.LastSeen.Label }
					}
				</dd>
			</div>
		</dl>
	</a>
}

templ identityRowDesktop(item viewmodels.IdentityListItem) {
	<tr data-row-href={ fmt.Sprintf("/identities/%d", item.ID) } class={ IdentityRowClass(item.RowState) }>
		<td>
			<a class="osspm-identity-link" href={ templ.SafeURL(fmt.Sprintf("/identities/%d", item.ID)) }>
				<span class="osspm-identity-name" data-tooltip={ item.NamePrimary } data-side="top" data-align="start">{ item.NamePrimary }</span>
				<span class="osspm-identity-meta">
					if item.NameSecondary != "" {
						<span class="osspm-identity-email" data-tooltip={ item.NameSecondary } data-side="top" data-align="start">{ item.NameSecondary }</span>
					}
					if identityShouldShowStatusInline(item.Status) {
						<span class="osspm-identity-status">{ HumanizeIdentityStatus(item.Status) }</span>
					}
				</span>
			</a>
		</td>
		<td class="text-sm text-muted-foreground">{ HumanizeIdentityType(item.IdentityType) }</td>
		<td>
			if item.SourceKind != "" {
				<span class="osspm-cell-primary font-normal">{ HumanizeProgrammaticKind(item.SourceKind) }</span>
				if item.IntegrationsCount > 1 {
					<span class="osspm-cell-secondary">{ FormatInt64(item.IntegrationsCount) }{ " sources" }</span>
				} else if item.SourceName != "" {
					<span class="osspm-cell-secondary truncate" title={ item.SourceName }>{ item.SourceName }</span>
				}
			} else {
				<span class="text-muted-foreground">—</span>
			}
		</td>
		<td class={ "osspm-num " + IdentityPrivilegedRoleClass(item.PrivilegedRoles) }>{ FormatInt64(item.PrivilegedRoles) }</td>
		<td>
			if item.Managed {
				<span class="text-sm text-muted-foreground">Managed</span>
			} else {
				<span class="text-sm font-medium text-amber-800 dark:text-amber-300">Unmanaged</span>
			}
		</td>
		<td><span class={ IdentityRowStateBadgeClass(item.RowState) }>{ HumanizeIdentityRowState(item.RowState) }</span></td>
		<td>
			if item.LastSeen.Relative != "" {
				<span class="osspm-cell-primary" title={ item.LastSeen.Label }>{ item.LastSeen.Relative }</span>
			} else if item.LastSeen.Label != "" {
				<span class="osspm-cell-primary">{ item.LastSeen.Label }</span>
			} else {
				<span class="text-muted-foreground">—</span>
			}
		</td>
	</tr>
}
