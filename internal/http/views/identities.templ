package views

import "github.com/open-sspm/open-sspm/internal/http/viewmodels"

templ IdentitiesPage(data viewmodels.IdentitiesViewData) {
	@Layout(data.Layout) {
		@PageHeader([]Breadcrumb{
			{Label: "Dashboard", Href: "/"},
			{Label: "Identities"},
		}, "Unified identities resolved across configured connectors.") {
		}
		@IdentitiesPageResults(data)
	}
}

templ IdentitiesPageResults(data viewmodels.IdentitiesViewData) {
	<div id="identities-results" class="space-y-6">
		@BusyInlineIndicator("Updating results...", false)
		<form
			method="get"
			action="/identities"
			data-enter-only-query="q"
			hx-get="/identities"
			hx-trigger="change delay:150ms from:select, change from:input[type='checkbox'], submit"
			hx-target="#identities-results"
			hx-swap="outerHTML"
			hx-push-url="true"
			class="space-y-4 border-b border-border/70 pb-5"
		>
			<div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
				<label class="field w-full lg:max-w-xl">
					<span class="sr-only">Query</span>
					<div class="relative">
							<input type="search" name="q" value={ data.Query.Q } placeholder="Search name, email, or external ID" class="input pr-10"/>
							if data.Query.Q != "" {
								<a
									class="btn-icon-ghost absolute right-2 top-1/2 -translate-y-1/2"
									aria-label="Clear query"
									href={ data.Query.ClearQuery().Href() }
									hx-get={ data.Query.ClearQuery().Href() }
								hx-target="#identities-results"
								hx-swap="outerHTML"
								hx-push-url="true"
							>
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
									<path fill-rule="evenodd" d="M4.293 4.293a1 1 0 0 1 1.414 0L10 8.586l4.293-4.293a1 1 0 1 1 1.414 1.414L11.414 10l4.293 4.293a1 1 0 0 1-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 0 1-1.414-1.414L8.586 10 4.293 5.707a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"></path>
								</svg>
							</a>
						}
					</div>
				</label>
				<div class="text-sm text-muted-foreground lg:text-right">
					if data.TotalCount > 0 {
						{ "Showing " }{ FormatInt(data.ShowingFrom) }{ "-" }{ FormatInt(data.ShowingTo) }{ " of " }{ FormatInt64(data.TotalCount) }
					} else {
						Showing 0
					}
				</div>
			</div>
			<div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Activity filters">
				<a
						class={ FilterPillClass(data.Query.ActivityState == "") }
						href={ data.Query.WithActivityState("").Href() }
						hx-get={ data.Query.WithActivityState("").Href() }
					hx-target="#identities-results"
					hx-swap="outerHTML"
					hx-push-url="true"
				>
					Any activity
				</a>
				<a
						class={ FilterPillClass(data.Query.ActivityState == "recent") }
						href={ data.Query.WithActivityState("recent").Href() }
						hx-get={ data.Query.WithActivityState("recent").Href() }
					hx-target="#identities-results"
					hx-swap="outerHTML"
					hx-push-url="true"
				>
					Seen &lt; 30d
				</a>
				<a
						class={ FilterPillClass(data.Query.ActivityState == "aging") }
						href={ data.Query.WithActivityState("aging").Href() }
						hx-get={ data.Query.WithActivityState("aging").Href() }
					hx-target="#identities-results"
					hx-swap="outerHTML"
					hx-push-url="true"
				>
					30-89d
				</a>
				<a
						class={ FilterPillClass(data.Query.ActivityState == "stale") }
						href={ data.Query.WithActivityState("stale").Href() }
						hx-get={ data.Query.WithActivityState("stale").Href() }
					hx-target="#identities-results"
					hx-swap="outerHTML"
					hx-push-url="true"
				>
					90d+
				</a>
				<a
						class={ FilterPillClass(data.Query.ActivityState == "never_seen") }
						href={ data.Query.WithActivityState("never_seen").Href() }
						hx-get={ data.Query.WithActivityState("never_seen").Href() }
					hx-target="#identities-results"
					hx-swap="outerHTML"
					hx-push-url="true"
				>
					Never seen
				</a>
				<span class="mx-2 h-4 w-px bg-border" aria-hidden="true"></span>
				<a
						class={ FilterPillClass(data.Query.PrivilegedOnly) }
						href={ data.Query.TogglePrivilegedOnly().Href() }
						hx-get={ data.Query.TogglePrivilegedOnly().Href() }
					hx-target="#identities-results"
					hx-swap="outerHTML"
					hx-push-url="true"
				>
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="mr-1 h-3 w-3" aria-hidden="true">
						<path fill-rule="evenodd" d="M8 1a3.5 3.5 0 0 0-3.5 3.5V7A1.5 1.5 0 0 0 3 8.5v4A1.5 1.5 0 0 0 4.5 14h7a1.5 1.5 0 0 0 1.5-1.5v-4A1.5 1.5 0 0 0 11 7V4.5A3.5 3.5 0 0 0 8 1Zm2 6V4.5a2 2 0 1 0-4 0V7h4Z" clip-rule="evenodd"/>
					</svg>
					Privileged only
				</a>
			</div>
			<details class="group">
				<summary class="inline-flex cursor-pointer list-none items-center gap-2 text-sm text-muted-foreground hover:text-foreground">
					<span class="text-base leading-none group-open:hidden">+</span>
					<span class="text-base leading-none hidden group-open:inline">−</span>
					<span>More filters and sorting</span>
				</summary>
				<div class="mt-4 grid gap-4 rounded-lg border border-border/70 bg-muted/15 p-4 md:grid-cols-3 xl:grid-cols-6">
					<label class="field">
						<span class="label">Status</span>
						<select class="select" name="status">
								<option value="" selected?={ data.Query.Status == "" }>Any</option>
								<option value="active" selected?={ data.Query.Status == "active" }>Active</option>
								<option value="suspended" selected?={ data.Query.Status == "suspended" }>Suspended</option>
								<option value="orphaned" selected?={ data.Query.Status == "orphaned" }>Orphaned</option>
								<option value="deleted" selected?={ data.Query.Status == "deleted" }>Deleted</option>
								<option value="unknown" selected?={ data.Query.Status == "unknown" }>Unknown</option>
						</select>
					</label>
					<label class="field">
						<span class="label">Source</span>
						<select class="select" name="source_kind">
								<option value="" selected?={ data.Query.Source.Kind == "" }>All configured</option>
								for _, source := range data.Sources {
									<option value={ source.SourceKind } selected?={ source.SourceKind == data.Query.Source.Kind } title={ source.Label }>{ source.Label }</option>
								}
							</select>
						</label>
					<label class="field">
						<span class="label">Source name</span>
						<select class="select" name="source_name">
								<option value="" selected?={ data.Query.Source.Name == "" }>All source names</option>
								for _, source := range data.SourceNameOptions {
									<option value={ source.SourceName } selected?={ source.SourceName == data.Query.Source.Name }>{ source.SourceName }</option>
								}
							</select>
						</label>
					<label class="field">
						<span class="label">Type</span>
						<select class="select" name="identity_type">
								<option value="" selected?={ data.Query.IdentityType == "" }>Any</option>
								<option value="human" selected?={ data.Query.IdentityType == "human" }>Human</option>
								<option value="service" selected?={ data.Query.IdentityType == "service" }>Service</option>
								<option value="bot" selected?={ data.Query.IdentityType == "bot" }>Bot</option>
								<option value="unknown" selected?={ data.Query.IdentityType == "unknown" }>Unknown</option>
						</select>
					</label>
					<label class="field">
						<span class="label">Managed</span>
						<select class="select" name="managed_state">
								<option value="" selected?={ data.Query.ManagedState == "" }>Any</option>
								<option value="managed" selected?={ data.Query.ManagedState == "managed" }>Managed</option>
								<option value="unmanaged" selected?={ data.Query.ManagedState == "unmanaged" }>Unmanaged</option>
						</select>
					</label>
					<label class="field">
						<span class="label">Sort</span>
						<select class="select" name="sort_by">
								<option value="" selected?={ data.Query.SortBy == "" }>Priority (default)</option>
								<option value="identity" selected?={ data.Query.SortBy == "identity" }>Identity</option>
								<option value="identity_type" selected?={ data.Query.SortBy == "identity_type" }>Identity type</option>
								<option value="managed" selected?={ data.Query.SortBy == "managed" }>Managed</option>
								<option value="source_type" selected?={ data.Query.SortBy == "source_type" }>Source type</option>
								<option value="linked_sources" selected?={ data.Query.SortBy == "linked_sources" }>Linked sources</option>
								<option value="privileged_roles" selected?={ data.Query.SortBy == "privileged_roles" }>Privileged roles</option>
								<option value="status" selected?={ data.Query.SortBy == "status" }>Status</option>
								<option value="last_seen" selected?={ data.Query.SortBy == "last_seen" }>Last seen</option>
						</select>
					</label>
					<label class="field">
						<span class="label">Direction</span>
						<select class="select" name="sort_dir">
								<option value="desc" selected?={ data.Query.SortDir == "desc" || data.Query.SortDir == "" }>Descending</option>
								<option value="asc" selected?={ data.Query.SortDir == "asc" }>Ascending</option>
						</select>
					</label>
				</div>
			</details>
			<button class="sr-only" type="submit">Apply filters</button>
		</form>

		<section class="space-y-3">
			if data.HasIdentities {
				<div class="space-y-3 lg:hidden">
					for _, item := range data.Items {
						<article class="rounded-lg border border-border/70 bg-card p-4">
							<div class="flex items-start justify-between gap-3">
								<div class="min-w-0">
									<a class="block font-medium no-underline hover:underline" href={ "/identities/" + FormatInt64(item.ID) } title={ item.NamePrimary }>
										<span class="osspm-truncate">{ item.NamePrimary }</span>
									</a>
									if item.NameSecondary != "" {
										<span class="block text-sm text-muted-foreground" title={ item.NameSecondary }>
											<span class="osspm-truncate">{ item.NameSecondary }</span>
										</span>
									}
								</div>
								<span class={ IdentityRowStateBadgeClass(item.RowState) }>{ HumanizeIdentityRowState(item.RowState) }</span>
							</div>
							<div class="mt-2 flex flex-wrap items-center gap-2">
								<span class={ IdentityManagedBadgeClass(item.Managed) }>
									if item.Managed {
										Managed
									} else {
										Unmanaged
									}
								</span>
								<span class={ IdentityStatusBadgeClass(item.Status) }>{ HumanizeIdentityStatus(item.Status) }</span>
								if item.PrivilegedRoles > 0 {
									<span class={ "badge " + IdentityPrivilegedRoleClass(item.PrivilegedRoles) }>{ FormatInt64(item.PrivilegedRoles) }{ " privileged" }</span>
								}
							</div>
							<div class="mt-3 grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
								<div>
									<div class="text-xs uppercase tracking-wide text-muted-foreground">Type</div>
									<div>{ HumanizeIdentityType(item.IdentityType) }</div>
								</div>
								<div>
									<div class="text-xs uppercase tracking-wide text-muted-foreground">Source</div>
									if item.SourceKind != "" {
										<div>{ HumanizeProgrammaticKind(item.SourceKind) }</div>
										if item.SourceName != "" {
											<div class="osspm-truncate text-xs text-muted-foreground" title={ item.SourceName }>{ item.SourceName }</div>
										}
										if item.IntegrationsCount > 1 {
											<div class="text-xs text-muted-foreground">{ FormatInt64(item.IntegrationsCount) }{ " sources" }</div>
										}
									} else {
										<div class="text-muted-foreground">—</div>
									}
								</div>
								<div>
									<div class="text-xs uppercase tracking-wide text-muted-foreground">Privileged roles</div>
									<div class={ IdentityPrivilegedRoleClass(item.PrivilegedRoles) }>{ FormatInt64(item.PrivilegedRoles) }</div>
								</div>
								<div>
									<div class="text-xs uppercase tracking-wide text-muted-foreground">Last seen</div>
									<div>{ item.LastSeen.Label }</div>
									if item.LastSeen.Relative != "" {
										<div class="text-xs text-muted-foreground">{ item.LastSeen.Relative }</div>
									}
								</div>
							</div>
						</article>
					}
				</div>
			} else {
				<div class="lg:hidden">
					@EmptyState("No identities found", data.EmptyStateMsg)
				</div>
			}
			@ColumnsTable("hidden lg:block") {
				<table class="table osspm-table-fixed osspm-table-compact osspm-table-list">
						<caption class="sr-only">Identity inventory with source, status, privilege, and activity context.</caption>
						<thead>
							<tr>
								<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Identity</th>
								<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Type</th>
								<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Managed</th>
								<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Source</th>
								<th class="osspm-num text-xs font-medium uppercase tracking-wide text-muted-foreground">Privileged roles</th>
								<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">State</th>
								<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Status</th>
								<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Last seen</th>
								<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">First seen</th>
							</tr>
						</thead>
						<tbody>
							if data.HasIdentities {
								for _, item := range data.Items {
									<tr data-row-href={ "/identities/" + FormatInt64(item.ID) } class={ IdentityRowClass(item.RowState) }>
										<td>
											<div class="flex min-w-0 flex-col">
												<a class="block px-0 font-medium no-underline hover:underline" href={ "/identities/" + FormatInt64(item.ID) } data-tooltip={ item.NamePrimary } data-side="top" data-align="start">
													<span class="osspm-truncate">{ item.NamePrimary }</span>
												</a>
												if item.NameSecondary != "" {
													<span class="block text-muted-foreground" data-tooltip={ item.NameSecondary } data-side="top" data-align="start">
														<span class="osspm-truncate">{ item.NameSecondary }</span>
													</span>
												}
											</div>
										</td>
										<td class="text-sm">{ HumanizeIdentityType(item.IdentityType) }</td>
										<td>
											<span class={ IdentityManagedBadgeClass(item.Managed) }>
												if item.Managed {
													Managed
												} else {
													Unmanaged
												}
											</span>
										</td>
										<td>
											if item.SourceKind != "" {
												<span class="osspm-cell-primary font-normal">{ HumanizeProgrammaticKind(item.SourceKind) }</span>
												if item.SourceName != "" {
													<span class="osspm-cell-secondary osspm-truncate" title={ item.SourceName }>{ item.SourceName }</span>
												}
												if item.IntegrationsCount > 1 {
													<span class="osspm-cell-secondary">{ FormatInt64(item.IntegrationsCount) }{ " sources" }</span>
												}
											} else {
												<span class="text-muted-foreground">—</span>
											}
										</td>
										<td class={ "osspm-num text-center " + IdentityPrivilegedRoleClass(item.PrivilegedRoles) }>{ FormatInt64(item.PrivilegedRoles) }</td>
										<td><span class={ IdentityRowStateBadgeClass(item.RowState) }>{ HumanizeIdentityRowState(item.RowState) }</span></td>
										<td>
											<span class={ IdentityStatusBadgeClass(item.Status) }>{ HumanizeIdentityStatus(item.Status) }</span>
										</td>
										<td>
											<span class="osspm-cell-primary">{ item.LastSeen.Label }</span>
											if item.LastSeen.Relative != "" {
												<span class="osspm-cell-secondary">{ item.LastSeen.Relative }</span>
											}
										</td>
										<td>{ item.FirstSeen.Label }</td>
									</tr>
								}
							} else {
								<tr>
									<td colspan="9">
										@EmptyState("No identities found", data.EmptyStateMsg)
									</td>
								</tr>
							}
						</tbody>
				</table>
			}
			if data.TotalPages > 1 {
				<div class="flex flex-wrap items-center gap-3 border-t py-3">
					<div class="text-sm text-muted-foreground">{ "Page " }{ FormatInt(data.Page) }{ " of " }{ FormatInt(data.TotalPages) }</div>
					<div class="button-group ml-auto">
						if data.Page > 1 {
								<a class="btn-sm-outline" href={ data.Query.WithPage(data.Page-1).Href() } hx-get={ data.Query.WithPage(data.Page-1).Href() } hx-target="#identities-results" hx-swap="outerHTML" hx-push-url="true">Previous</a>
						} else {
							<span class="btn-sm-outline opacity-50" aria-disabled="true">Previous</span>
						}
						if data.Page < data.TotalPages {
								<a class="btn-sm-outline" href={ data.Query.WithPage(data.Page+1).Href() } hx-get={ data.Query.WithPage(data.Page+1).Href() } hx-target="#identities-results" hx-swap="outerHTML" hx-push-url="true">Next</a>
						} else {
							<span class="btn-sm-outline opacity-50" aria-disabled="true">Next</span>
						}
					</div>
				</div>
			}
		</section>
	</div>
}
