package views

import "github.com/open-sspm/open-sspm/internal/http/viewmodels"

templ ConnectedAppsPage(data viewmodels.ConnectedAppsViewData) {
	@Layout(data.Layout) {
		@PageHeader([]Breadcrumb{
			{Label: "Dashboard", Href: "/"},
			{Label: "Google Workspace Connected Apps"},
		}, "Review third-party OAuth apps, grant activity, ownership, and evidence from Google Workspace.") {
		}
		@ConnectedAppsPageResults(data)
	}
}

templ ConnectedAppsPageResults(data viewmodels.ConnectedAppsViewData) {
	<div id="connected-apps-results" class="space-y-6">
		<form
			method="get"
			action="/connected-apps"
			hx-get="/connected-apps"
			hx-trigger="change delay:150ms from:select, submit"
			hx-target="#connected-apps-results"
			hx-swap="outerHTML"
			hx-push-url="true"
			class="space-y-4 border-b border-border/70 pb-5"
		>
			<div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
				<label class="field w-full lg:max-w-xl">
					<span class="sr-only">Query</span>
					<div class="relative">
						<input type="search" name="q" class="input pr-10" placeholder="Search app name or client ID" value={ data.Query }/>
						if data.Query != "" {
							<a class="btn-icon-ghost absolute right-2 top-1/2 -translate-y-1/2" aria-label="Clear query" href={ ConnectedAppsListURL("", data.ReviewState, 1) }>
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
									<path fill-rule="evenodd" d="M4.293 4.293a1 1 0 0 1 1.414 0L10 8.586l4.293-4.293a1 1 0 1 1 1.414 1.414L11.414 10l4.293 4.293a1 1 0 0 1-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 0 1-1.414-1.414L8.586 10 4.293 5.707a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"></path>
								</svg>
							</a>
						}
					</div>
				</label>
				<div class="flex flex-col gap-2 lg:items-end">
					<label class="field">
						<span class="label">Review state</span>
						<select class="select min-w-48" name="review_state">
							<option value="" selected?={ data.ReviewState == "" }>All states</option>
							<option value="needs_revocation" selected?={ data.ReviewState == "needs_revocation" }>Needs revocation</option>
							<option value="under_review" selected?={ data.ReviewState == "under_review" }>Under review</option>
							<option value="unreviewed" selected?={ data.ReviewState == "unreviewed" }>Unreviewed</option>
							<option value="ticketed" selected?={ data.ReviewState == "ticketed" }>Ticketed</option>
							<option value="sanctioned" selected?={ data.ReviewState == "sanctioned" }>Sanctioned</option>
						</select>
					</label>
					<div class="text-sm text-muted-foreground">
						if data.TotalCount > 0 {
							{ "Showing " }{ FormatInt(data.ShowingFrom) }{ "-" }{ FormatInt(data.ShowingTo) }{ " of " }{ FormatInt64(data.TotalCount) }
						} else {
							Showing 0
						}
					</div>
				</div>
			</div>
			<button class="sr-only" type="submit">Apply filters</button>
		</form>

		<section class="space-y-3">
			<div class="flex flex-wrap gap-2">
				for _, item := range data.ReviewCounts {
					<a
						href={ item.Href }
						class={ FilterPillClass(item.IsActive) + " transition-colors duration-150" }
						aria-current={ AriaCurrentBool(item.IsActive) }
					>
						<span>{ item.Label }</span>
						<span class="ml-1 text-muted-foreground">{ FormatInt64(item.Count) }</span>
					</a>
				}
			</div>
		</section>

		<section class="space-y-3">
			<div class="flex items-center gap-3">
				<div>
					<h2 class="text-base font-semibold">Google Workspace Connected Apps</h2>
					<p class="text-sm text-muted-foreground">Directly sourced from OAuth grant inventory and discovery evidence. Review state is operator-managed.</p>
				</div>
			</div>
			if data.HasItems {
				<div class="space-y-3 lg:hidden">
					for _, item := range data.Items {
						<article class="rounded-xl border border-border/70 bg-card/80 p-4 shadow-sm">
							<div class="space-y-3">
								<div class="space-y-1">
									<a class="text-base font-semibold hover:underline" href={ "/connected-apps/" + FormatInt64(item.ID) }>{ item.DisplayName }</a>
									<div class="text-sm text-muted-foreground">{ item.Status }</div>
									<div class="text-xs text-muted-foreground break-all">{ item.ExternalID }</div>
								</div>
								<div class="flex flex-wrap items-center gap-2">
									<span class={ ConnectedAppReviewStateBadgeClass(item.ReviewState) }>{ HumanizeConnectedAppReviewState(item.ReviewState) }</span>
									if item.TicketRef != "" {
										<span class="badge-outline">{ item.TicketRef }</span>
									}
									<span class={ ConnectedAppConfidenceBadgeClass(item.Confidence) }>{ HumanizeConnectedAppConfidence(item.Confidence) }</span>
									<span class={ ConnectedAppFreshnessBadgeClass(item.Freshness) }>{ HumanizeConnectedAppFreshness(item.Freshness) }</span>
								</div>
								<div class="grid gap-3 sm:grid-cols-2">
									<div>
										<p class="text-xs uppercase tracking-wide text-muted-foreground">Owner</p>
										<p class="mt-1 text-sm">{ item.ReviewOwner }</p>
										if item.ReviewOwnerEmail != "" && item.ReviewOwnerEmail != item.ReviewOwner {
											<p class="text-xs text-muted-foreground break-all">{ item.ReviewOwnerEmail }</p>
										}
										<p class="text-xs text-muted-foreground">{ FormatInt(item.LikelyOwnerCount) }{ " likely owner(s)" }</p>
									</div>
									<div>
										<p class="text-xs uppercase tracking-wide text-muted-foreground">Evidence</p>
										<p class="mt-1 text-sm">{ FormatInt(item.GrantCount) }{ " grant(s)" }{ " • " }{ FormatInt64(item.ActorCount) }{ " actor(s)" }</p>
										<p class="text-xs text-muted-foreground">{ FormatInt64(item.DiscoveryEventCount30d) }{ " events in 30d" }</p>
									</div>
								</div>
								<div class="flex items-start justify-between gap-3 border-t border-border/60 pt-3">
									<p class="text-xs text-muted-foreground">{ item.ConfidenceReason }</p>
									<p class="shrink-0 text-xs text-muted-foreground">{ item.LastSeenAt }</p>
								</div>
							</div>
						</article>
					}
				</div>

				<div class="hidden lg:block">
					@ColumnsTable("connected-apps--main", "") {
						<table data-columns-id="connected-apps--main" class="table osspm-table-fixed osspm-table-compact osspm-table-list">
							<caption class="sr-only">Connected apps with review state, ownership, evidence, and freshness.</caption>
							<thead>
								<tr>
									<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Connected app</th>
									<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Review</th>
									<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Owner</th>
									<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Evidence</th>
									<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Confidence</th>
									<th class="osspm-num text-xs font-medium uppercase tracking-wide text-muted-foreground">Last seen</th>
								</tr>
							</thead>
							<tbody>
								for _, item := range data.Items {
									<tr data-row-href={ "/connected-apps/" + FormatInt64(item.ID) } class="cursor-pointer transition-colors duration-150 hover:bg-muted/50">
										<td class="whitespace-normal">
											<a class="btn-sm-link px-0 font-medium" href={ "/connected-apps/" + FormatInt64(item.ID) } title={ item.DisplayName }>{ item.DisplayName }</a>
											<div class="text-sm text-muted-foreground">{ item.Status }</div>
											<div class="text-xs text-muted-foreground break-all">{ item.ExternalID }</div>
										</td>
										<td>
											<div class="flex flex-wrap items-center gap-2">
												<span class={ ConnectedAppReviewStateBadgeClass(item.ReviewState) }>{ HumanizeConnectedAppReviewState(item.ReviewState) }</span>
												if item.TicketRef != "" {
													<span class="badge-outline">{ item.TicketRef }</span>
												}
											</div>
										</td>
										<td>
											<div class="text-sm">{ item.ReviewOwner }</div>
											if item.ReviewOwnerEmail != "" && item.ReviewOwnerEmail != item.ReviewOwner {
												<div class="text-xs text-muted-foreground break-all">{ item.ReviewOwnerEmail }</div>
											}
											<div class="text-xs text-muted-foreground">{ FormatInt(item.LikelyOwnerCount) }{ " likely owner(s)" }</div>
										</td>
										<td class="whitespace-normal">
											<div class="text-sm">{ FormatInt(item.GrantCount) }{ " grant(s)" }{ " • " }{ FormatInt64(item.ActorCount) }{ " actor(s)" }</div>
											<div class="text-xs text-muted-foreground">{ FormatInt64(item.DiscoveryEventCount30d) }{ " events in 30d" }</div>
										</td>
										<td class="whitespace-normal">
											<div class="flex flex-wrap items-center gap-2">
												<span class={ ConnectedAppConfidenceBadgeClass(item.Confidence) }>{ HumanizeConnectedAppConfidence(item.Confidence) }</span>
												<span class={ ConnectedAppFreshnessBadgeClass(item.Freshness) }>{ HumanizeConnectedAppFreshness(item.Freshness) }</span>
											</div>
											<div class="text-xs text-muted-foreground">{ item.ConfidenceReason }</div>
										</td>
										<td class="osspm-num text-muted-foreground">{ item.LastSeenAt }</td>
									</tr>
								}
							</tbody>
						</table>
					}
				</div>
			} else {
				@EmptyState("No connected apps found", data.EmptyStateMsg) {
					if data.Layout.IsAdmin {
						<a class="btn-sm-outline" href="/settings/connectors?open=google_workspace">Configure Google Workspace</a>
					}
				}
			}
			if data.TotalPages > 1 {
				<div class="flex flex-wrap items-center gap-3 border-t py-3">
					<div class="text-sm text-muted-foreground">{ "Page " }{ FormatInt(data.Page) }{ " of " }{ FormatInt(data.TotalPages) }</div>
					<div class="button-group ml-auto">
						if data.Page > 1 {
							<a class="btn-sm-outline" href={ ConnectedAppsListURL(data.Query, data.ReviewState, data.Page-1) }>Previous</a>
						} else {
							<span class="btn-sm-outline opacity-50" aria-disabled="true">Previous</span>
						}
						if data.Page < data.TotalPages {
							<a class="btn-sm-outline" href={ ConnectedAppsListURL(data.Query, data.ReviewState, data.Page+1) }>Next</a>
						} else {
							<span class="btn-sm-outline opacity-50" aria-disabled="true">Next</span>
						}
					</div>
				</div>
			}
		</section>
	</div>
}

templ ConnectedAppShowPage(data viewmodels.ConnectedAppShowViewData) {
	@Layout(data.Layout) {
		@PageHeader([]Breadcrumb{
			{Label: "Dashboard", Href: "/"},
			{Label: "Google Workspace Connected Apps", Href: "/connected-apps"},
			{Label: data.App.DisplayName},
		}, "Review ownership, grant scope, evidence, and containment actions for a connected app.") {
			<a class="btn-sm-outline" href={ data.App.ExportHref }>Export JSON</a>
		}

		@ConnectedAppShowBody(data)
	}
}

templ ConnectedAppShowBody(data viewmodels.ConnectedAppShowViewData) {
	<div id="connected-app-show-shell" class="space-y-6">
		if data.Alert != nil {
			@Alert(data.Alert.Title, data.Alert.Destructive) {
				<p>{ data.Alert.Message }</p>
			}
		}

		<div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_22rem]">
			<div class="space-y-6">
				<article class="card">
					<header>
						<h2>{ data.App.DisplayName }</h2>
						<div data-slot="card-action" class="flex flex-wrap items-center gap-2">
							<span class={ ConnectedAppReviewStateBadgeClass(data.App.ReviewState) }>{ HumanizeConnectedAppReviewState(data.App.ReviewState) }</span>
							<span class={ ConnectedAppConfidenceBadgeClass(data.App.Confidence) }>{ HumanizeConnectedAppConfidence(data.App.Confidence) }</span>
							<span class={ ConnectedAppFreshnessBadgeClass(data.App.Freshness) }>{ HumanizeConnectedAppFreshness(data.App.Freshness) }</span>
						</div>
						<p class="text-sm text-muted-foreground">{ data.App.SourceKind }{ " (" }{ data.App.SourceName }{ ")" }</p>
					</header>
					<section class="space-y-4">
						<div class="grid gap-3 md:grid-cols-3">
							<div>
								<p class="text-xs uppercase tracking-wide text-muted-foreground">Client ID</p>
								<p class="font-medium break-all">{ data.App.ExternalID }</p>
							</div>
							<div>
								<p class="text-xs uppercase tracking-wide text-muted-foreground">Review owner</p>
								<p class="font-medium">{ data.App.ReviewOwner }</p>
								<p class="text-xs text-muted-foreground">{ data.App.ReviewOwnerEmail }</p>
							</div>
							<div>
								<p class="text-xs uppercase tracking-wide text-muted-foreground">Ticket</p>
								if data.App.TicketRef != "" {
									<p class="font-medium">{ data.App.TicketRef }</p>
								} else {
									<p class="font-medium">—</p>
								}
							</div>
							<div>
								<p class="text-xs uppercase tracking-wide text-muted-foreground">Likely owners</p>
								<p class="font-medium">{ FormatInt(data.App.LikelyOwnerCount) }</p>
							</div>
							<div>
								<p class="text-xs uppercase tracking-wide text-muted-foreground">Active grants</p>
								<p class="font-medium">{ FormatInt(data.App.GrantCount) }</p>
							</div>
							<div>
								<p class="text-xs uppercase tracking-wide text-muted-foreground">Actors seen</p>
								<p class="font-medium">{ FormatInt64(data.App.ActorCount) }</p>
							</div>
							<div>
								<p class="text-xs uppercase tracking-wide text-muted-foreground">Discovery sources</p>
								<p class="font-medium">{ FormatInt64(data.App.DiscoverySourceCount) }</p>
							</div>
							<div>
								<p class="text-xs uppercase tracking-wide text-muted-foreground">Discovery events (30d)</p>
								<p class="font-medium">{ FormatInt64(data.App.DiscoveryEventCount30d) }</p>
							</div>
							<div>
								<p class="text-xs uppercase tracking-wide text-muted-foreground">Last evidence</p>
								<p class="font-medium">{ data.App.LastSeenAt }</p>
							</div>
						</div>
						if data.App.Notes != "" {
							<div class="rounded-lg border border-border/70 bg-muted/20 p-4">
								<p class="text-xs uppercase tracking-wide text-muted-foreground">Review notes</p>
								<p class="mt-2 text-sm">{ data.App.Notes }</p>
							</div>
						}
					</section>
				</article>

				<article class="card">
					<header>
						<h2>Grant Inventory</h2>
						<span data-slot="card-action" class="badge-outline">{ FormatInt(len(data.Grants)) }</span>
					</header>
					<section>
						@ColumnsTable("connected-app-show--grants", "") {
							<table data-columns-id="connected-app-show--grants" class="table osspm-table-fixed osspm-table-compact osspm-table-list">
								<thead>
									<tr>
										<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Granted to</th>
										<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Scopes</th>
										<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Status</th>
										<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Last seen</th>
										<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Action</th>
									</tr>
								</thead>
								<tbody>
									if data.HasGrants {
										for _, grant := range data.Grants {
											<tr>
												<td>
													if grant.UserHref != "" {
														<a class="btn-sm-link px-0 font-medium" href={ grant.UserHref }>{ grant.UserLabel }</a>
													} else {
														<div class="font-medium">{ grant.UserLabel }</div>
													}
													<div class="text-xs text-muted-foreground">{ grant.UserEmail }</div>
													<div class="text-xs text-muted-foreground">{ grant.UserExternalID }</div>
												</td>
												<td>
													<div class="text-sm">{ grant.ScopeSummary }</div>
													<div class="text-xs text-muted-foreground">{ FormatInt(grant.ScopeCount) }{ " scope(s)" }</div>
												</td>
												<td>
													<div class="flex flex-wrap items-center gap-2">
														<span class="badge-outline">{ grant.Status }</span>
														<span class={ CredentialRiskBadgeClass(grant.RiskLevel) }>{ HumanizeCredentialRisk(grant.RiskLevel) }</span>
													</div>
												</td>
												<td class="text-muted-foreground">{ grant.LastUsedAt }</td>
												<td>
													if data.Layout.IsAdmin && grant.CanRevoke {
														<form
															method="post"
															action={ "/connected-apps/" + FormatInt64(data.App.ID) + "/grants/" + FormatInt64(grant.CredentialID) + "/revoke" }
															hx-post={ "/connected-apps/" + FormatInt64(data.App.ID) + "/grants/" + FormatInt64(grant.CredentialID) + "/revoke" }
															hx-target="#connected-app-show-shell"
															hx-swap="outerHTML"
															hx-disabled-elt="this"
															class="inline-flex"
														>
															@CSRFInput(data.Layout.CSRFToken)
															<button type="submit" class="btn-sm-outline transition-colors duration-150">Revoke</button>
														</form>
													} else {
														<span class="text-xs text-muted-foreground">Review only</span>
													}
												</td>
											</tr>
										}
									} else {
										<tr>
											<td colspan="5">@EmptyState("No grants", "No active OAuth grants are currently associated with this connected app.")</td>
										</tr>
									}
								</tbody>
							</table>
						}
					</section>
				</article>

				<article class="card">
					<header>
						<h2>Likely Owners</h2>
						<span data-slot="card-action" class="badge-outline">{ FormatInt(len(data.LikelyOwners)) }</span>
					</header>
					<section>
						@ColumnsTable("connected-app-show--owners", "") {
							<table data-columns-id="connected-app-show--owners" class="table osspm-table-fixed osspm-table-compact osspm-table-list">
								<thead>
									<tr>
										<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Owner</th>
										<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Email</th>
										<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Kind</th>
									</tr>
								</thead>
								<tbody>
									if data.HasLikelyOwners {
										for _, owner := range data.LikelyOwners {
											<tr>
												<td>
													if owner.OwnerIdentityHref != "" {
														<a class="btn-sm-link px-0 font-medium" href={ owner.OwnerIdentityHref }>{ owner.OwnerDisplayName }</a>
													} else {
														{ owner.OwnerDisplayName }
													}
												</td>
												<td>{ owner.OwnerEmail }</td>
												<td><span class="badge-outline">{ owner.OwnerKind }</span></td>
											</tr>
										}
									} else {
										<tr>
											<td colspan="3">@EmptyState("No likely owners", "The inventory has not inferred likely owners for this app yet.")</td>
										</tr>
									}
								</tbody>
							</table>
						}
					</section>
				</article>

				<article class="card">
					<header>
						<h2>Discovery Evidence</h2>
						<span data-slot="card-action" class="badge-outline">{ FormatInt(len(data.DiscoverySources)) }</span>
					</header>
					<section>
						@ColumnsTable("connected-app-show--sources", "") {
							<table data-columns-id="connected-app-show--sources" class="table osspm-table-fixed osspm-table-compact osspm-table-list">
								<thead>
									<tr>
										<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">App</th>
										<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Domain</th>
										<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Managed</th>
										<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Risk</th>
										<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Last observed</th>
									</tr>
								</thead>
								<tbody>
									if data.HasEvidence {
										for _, source := range data.DiscoverySources {
											<tr>
												<td>
													<div class="font-medium">{ source.DiscoveryDisplayName }</div>
													<div class="text-xs text-muted-foreground">{ source.CanonicalKey }</div>
												</td>
												<td>
													<div>{ source.Domain }</div>
													<div class="text-xs text-muted-foreground">{ source.VendorName }</div>
												</td>
												<td><span class={ DiscoveryManagedBadgeClass(source.ManagedState) }>{ HumanizeDiscoveryManagedState(source.ManagedState) }</span></td>
												<td><span class={ CredentialRiskBadgeClass(source.RiskLevel) }>{ HumanizeCredentialRisk(source.RiskLevel) }</span></td>
												<td class="text-muted-foreground">{ source.LastObservedAt }</td>
											</tr>
										}
									} else {
										<tr>
											<td colspan="5">@EmptyState("No discovery evidence", "No active discovery source rows are currently linked to this app.")</td>
										</tr>
									}
								</tbody>
							</table>
						}
					</section>
				</article>

				<article class="card">
					<header>
						<h2>Recent Activity</h2>
						<span data-slot="card-action" class="badge-outline">{ FormatInt(len(data.Events)) }</span>
					</header>
					<section>
						@ColumnsTable("connected-app-show--events", "") {
							<table data-columns-id="connected-app-show--events" class="table osspm-table-fixed osspm-table-compact osspm-table-list">
								<thead>
									<tr>
										<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Observed</th>
										<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Signal</th>
										<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Actor</th>
										<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Scopes</th>
									</tr>
								</thead>
								<tbody>
									if data.HasEvents {
										for _, event := range data.Events {
											<tr>
												<td>{ event.ObservedAt }</td>
												<td><span class="badge-outline">{ HumanizeDiscoverySignalKind(event.SignalKind) }</span></td>
												<td>{ event.Actor }</td>
												<td class="text-muted-foreground">{ event.ScopesSummary }</td>
											</tr>
										}
									} else {
										<tr>
											<td colspan="4">@EmptyState("No recent activity", "No recent discovery events are currently associated with this app.")</td>
										</tr>
									}
								</tbody>
							</table>
						}
					</section>
				</article>
			</div>

			<aside class="self-start xl:sticky xl:top-6">
				<article class="card">
					<header>
						<h2>Review</h2>
						<p class="text-sm text-muted-foreground">Assign an accountable owner and capture the current disposition.</p>
					</header>
					<section class="space-y-4">
						if data.Layout.IsAdmin {
							<form
								method="post"
								action={ "/connected-apps/" + FormatInt64(data.App.ID) + "/review" }
								hx-post={ "/connected-apps/" + FormatInt64(data.App.ID) + "/review" }
								hx-target="#connected-app-show-shell"
								hx-swap="outerHTML"
								hx-disabled-elt="this"
								class="space-y-4"
							>
								@CSRFInput(data.Layout.CSRFToken)
								<label class="field">
									<span class="label">Owner email</span>
									<input class="input" type="email" name="owner_email" value={ data.OwnerEmailInput } placeholder="owner@example.com"/>
									<span class="text-xs text-muted-foreground">Must match an existing linked identity email.</span>
								</label>

								<label class="field">
									<span class="label">Disposition</span>
									<select class="select" name="review_state">
										<option value="unreviewed" selected?={ data.ReviewStateInput == "unreviewed" }>Unreviewed</option>
										<option value="under_review" selected?={ data.ReviewStateInput == "under_review" }>Under review</option>
										<option value="sanctioned" selected?={ data.ReviewStateInput == "sanctioned" }>Sanctioned</option>
										<option value="needs_revocation" selected?={ data.ReviewStateInput == "needs_revocation" }>Needs revocation</option>
										<option value="ticketed" selected?={ data.ReviewStateInput == "ticketed" }>Ticketed</option>
									</select>
								</label>

								<label class="field">
									<span class="label">Ticket reference</span>
									<input class="input" type="text" name="ticket_ref" value={ data.TicketRefInput } placeholder="SEC-123"/>
								</label>

								<label class="field">
									<span class="label">Notes</span>
									<textarea class="textarea min-h-32" name="notes" placeholder="Capture rationale, follow-up, or containment context.">{ data.NotesInput }</textarea>
								</label>

								<button type="submit" class="btn-primary w-full transition-colors duration-150">Save review</button>
							</form>
						} else {
							<div class="space-y-3 text-sm">
								<div class="rounded-lg border border-border/70 bg-muted/15 p-4">
									<p class="text-xs uppercase tracking-wide text-muted-foreground">Disposition</p>
									<p class="mt-2 font-medium">{ HumanizeConnectedAppReviewState(data.App.ReviewState) }</p>
								</div>
								<div class="rounded-lg border border-border/70 bg-muted/15 p-4">
									<p class="text-xs uppercase tracking-wide text-muted-foreground">Owner</p>
									<p class="mt-2 font-medium">{ data.App.ReviewOwner }</p>
									<p class="text-xs text-muted-foreground">{ data.App.ReviewOwnerEmail }</p>
								</div>
								<p class="text-xs text-muted-foreground">Review changes require an admin account.</p>
							</div>
						}
					</section>
				</article>
			</aside>
		</div>
	</div>
}
