package views

import "github.com/open-sspm/open-sspm/internal/http/viewmodels"

templ IdentityShowPage(data viewmodels.IdentityShowViewData) {
	@Layout(data.Layout) {
		@PageHeader([]Breadcrumb{
			{Label: "Dashboard", Href: "/"},
			{Label: "Identities", Href: "/identities"},
			{Label: "Identity #" + FormatInt64(data.Identity.ID)},
		}, "")

		<section class="mb-6 border-b border-border pb-5">
			<div class="max-w-4xl space-y-3">
				<div class="space-y-1.5">
					<h1 class="text-2xl font-semibold tracking-tight break-words">{ data.NamePrimary }</h1>
					if data.NameSecondary != "" {
						<p class="text-sm text-muted-foreground break-all">{ data.NameSecondary }</p>
					}
				</div>
				<div class="flex flex-wrap gap-x-4 gap-y-2 text-sm text-muted-foreground">
					if data.Identity.Managed {
						<span>Managed</span>
					} else {
						<span>Unmanaged</span>
					}
					if HumanizeIdentityType(data.Identity.Kind) != "Unknown" {
						<span>{ HumanizeIdentityType(data.Identity.Kind) }</span>
					}
					<span>{ FormatInt64(data.Identity.LinkedAccounts) }{ " linked accounts" }</span>
					<span>{ FormatInt(data.TotalEntitlements) }{ " entitlements" }</span>
				</div>
				<dl class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
					<div class="flex items-baseline gap-2">
						<dt class="text-muted-foreground">Identity ID</dt>
						<dd class="font-medium">{ FormatInt64(data.Identity.ID) }</dd>
					</div>
					<div class="flex items-baseline gap-2">
						<dt class="text-muted-foreground">Created</dt>
						<dd>{ data.CreatedOn }</dd>
					</div>
					<div class="flex items-baseline gap-2">
						<dt class="text-muted-foreground">Updated</dt>
						<dd>{ data.UpdatedOn }</dd>
					</div>
				</dl>
				if data.ProgrammaticAccessHref != "" {
					<a class="btn-sm-link px-0" href={ data.ProgrammaticAccessHref }>Search credentials</a>
				}
			</div>
		</section>

		<section class="space-y-3">
			<div class="flex flex-wrap items-end justify-between gap-3">
				<div class="space-y-1">
					<h2 class="text-base font-semibold">Linked accounts</h2>
					<p class="text-sm text-muted-foreground">Source accounts currently merged into this identity.</p>
				</div>
				<p class="shrink-0 text-sm text-muted-foreground">
					if data.HasLinkedAccounts {
						{ FormatInt64(data.Identity.LinkedAccounts) }{ " total" }
					} else {
						0 total
					}
				</p>
			</div>
			if data.HasLinkedAccounts {
				<div class="border-t border-border">
					<div class="divide-y divide-border lg:hidden">
						for _, linked := range data.LinkedAccounts {
							<article class="py-4">
								<div class="flex items-start justify-between gap-3">
									<div class="min-w-0 space-y-0.5">
										<div class="font-medium">{ HumanizeConnectorKind(linked.Account.SourceKind) }</div>
										if linked.Account.SourceName != "" {
											<div class="text-sm text-muted-foreground break-all">{ ConnectorScopeLabel(linked.Account.SourceKind) }{ ": " }{ linked.Account.SourceName }</div>
										}
									</div>
									if linked.Account.Status != "" {
										<span class={ AccountStatusBadgeClass(linked.Account.Status) }>{ HumanizeAccountStatus(linked.Account.Status) }</span>
									} else {
										<span class="text-sm text-muted-foreground">—</span>
									}
								</div>
								<div class="mt-3 min-w-0 space-y-0.5">
									@IdentityLinkedAccountPrimary(linked)
									if linked.Account.DisplayName != "" {
										<div class="text-sm text-muted-foreground break-words">{ linked.Account.DisplayName }</div>
									}
									if linked.Account.ExternalID != "" && linked.Account.ExternalID != linked.Account.Email {
										<div class="text-xs text-muted-foreground break-all">{ "External ID: " }{ linked.Account.ExternalID }</div>
									}
								</div>
								<div class="mt-3 flex items-center justify-between gap-3 text-sm">
									<div class="flex items-baseline gap-2">
										<span class="text-muted-foreground">Entitlements</span>
										<span class="font-medium">{ FormatInt(linked.EntitlementCount) }</span>
									</div>
									if linked.DetailHref != "" {
										<a class="btn-sm-link px-0" href={ linked.DetailHref }>Open account</a>
									}
								</div>
							</article>
						}
					</div>
					<div class="hidden overflow-x-auto lg:block">
					<table class="table osspm-table-compact osspm-table-list min-w-[54rem]">
						<caption class="sr-only">Linked source accounts merged into this identity.</caption>
						<thead>
							<tr>
								<th class="w-56 text-sm font-medium text-muted-foreground">Source</th>
								<th class="text-sm font-medium text-muted-foreground">Account</th>
								<th class="w-28 text-sm font-medium text-muted-foreground">Status</th>
								<th class="w-24 text-sm font-medium text-muted-foreground">Entitlements</th>
							</tr>
						</thead>
						<tbody>
							for _, linked := range data.LinkedAccounts {
								<tr>
									<td>
										<div class="space-y-0.5">
											<div class="font-medium">{ HumanizeConnectorKind(linked.Account.SourceKind) }</div>
											if linked.Account.SourceName != "" {
												<div class="text-sm text-muted-foreground break-all">{ ConnectorScopeLabel(linked.Account.SourceKind) }{ ": " }{ linked.Account.SourceName }</div>
											}
										</div>
									</td>
									<td>
										<div class="space-y-0.5">
											@IdentityLinkedAccountPrimary(linked)
											if linked.Account.DisplayName != "" {
												<div class="text-sm text-muted-foreground break-words">{ linked.Account.DisplayName }</div>
											}
											if linked.Account.ExternalID != "" && linked.Account.ExternalID != linked.Account.Email {
												<div class="text-xs text-muted-foreground break-all">{ "External ID: " }{ linked.Account.ExternalID }</div>
											}
										</div>
									</td>
									<td>
										if linked.Account.Status != "" {
											<span class={ AccountStatusBadgeClass(linked.Account.Status) }>{ HumanizeAccountStatus(linked.Account.Status) }</span>
										} else {
											<span class="text-muted-foreground">—</span>
										}
									</td>
									<td class="font-medium">{ FormatInt(linked.EntitlementCount) }</td>
								</tr>
							}
						</tbody>
					</table>
					</div>
				</div>
			} else {
				<div class="border-t border-border">
					@EmptyState("No linked accounts", "No linked accounts.")
				</div>
			}
		</section>
	}
}

templ IdentityLinkedAccountPrimary(linked viewmodels.IdentityLinkedAccountView) {
	if linked.Account.Email != "" {
		if linked.DetailHref != "" {
			<a class="btn-sm-link px-0 osspm-cell-primary break-all" href={ linked.DetailHref }>{ linked.Account.Email }</a>
		} else {
			<div class="osspm-cell-primary break-all">{ linked.Account.Email }</div>
		}
	} else if linked.Account.ExternalID != "" {
		if linked.DetailHref != "" {
			<a class="btn-sm-link px-0 osspm-cell-primary break-all" href={ linked.DetailHref }>{ linked.Account.ExternalID }</a>
		} else {
			<div class="osspm-cell-primary break-all">{ linked.Account.ExternalID }</div>
		}
	} else if linked.Account.DisplayName != "" {
		if linked.DetailHref != "" {
			<a class="btn-sm-link px-0 osspm-cell-primary break-words" href={ linked.DetailHref }>{ linked.Account.DisplayName }</a>
		} else {
			<div class="osspm-cell-primary break-words">{ linked.Account.DisplayName }</div>
		}
	} else {
		if linked.DetailHref != "" {
			<a class="btn-sm-link px-0 osspm-cell-primary" href={ linked.DetailHref }>{ "Account " }{ FormatInt64(linked.Account.ID) }</a>
		} else {
			<div class="osspm-cell-primary">{ "Account " }{ FormatInt64(linked.Account.ID) }</div>
		}
	}
}
