package views

import "github.com/open-sspm/open-sspm/internal/http/viewmodels"

templ IdentityShowPage(data viewmodels.IdentityShowViewData) {
	@Layout(data.Layout) {
		@PageHeader("")
		<div class="mx-auto w-full min-w-0 max-w-7xl">
			@identityShowBreadcrumb(data)
			@identityShowHeader(data)
			@IdentityShowSummarySection(data)
			@identityShowGraphFacts(data)
			@IdentityShowEntitlementsSection(data)
			@IdentityShowLinkedAccountsSection(data)
		</div>
	}
}

templ identityShowBreadcrumb(data viewmodels.IdentityShowViewData) {
	<nav class="osspm-breadcrumb min-w-0 overflow-hidden" aria-label="Breadcrumb">
		<a href={ templ.SafeURL(data.Breadcrumb.RootHref) }>{ data.Breadcrumb.RootLabel }</a>
		<span class="osspm-breadcrumb-sep" aria-hidden="true">›</span>
		if data.Breadcrumb.KindLabel != "" {
			if data.Breadcrumb.KindHref != "" {
				<a href={ templ.SafeURL(data.Breadcrumb.KindHref) }>{ data.Breadcrumb.KindLabel }</a>
			} else {
				<span>{ data.Breadcrumb.KindLabel }</span>
			}
			<span class="osspm-breadcrumb-sep" aria-hidden="true">›</span>
		}
		<span class="min-w-0 flex-1 truncate text-foreground" aria-current="page">{ data.Profile.NamePrimary }</span>
	</nav>
}

templ identityShowHeader(data viewmodels.IdentityShowViewData) {
	<section class="osspm-identity-profile">
		<div class="flex min-w-0 flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
			<div class="flex min-w-0 items-start gap-4">
				<div class={ templ.Classes("osspm-avatar-lg shrink-0", data.Profile.AvatarClass) }>{ data.Profile.Initials }</div>
				<div class="min-w-0 space-y-2">
					<div class="flex flex-wrap items-center gap-2">
						<h1 class="text-2xl font-semibold tracking-tight break-words">{ data.Profile.NamePrimary }</h1>
						if data.Profile.StatusTone == "active" && data.Profile.StatusLabel != "" {
							<span class="badge bg-emerald-100 text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-100">
								<span class="mr-1 inline-block size-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
								{ data.Profile.StatusLabel }
							</span>
						} else if data.Profile.StatusTone == "warn" && data.Profile.StatusLabel != "" {
							<span class="badge bg-amber-100 text-amber-800 dark:bg-amber-900/50 dark:text-amber-100">
								<span class="mr-1 inline-block size-1.5 rounded-full bg-amber-500" aria-hidden="true"></span>
								{ data.Profile.StatusLabel }
							</span>
						}
					</div>
					if data.Profile.NameSecondary != "" {
						<p class="text-sm text-muted-foreground break-all">{ data.Profile.NameSecondary }</p>
					}
					<div class="flex flex-wrap items-center gap-2 pt-1">
						<span class="badge-outline">{ HumanizeIdentityAnchorState(data.Profile.Identity.AnchorState) }</span>
						if data.Profile.IdentityTypeLabel != "" && data.Profile.IdentityTypeLabel != "Unknown" {
							<span class="badge-outline">{ data.Profile.IdentityTypeLabel }</span>
						}
						for _, tag := range data.Profile.Tags {
							<span class="badge-outline">{ tag }</span>
						}
							if data.Profile.AdminScopeSummary != "" {
								<span class="badge bg-rose-100 text-rose-800 dark:bg-rose-900/50 dark:text-rose-100" hx-disable>{ "Admin · " }{ data.Profile.AdminScopeSummary }</span>
							}
						<span class="osspm-id-pill">{ "ID " }{ FormatInt64(data.Profile.Identity.ID) }</span>
						if data.Profile.NonHumanIdentitiesHref != "" {
							<a class="btn-sm-link px-0" href={ templ.SafeURL(data.Profile.NonHumanIdentitiesHref) }>Search non-human identities</a>
						}
					</div>
				</div>
			</div>
			if data.Profile.ReviewSummary.Label != "" {
				@identityReviewSummary(data.Profile.ReviewSummary)
			}
		</div>
		if len(data.Profile.Facts) > 0 {
			<dl class="mt-5 grid grid-cols-2 gap-x-8 gap-y-3 border-t border-border/50 pt-4 text-sm sm:grid-cols-3 lg:grid-cols-6">
				for _, fact := range data.Profile.Facts {
					<div class="space-y-0.5">
						<dt class="text-xs uppercase tracking-wide text-muted-foreground">{ fact.Label }</dt>
						<dd class="font-medium">{ fact.Value }</dd>
					</div>
				}
			</dl>
		}
	</section>
}

templ identityReviewSummary(summary viewmodels.IdentityReviewSummary) {
	<div class={ templ.Classes("osspm-review-verdict", templ.KV("osspm-review-verdict-ok", summary.Tone == "ok"), templ.KV("osspm-review-verdict-warn", summary.Tone == "warn"), templ.KV("osspm-review-verdict-danger", summary.Tone == "danger")) }>
		<span class="osspm-review-verdict-dot" aria-hidden="true"></span>
		<div class="min-w-0">
			<div class="osspm-review-verdict-label">{ summary.Label }</div>
			if summary.Detail != "" {
				<div class="osspm-review-verdict-detail">{ summary.Detail }</div>
			}
		</div>
	</div>
}

templ IdentityShowSummarySection(data viewmodels.IdentityShowViewData) {
	<section id="identity-summary-section" class="osspm-summary-tiles">
		if len(data.Summary.Tiles) > 0 {
			for _, tile := range data.Summary.Tiles {
				@identitySummaryTile(tile)
			}
		} else {
			<div class="osspm-summary-tile">
				<div class="osspm-summary-tile-label">Source accounts</div>
				<div class="osspm-summary-tile-value text-muted-foreground">0</div>
				<div class="osspm-summary-tile-sublabel">No linked accounts</div>
			</div>
		}
	</section>
}

templ identitySummaryTile(tile viewmodels.IdentitySummaryTile) {
	<div class="osspm-summary-tile">
		<div class="osspm-summary-tile-label">{ tile.Label }</div>
		<div class={ templ.Classes("osspm-summary-tile-value", templ.KV("osspm-summary-tile-value-danger", tile.Danger), templ.KV("osspm-summary-tile-value-warn", tile.Warn)) }>{ tile.Value }</div>
		if tile.Sublabel != "" {
			<div class="osspm-summary-tile-sublabel">{ tile.Sublabel }</div>
		}
	</div>
}

templ identityShowGraphFacts(data viewmodels.IdentityShowViewData) {
	if data.GraphFacts.HasEmails || data.GraphFacts.HasAnchors {
		<section class="osspm-data-section">
			<div class="osspm-data-section-header">
				<div class="space-y-1">
					<h2 class="text-base font-semibold">Identity graph facts</h2>
					<p class="text-sm text-muted-foreground">Emails and deterministic anchors used by resolution.</p>
				</div>
			</div>
			<div class="grid gap-4 lg:grid-cols-2">
				<section class="rounded-md border border-border/70">
					<div class="border-b border-border/70 px-4 py-3">
						<h3 class="text-sm font-semibold">{ "Emails " }<span class="font-normal text-muted-foreground">{ FormatInt(len(data.GraphFacts.Emails)) }</span></h3>
					</div>
					if data.GraphFacts.HasEmails {
						<div class="divide-y divide-border/70">
							for _, email := range data.GraphFacts.Emails {
								<div class="px-4 py-3">
									<div class="flex min-w-0 items-start justify-between gap-3">
										<div class="min-w-0">
											<div class="truncate font-medium" hx-disable>{ email.Email }</div>
											if email.NormalizedEmail != "" && email.NormalizedEmail != email.Email {
												<div class="truncate text-xs text-muted-foreground" hx-disable>{ email.NormalizedEmail }</div>
											}
										</div>
										if email.IsPrimary {
											<span class="badge bg-sky-100 text-sky-800 dark:bg-sky-900/50 dark:text-sky-100">Primary</span>
										}
									</div>
									<div class="mt-2 flex flex-wrap gap-2">
										<span class="badge-outline">{ HumanizeIdentityResolutionToken(email.EmailKind) }</span>
										<span class="badge-outline">{ HumanizeIdentityResolutionToken(email.VerificationState) }</span>
										<span class="badge-outline">{ HumanizeIdentityResolutionToken(email.LifecycleState) }</span>
									</div>
									if email.SourceKind != "" || email.LastSeen.Label != "" {
										<div class="mt-2 text-xs text-muted-foreground">
											if email.SourceKind != "" {
												<span>{ HumanizeConnectorKind(email.SourceKind) }</span>
												if email.SourceName != "" {
														<span hx-disable>{ " / " }{ email.SourceName }</span>
												}
											}
											if email.LastSeen.Label != "" {
												<span>{ " · last seen " }{ email.LastSeen.Label }</span>
											}
										</div>
									}
								</div>
							}
						</div>
					} else {
						@EmptyState("No emails", "No identity emails have been recorded.")
					}
				</section>
				<section class="rounded-md border border-border/70">
					<div class="border-b border-border/70 px-4 py-3">
						<h3 class="text-sm font-semibold">{ "Anchors " }<span class="font-normal text-muted-foreground">{ FormatInt(len(data.GraphFacts.Anchors)) }</span></h3>
					</div>
					if data.GraphFacts.HasAnchors {
						<div class="divide-y divide-border/70">
							for _, anchor := range data.GraphFacts.Anchors {
								<div class="px-4 py-3">
									<div class="min-w-0">
										<div class="truncate font-medium">{ HumanizeIdentityResolutionToken(anchor.AnchorKind) }</div>
										<div class="truncate text-xs text-muted-foreground" hx-disable>{ anchor.Issuer }</div>
										<div class="mt-1 break-all font-mono text-xs" hx-disable>{ anchor.NormalizedAnchorValue }</div>
									</div>
									<div class="mt-2 flex flex-wrap gap-2">
										<span class="badge-outline">{ HumanizeIdentityResolutionToken(anchor.TrustLevel) }</span>
										<span class="badge-outline">{ HumanizeIdentityResolutionToken(anchor.LifecycleState) }</span>
									</div>
									if anchor.SourceKind != "" || anchor.LastSeen.Label != "" {
										<div class="mt-2 text-xs text-muted-foreground">
											if anchor.SourceKind != "" {
												<span>{ HumanizeConnectorKind(anchor.SourceKind) }</span>
												if anchor.SourceName != "" {
													<span hx-disable>{ " / " }{ anchor.SourceName }</span>
												}
											}
											if anchor.LastSeen.Label != "" {
												<span>{ " · last seen " }{ anchor.LastSeen.Label }</span>
											}
										</div>
									}
								</div>
							}
						</div>
					} else {
						@EmptyState("No anchors", "No deterministic anchors have been accepted.")
					}
				</section>
			</div>
		</section>
	}
}

templ IdentityShowLinkedAccountsSection(data viewmodels.IdentityShowViewData) {
	if !data.LinkedAccounts.Loaded {
		<section id="identity-linked-accounts-section" class="osspm-data-section" hx-get={ data.LinkedAccounts.LoadHref } hx-trigger="intersect once, oss-panel-visible" hx-target="this" hx-swap="outerHTML" hx-sync="this:drop" hx-request='{"timeout":15000}' data-hx-lazy-load data-hx-lazy-panel="identity-linked-accounts-section">
			@identitySectionLoading("identity-linked-accounts-section", "Source accounts", data.LinkedAccounts.LoadHref)
		</section>
	} else {
	<section id="identity-linked-accounts-section" class="osspm-data-section">
		<div class="osspm-data-section-header">
			<div class="space-y-1">
				<h2 class="text-base font-semibold">{ "Source accounts " }<span class="text-sm font-normal text-muted-foreground">{ FormatInt(data.LinkedAccounts.Total) }{ " total" }</span></h2>
				if data.LinkedAccounts.HasFilter {
					<p class="text-sm text-muted-foreground">{ FormatInt(data.LinkedAccounts.Visible) }{ " shown" }</p>
				}
			</div>
			if data.LinkedAccounts.Total > 0 {
				<div class="flex flex-wrap items-center gap-3">
					<span class="text-sm text-muted-foreground">
						<span class="mr-1 inline-block size-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
						{ FormatInt(data.LinkedAccounts.Active) }{ " active" }
					</span>
					<span class="text-sm text-muted-foreground">
						{ "· " }{ FormatInt(data.LinkedAccounts.Dormant) }{ " dormant" }
					</span>
				</div>
			}
		</div>
		if data.LinkedAccounts.Total > 1 || data.LinkedAccounts.HasFilter {
			@identityLinkedAccountsToolbar(data)
		}
		if data.LinkedAccounts.HasItems {
			if data.LinkedAccounts.Total == 1 && !data.LinkedAccounts.HasFilter {
				for _, linked := range data.LinkedAccounts.Items {
					@identitySingleLinkedAccount(linked)
				}
			}
			if data.LinkedAccounts.Total != 1 || data.LinkedAccounts.HasFilter {
				<div class="divide-y divide-border border-t border-border lg:hidden">
				for _, linked := range data.LinkedAccounts.Items {
					<article class="py-4">
						<div class="flex items-start gap-3">
							@ProductIcon(linked.Account.SourceKind, "", "", "h-7 w-7 rounded-md shrink-0")
							<div class="min-w-0 flex-1 space-y-0.5">
								<div class="font-medium">{ HumanizeConnectorKind(linked.Account.SourceKind) }</div>
									if linked.Account.SourceName != "" {
										<div class="text-sm text-muted-foreground break-all" hx-disable>{ ConnectorScopeLabel(linked.Account.SourceKind) }{ ": " }{ linked.Account.SourceName }</div>
									}
								</div>
							if linked.Account.Status != "" {
								<span class={ AccountStatusBadgeClass(linked.Account.Status) }>{ HumanizeAccountStatus(linked.Account.Status) }</span>
							}
						</div>
						<div class="mt-3 space-y-1">
							@IdentityLinkedAccountPrimary(linked)
							if linked.Account.ExternalID != "" && linked.Account.ExternalID != linked.Account.Email {
								<div class="text-xs text-muted-foreground break-all font-mono" hx-disable>{ linked.Account.ExternalID }</div>
							}
						</div>
						<div class="mt-3 flex items-center justify-between gap-3 text-sm">
							<div class="flex items-baseline gap-2">
								<span class="text-muted-foreground">Grants</span>
								<span class="font-medium">{ FormatInt(linked.EntitlementCount) }</span>
							</div>
							<div class="flex items-baseline gap-2">
								<span class="text-muted-foreground">Last sign-in</span>
								<span class={ templ.Classes("font-medium", templ.KV("text-amber-700 dark:text-amber-400", linked.Dormant)) }>{ linked.LastSignIn.Label }</span>
							</div>
							if linked.DetailHref != "" {
								<a class="btn-sm-link px-0" href={ templ.SafeURL(linked.DetailHref) }>Open account</a>
							}
						</div>
					</article>
				}
			</div>
				<div class="osspm-data-table-wrap hidden lg:block">
				<table class="table osspm-table-compact osspm-table-list osspm-identity-linked-table">
					<caption class="sr-only">Linked source accounts merged into this identity.</caption>
					<colgroup>
						<col class="w-[28%]"/>
						<col class="w-[34%]"/>
						<col class="w-[10%]"/>
						<col class="w-[10%]"/>
						<col class="w-[18%]"/>
					</colgroup>
					<thead>
						<tr>
							<th class="text-xs uppercase tracking-wide font-medium text-muted-foreground">Source</th>
							<th class="text-xs uppercase tracking-wide font-medium text-muted-foreground">External ID</th>
							<th class="text-xs uppercase tracking-wide font-medium text-muted-foreground">Status</th>
							<th class="text-xs uppercase tracking-wide font-medium text-muted-foreground">Grants</th>
							<th class="text-xs uppercase tracking-wide font-medium text-muted-foreground">Last sign-in</th>
						</tr>
					</thead>
					<tbody>
						for _, linked := range data.LinkedAccounts.Items {
							<tr>
								<td>
									<div class="flex items-center gap-3">
										@ProductIcon(linked.Account.SourceKind, "", "", "h-7 w-7 rounded-md shrink-0")
										<div class="min-w-0 space-y-0.5">
											<div class="font-medium">{ HumanizeConnectorKind(linked.Account.SourceKind) }</div>
											if linked.Account.SourceName != "" {
												<div class="truncate text-sm text-muted-foreground" title={ ConnectorScopeLabel(linked.Account.SourceKind) + ": " + linked.Account.SourceName } hx-disable>{ ConnectorScopeLabel(linked.Account.SourceKind) }{ ": " }{ linked.Account.SourceName }</div>
											}
										</div>
									</div>
								</td>
								<td>
									if linked.Account.ExternalID != "" {
										<div class="flex min-w-0 items-center gap-2">
											if linked.DetailHref != "" {
												<a class="btn-sm-link min-w-0 px-0 font-mono text-xs break-all" href={ templ.SafeURL(linked.DetailHref) }>{ linked.Account.ExternalID }</a>
											} else {
												<span class="min-w-0 font-mono text-xs break-all" hx-disable>{ linked.Account.ExternalID }</span>
											}
											@CopyTextButton(linked.Account.ExternalID, "Copy external ID")
										</div>
									} else {
										<span class="text-muted-foreground/60">—</span>
									}
								</td>
								<td>
									if linked.Account.Status != "" {
										<span class={ AccountStatusBadgeClass(linked.Account.Status) }>{ HumanizeAccountStatus(linked.Account.Status) }</span>
									} else {
										<span class="text-muted-foreground/60">—</span>
									}
								</td>
								<td class="font-medium tabular-nums">{ FormatInt(linked.EntitlementCount) }</td>
								<td class={ templ.Classes("text-muted-foreground", templ.KV("text-amber-700 dark:text-amber-400", linked.Dormant), templ.KV("text-muted-foreground/60", !linked.Dormant && (linked.LastSignIn.Label == "—" || linked.LastSignIn.Label == ""))) }>{ linked.LastSignIn.Label }</td>
							</tr>
						}
					</tbody>
				</table>
				</div>
			}
		} else {
			<div class="border-t border-border">
				if data.LinkedAccounts.HasFilter {
					@EmptyState("No linked accounts match", "Clear the account search to show all linked accounts.")
				} else {
					@EmptyState("No linked accounts", "No linked accounts.")
				}
			</div>
		}
	</section>
	}
}

templ identitySectionLoading(sectionID string, title string, retryHref string) {
	<div class="osspm-data-section-header">
		<div class="space-y-1">
			<h2 class="text-base font-semibold">{ title }</h2>
			<p class="text-sm text-muted-foreground">Loading...</p>
		</div>
	</div>
	<div class="border-t border-border/60 py-6">
		@BusyInlineIndicator("Loading...", true)
	</div>
	<template data-hx-lazy-error-template>
		@IdentityShowLazySectionError(sectionID, title, retryHref, "We couldn't load this section. Check your connection and try again.", "")
	</template>
}

templ IdentityShowLazySectionError(sectionID string, title string, retryHref string, description string, reference string) {
	<section id={ sectionID } class="osspm-data-section" data-hx-lazy-load data-hx-lazy-panel={ sectionID } data-hx-lazy-error role="alert">
		<div class="osspm-data-section-header">
			<div class="space-y-1">
				<h2 class="text-base font-semibold">{ title }</h2>
				<p class="text-sm text-destructive" data-hx-lazy-error-description>{ description }</p>
				if reference != "" {
					<p class="text-xs text-muted-foreground">{ "Reference: " }<span class="font-mono" hx-disable>{ reference }</span></p>
				}
			</div>
			<a
				class="btn-sm-outline shrink-0"
				href={ templ.SafeURL(retryHref) }
				hx-get={ retryHref }
				hx-target="closest section"
				hx-swap="outerHTML"
				hx-sync="closest section:drop"
				hx-request='{"timeout":15000}'
				data-hx-lazy-retry
			>
				@IconRefreshCw("size-4")
				<span>Retry</span>
			</a>
		</div>
	</section>
}

templ identitySingleLinkedAccount(linked viewmodels.IdentityLinkedAccountView) {
	<article class="osspm-source-account-strip">
		<div class="flex min-w-0 items-start gap-3">
			@ProductIcon(linked.Account.SourceKind, "", "", "h-8 w-8 rounded-md shrink-0")
			<div class="min-w-0 flex-1">
				<div class="flex flex-wrap items-center gap-2">
					<h3 class="text-sm font-semibold">{ HumanizeConnectorKind(linked.Account.SourceKind) }</h3>
					if linked.Account.Status != "" {
						<span class={ AccountStatusBadgeClass(linked.Account.Status) }>{ HumanizeAccountStatus(linked.Account.Status) }</span>
					}
				</div>
				if linked.Account.SourceName != "" {
					<p class="mt-0.5 text-sm text-muted-foreground break-all" hx-disable>{ ConnectorScopeLabel(linked.Account.SourceKind) }{ ": " }{ linked.Account.SourceName }</p>
				}
				<div class="mt-3 min-w-0">
					@IdentityLinkedAccountPrimary(linked)
					if linked.Account.ExternalID != "" && linked.Account.ExternalID != linked.Account.Email {
						<div class="mt-1 flex min-w-0 items-center gap-2">
							<span class="min-w-0 truncate font-mono text-xs text-muted-foreground" title={ linked.Account.ExternalID } hx-disable>{ linked.Account.ExternalID }</span>
							@CopyTextButton(linked.Account.ExternalID, "Copy external ID")
						</div>
					}
				</div>
			</div>
		</div>
		<div class="osspm-source-account-strip-facts">
			<div>
				<span>Grants</span>
				<strong>{ FormatInt(linked.EntitlementCount) }</strong>
			</div>
			<div>
				<span>Last sign-in</span>
				<strong class={ templ.Classes(templ.KV("text-amber-700 dark:text-amber-400", linked.Dormant), templ.KV("text-muted-foreground", !linked.Dormant)) }>{ linked.LastSignIn.Label }</strong>
			</div>
			if linked.DetailHref != "" {
				<a class="btn-sm-outline" href={ templ.SafeURL(linked.DetailHref) }>
					@IconExternalLink("size-3.5")
					Open account
				</a>
			}
		</div>
	</article>
}

templ identityLinkedAccountsToolbar(data viewmodels.IdentityShowViewData) {
	<form
		method="get"
		action={ "/identities/" + FormatInt64(data.Profile.Identity.ID) }
		hx-get={ "/identities/" + FormatInt64(data.Profile.Identity.ID) }
		hx-target="#identity-linked-accounts-section"
		hx-push-url="true"
		hx-sync="this:replace"
		class="osspm-data-toolbar"
	>
		if data.Entitlements.Query != "" {
			<input type="hidden" name="entitlement_q" value={ data.Entitlements.Query }/>
		}
		if data.Entitlements.AdminOnly {
			<input type="hidden" name="admin" value="1"/>
		}
		if data.Entitlements.DormantOnly {
			<input type="hidden" name="dormant" value="1"/>
		}
		if data.Entitlements.SourceFilter != "" {
			<input type="hidden" name="source_kind" value={ data.Entitlements.SourceFilter }/>
		}
		<label class="relative block min-w-[16rem] flex-1 sm:max-w-md">
			<span class="sr-only">Search source accounts</span>
			<span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground">
				@IconSearch("size-4")
			</span>
			<input
				type="search"
				name="account_q"
				value={ data.LinkedAccounts.Query }
				placeholder="Search accounts..."
				aria-label="Search source accounts"
				class="input pl-9 pr-10"
			/>
			if data.LinkedAccounts.Query != "" {
				<a class="btn-sm-icon-ghost absolute right-1 top-1/2 -translate-y-1/2" href={ templ.SafeURL(data.LinkedAccounts.QueryClearHref) } hx-get={ data.LinkedAccounts.QueryClearHref } hx-target="#identity-linked-accounts-section" hx-swap="outerHTML show:top" hx-push-url="true" aria-label="Clear account search">
					@IconX("size-4")
				</a>
			}
		</label>
		<button type="submit" class="sr-only">Search accounts</button>
		<label class="ml-auto flex items-center gap-2 text-sm text-muted-foreground">
			<span>Sort:</span>
			<select class="select" name="account_sort" data-autosubmit>
				<option value="grants" selected?={ data.LinkedAccounts.SortMode == viewmodels.IdentityLinkedAccountSortGrants }>Grants</option>
				<option value="source" selected?={ data.LinkedAccounts.SortMode == viewmodels.IdentityLinkedAccountSortSource }>Source</option>
				<option value="activity" selected?={ data.LinkedAccounts.SortMode == viewmodels.IdentityLinkedAccountSortActivity }>Last sign-in</option>
			</select>
		</label>
	</form>
}

templ IdentityShowEntitlementsSection(data viewmodels.IdentityShowViewData) {
	if !data.Entitlements.Loaded {
		<section id="identity-entitlements-section" class="osspm-data-section" hx-get={ data.Entitlements.LoadHref } hx-trigger="intersect once, oss-panel-visible" hx-target="this" hx-swap="outerHTML" hx-sync="this:drop" hx-request='{"timeout":15000}' data-hx-lazy-load data-hx-lazy-panel="identity-entitlements-section">
			@identitySectionLoading("identity-entitlements-section", "Access grants", data.Entitlements.LoadHref)
		</section>
	} else {
	<section id="identity-entitlements-section" class="osspm-data-section">
		<div class="space-y-4">
			<div class="osspm-data-section-header pb-0">
				<div class="space-y-1">
					<h2 class="text-base font-semibold">{ "Access grants " }<span class="text-sm font-normal text-muted-foreground">{ FormatInt(data.Entitlements.Total) }{ " total" }</span></h2>
					if data.Entitlements.HasFilter {
						<p class="text-sm text-muted-foreground">{ FormatInt(data.Entitlements.Visible) }{ " shown" }</p>
					}
				</div>
			</div>
			if data.Entitlements.Total > 0 || data.Entitlements.HasFilter {
				@identityEntitlementsToolbar(data)
				@identityEntitlementFilterChips(data)
			}
		</div>
		if data.Entitlements.HasItems {
			<div class="osspm-entitlement-groups">
				for _, group := range data.Entitlements.Groups {
					@identityEntitlementGroup(data, group)
				}
			</div>
		} else {
			<div class="border-t border-border/60">
				if data.Entitlements.HasFilter {
					@EmptyState("No entitlements match", "Adjust search or filters to show more grants.")
				} else {
					@EmptyState("No entitlements", "No entitlements found for linked accounts.")
				}
			</div>
		}
	</section>
	}
}

templ identityEntitlementsToolbar(data viewmodels.IdentityShowViewData) {
	<form
		method="get"
		action={ "/identities/" + FormatInt64(data.Profile.Identity.ID) }
		hx-get={ "/identities/" + FormatInt64(data.Profile.Identity.ID) }
		hx-target="#identity-entitlements-section"
		hx-push-url="true"
		hx-sync="this:replace"
		class="osspm-data-toolbar"
	>
		for _, hidden := range data.Entitlements.FormHiddenInputs {
			<input type="hidden" name={ hidden.Name } value={ hidden.Value }/>
		}
		<label class="relative block min-w-[16rem] flex-1 sm:max-w-md">
			<span class="sr-only">Search access grants</span>
			<span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground">
				@IconSearch("size-4")
			</span>
			<input
				type="search"
				name="entitlement_q"
				value={ data.Entitlements.Query }
				class="input pl-9 pr-10"
				placeholder="Search entitlements..."
				aria-label="Search access grants"
			/>
			if data.Entitlements.Query != "" {
				<a class="btn-sm-icon-ghost absolute right-1 top-1/2 -translate-y-1/2" href={ templ.SafeURL(data.Entitlements.QueryClearHref) } hx-get={ data.Entitlements.QueryClearHref } hx-target="#identity-entitlements-section" hx-swap="outerHTML show:top" hx-push-url="true" aria-label="Clear entitlement search">
					@IconX("size-4")
				</a>
			}
		</label>
		<button type="submit" class="sr-only">Search entitlements</button>
		@FilterPopover("Filters", data.Entitlements.FilterCount, false, "left-auto right-0 w-[min(92vw,20rem)] space-y-3") {
			<label class="flex items-center gap-2 text-sm">
				<input class="input" type="checkbox" name="admin" value="1" checked?={ data.Entitlements.AdminOnly } data-autosubmit/>
				<span>Admin only</span>
			</label>
			<label class="flex items-center gap-2 text-sm">
				<input class="input" type="checkbox" name="dormant" value="1" checked?={ data.Entitlements.DormantOnly } data-autosubmit/>
				<span>On dormant accounts</span>
			</label>
			if len(data.Entitlements.SourceOptions) > 0 {
				<label class="field">
					<span class="label">Source</span>
					<select class="select" name="source_kind" data-autosubmit>
						<option value="" selected?={ data.Entitlements.SourceFilter == "" }>All sources</option>
						for _, opt := range data.Entitlements.SourceOptions {
							<option value={ opt.Value } selected?={ opt.Selected }>{ opt.Label }</option>
						}
					</select>
				</label>
			}
			<div class="flex items-center justify-between gap-2 border-t border-border/60 pt-3">
				if data.Entitlements.FilterCount > 0 {
					<a class="text-xs text-muted-foreground hover:text-foreground" href={ templ.SafeURL(data.Entitlements.ClearFiltersHref) } hx-get={ data.Entitlements.ClearFiltersHref } hx-target="#identity-entitlements-section" hx-swap="outerHTML show:top" hx-push-url="true">Clear filters</a>
				} else {
					<span></span>
				}
				<button type="submit" class="btn-sm">Apply filters</button>
			</div>
		}
	</form>
}

templ identityEntitlementFilterChips(data viewmodels.IdentityShowViewData) {
	if len(data.Entitlements.FilterChips) > 0 {
		<div class="osspm-active-filter-chips" aria-label="Active access grant filters">
			for _, chip := range data.Entitlements.FilterChips {
				<a class="osspm-active-filter-chip" href={ templ.SafeURL(chip.ClearHref) } hx-get={ chip.ClearHref } hx-target="#identity-entitlements-section" hx-swap="outerHTML show:top" hx-push-url="true">
					<span>{ chip.Label }</span>
					@IconX("size-3")
				</a>
			}
			if len(data.Entitlements.FilterChips) > 1 {
				<a class="osspm-active-filter-clear" href={ templ.SafeURL(data.Entitlements.ClearFiltersHref) } hx-get={ data.Entitlements.ClearFiltersHref } hx-target="#identity-entitlements-section" hx-swap="outerHTML show:top" hx-push-url="true">Clear all</a>
			}
		</div>
	}
}

templ identityEntitlementGroup(data viewmodels.IdentityShowViewData, group viewmodels.IdentityEntitlementGroup) {
	<section class="osspm-entitlement-group">
		<header class="osspm-entitlement-group-header">
			if group.SourceKind != "" {
				@ProductIcon(group.SourceKind, "", "", "h-5 w-5 rounded shrink-0")
			}
			<div class="min-w-0 flex-1">
				if group.TitleHref != "" {
					<a class="osspm-entitlement-group-header-title break-words" href={ templ.SafeURL(group.TitleHref) }>{ group.Title }</a>
				} else {
					<span class="osspm-entitlement-group-header-title break-words">{ group.Title }</span>
				}
				if group.Subtitle != "" {
					<span class="osspm-entitlement-group-header-subtitle">{ group.Subtitle }</span>
				}
			</div>
			if group.Count > 1 {
				<span class="osspm-entitlement-group-header-count" aria-label={ FormatInt(group.Count) + " entitlements" }>{ FormatInt(group.Count) }</span>
			}
		</header>
		@identityEntitlementRows(data, group.PreviewItems)
		if group.OverflowCount > 0 {
			<details class="osspm-entitlement-more">
				<summary>{ "Show " }{ FormatInt(group.OverflowCount) }{ " more" }</summary>
				@identityEntitlementRows(data, group.OverflowItems)
			</details>
		}
	</section>
}

templ identityEntitlementRows(data viewmodels.IdentityShowViewData, items []viewmodels.IdentityEntitlementView) {
	<ul class="osspm-entitlement-rows" role="list">
		for _, ent := range items {
			<li class="osspm-entitlement-row">
				<div class="osspm-entitlement-row-main">
					@identityPermissionBadge(ent)
					<div class="min-w-0">
						if data.LinkedAccounts.Total > 1 {
							<div class="osspm-entitlement-row-account">
								if ent.AccountHref != "" {
									<a href={ templ.SafeURL(ent.AccountHref) }>{ ent.AccountLabel }</a>
								} else {
									<span>{ ent.AccountLabel }</span>
								}
							</div>
						}
						<div class="osspm-entitlement-row-meta">
							if ent.AccountSourceKind != "" {
								<span>{ HumanizeConnectorKind(ent.AccountSourceKind) }</span>
							}
								if data.LinkedAccounts.Total > 1 && ent.AccountSourceName != "" {
									<span hx-disable>{ ConnectorScopeLabel(ent.AccountSourceKind) }{ ": " }{ ent.AccountSourceName }</span>
								}
						</div>
					</div>
				</div>
				<span title={ ent.AccountLastSignIn.Title } class={ templ.Classes("osspm-entitlement-row-time", templ.KV("text-amber-700 dark:text-amber-400", ent.Dormant), templ.KV("text-muted-foreground/60", !ent.Dormant && (ent.AccountLastSignIn.Label == "—" || ent.AccountLastSignIn.Label == ""))) }>{ "Account sign-in " }{ ent.AccountLastSignIn.Label }</span>
			</li>
		}
	</ul>
}

templ identityPermissionBadge(ent viewmodels.IdentityEntitlementView) {
	if ent.Permission == "" {
		<span class="text-muted-foreground/60">—</span>
	} else if ent.IsAdmin {
		<span class="badge bg-rose-100 text-rose-800 dark:bg-rose-900/50 dark:text-rose-100">{ ent.Permission }</span>
	} else {
		<span class="badge-outline">{ ent.Permission }</span>
	}
}

templ IdentityLinkedAccountPrimary(linked viewmodels.IdentityLinkedAccountView) {
	if linked.Account.Email != "" {
		if linked.DetailHref != "" {
			<a class="btn-sm-link px-0 osspm-cell-primary break-all" href={ templ.SafeURL(linked.DetailHref) }>{ linked.Account.Email }</a>
		} else {
				<div class="osspm-cell-primary break-all" hx-disable>{ linked.Account.Email }</div>
		}
	} else if linked.Account.ExternalID != "" {
		if linked.DetailHref != "" {
			<a class="btn-sm-link px-0 osspm-cell-primary break-all" href={ templ.SafeURL(linked.DetailHref) }>{ linked.Account.ExternalID }</a>
		} else {
				<div class="osspm-cell-primary break-all" hx-disable>{ linked.Account.ExternalID }</div>
		}
	} else if linked.Account.DisplayName != "" {
		if linked.DetailHref != "" {
			<a class="btn-sm-link px-0 osspm-cell-primary break-words" href={ templ.SafeURL(linked.DetailHref) }>{ linked.Account.DisplayName }</a>
		} else {
				<div class="osspm-cell-primary break-words" hx-disable>{ linked.Account.DisplayName }</div>
		}
	} else {
		if linked.DetailHref != "" {
			<a class="btn-sm-link px-0 osspm-cell-primary" href={ templ.SafeURL(linked.DetailHref) }>{ "Account " }{ FormatInt64(linked.Account.ID) }</a>
		} else {
			<div class="osspm-cell-primary">{ "Account " }{ FormatInt64(linked.Account.ID) }</div>
		}
	}
}
