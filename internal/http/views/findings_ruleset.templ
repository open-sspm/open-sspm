package views

import (
	"strings"

	"github.com/open-sspm/open-sspm/internal/http/viewmodels"
)

templ FindingsRulesetPage(data viewmodels.FindingsRulesetViewData) {
	@Layout(data.Layout) {
		@FindingsRulesetShell(data)
	}
}

templ FindingsRulesetMutationResponse(data viewmodels.FindingsRulesetViewData) {
	@FindingsRulesetShell(data)
	@SidebarFindingsRulesetsOOB(data.Layout)
}

templ FindingsRulesetShell(data viewmodels.FindingsRulesetViewData) {
	{{ mutationAttrs := MutationFormAttrs() }}
	{{ disableConfirmation := ConfirmAttrs(ConfirmConfig{
		Title: "Disable ruleset?",
		Body: "Disabling forces every rule in this ruleset to report not-applicable.",
		AcceptLabel: "Disable",
		Tone: ConfirmToneWarning,
	}) }}
	<div id="findings-ruleset-shell" class="min-w-0 space-y-6">
		@PageHeader("") {
			if data.Layout.IsAdmin {
				<form
					method="post"
					action={ "/findings/rulesets/" + data.Ruleset.Key + "/override" }
					hx-post={ "/findings/rulesets/" + data.Ruleset.Key + "/override" }
					hx-target="#findings-ruleset-shell"
					{ mutationAttrs... }
					class="flex items-center gap-2"
				>
						@CSRFInput(data.Layout.CSRFToken)
						if data.OverrideEnabled {
							<input type="hidden" name="enabled" value="false"/>
							<button
								type="submit"
								class="btn-outline"
								{ disableConfirmation... }
							>Disable ruleset</button>
						} else {
						<input type="hidden" name="enabled" value="true"/>
						<button type="submit" class="btn-primary">Enable ruleset</button>
					}
				</form>
			}
		}

		if data.Alert != nil {
			@Alert(data.Alert.Title, data.Alert.Destructive) {
				<p>{ data.Alert.Message }</p>
			}
		}

		<div class="grid min-w-0 gap-6">
			@FindingsRulesetRulesCard(data)
		</div>

	</div>
}

templ FindingsRulesetRulesCard(data viewmodels.FindingsRulesetViewData) {
	{{ cfg := FindingsRulesTableConfig(data) }}
	@TableFrame(cfg) {
		@TableFrameBody() {
		<form method="get" action={ data.Query.BasePath } hx-get={ data.Query.BasePath } hx-trigger="change delay:150ms from:[data-table-query-trigger], submit" hx-sync="this:replace" hx-target="#rules-card" hx-swap="outerHTML" hx-push-url="true" class="min-w-0">
			@TableToolbar() {
				@AskBar(FindingsRulesAskBar(data))
			}
			<button class="sr-only" type="submit">Apply filters</button>
		</form>
		@TableResults(cfg) {
			@TableDesktop() {
					@ColumnsTable("") {
					<table class="table osspm-table-compact osspm-table-list">
						@TableCaption(cfg.Caption)
						<thead>
							<tr>
								for _, column := range FindingsRulesColumns() {
									@TableColumnHeader(column, TableSortConfig{})
								}
							</tr>
						</thead>
						<tbody>
							for _, r := range data.Rules {
								<tr data-row-href={ r.Href }>
									<td class="whitespace-normal">
										<a class="osspm-cell-primary no-underline hover:underline" href={ r.Href } title={ r.Key }>{ r.Key }</a>
										if r.Title != "" && r.Title != r.Key {
											<span class="osspm-cell-secondary">{ r.Title }</span>
										} else if r.Summary != "" {
											<span class="osspm-cell-secondary">{ r.Summary }</span>
										}
										if r.EvidenceSummary != "" && r.EvidenceSummary != "Manual check requires attestation" && !strings.HasPrefix(r.EvidenceSummary, "Demo seeded:") && r.EvidenceSummary != r.Summary && r.EvidenceSummary != r.Title {
											<span class="osspm-cell-secondary">{ r.EvidenceSummary }</span>
										}
									</td>
									<td><span class={ templ.Classes("text-sm font-medium", RuleSeverityTextClass(r.Severity)) }>{ r.Severity }</span></td>
									<td><span class={ templ.Classes("text-sm font-medium", RuleMonitoringTextClass(r.MonitoringStatus)) }>{ r.MonitoringStatus }</span></td>
									<td>
										<div class="space-y-1.5 leading-5">
											<div class={ templ.Classes("text-sm font-medium", RuleStatusTextClass(r.Status)) }>{ HumanizeRuleStatus(r.Status) }</div>
										if r.ErrorKind != "" {
											<span class="osspm-cell-secondary">{ r.ErrorKind }</span>
										}
										if r.EvaluatedAt.Label != "" {
											<span class="osspm-cell-secondary">{ r.EvaluatedAt.Label }</span>
										}
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
					}
			}
			@TableMobile() {
					for _, r := range data.Rules {
						<article class="osspm-mobile-list-row">
							<div class="flex items-start justify-between gap-3">
								<div class="min-w-0">
									<a class="font-medium no-underline hover:underline" href={ r.Href } title={ r.Key }>{ r.Key }</a>
									if r.Title != "" && r.Title != r.Key {
										<p class="mt-1 text-sm text-muted-foreground">{ r.Title }</p>
									} else if r.Summary != "" {
										<p class="mt-1 text-sm text-muted-foreground">{ r.Summary }</p>
									}
								</div>
								<div class={ templ.Classes("shrink-0 text-sm font-medium", RuleStatusTextClass(r.Status)) }>{ HumanizeRuleStatus(r.Status) }</div>
							</div>
							<div class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-sm">
								<span class={ templ.Classes("font-medium", RuleSeverityTextClass(r.Severity)) }>{ r.Severity }</span>
								<span class={ templ.Classes("font-medium", RuleMonitoringTextClass(r.MonitoringStatus)) }>{ r.MonitoringStatus }</span>
								if r.EvaluatedAt.Label != "" {
									<span class="text-muted-foreground">{ r.EvaluatedAt.Label }</span>
								}
							</div>
						</article>
					}
			}
		}
		}
	}
}
