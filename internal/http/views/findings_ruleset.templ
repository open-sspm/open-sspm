package views

import (
	"strings"

	"github.com/open-sspm/open-sspm/internal/http/viewmodels"
)

templ FindingsRulesetPage(data viewmodels.FindingsRulesetViewData) {
	@Layout(data.Layout) {
		@FindingsRulesetShell(data)
	}
}

templ FindingsRulesetMutationResponse(data viewmodels.FindingsRulesetViewData) {
	@FindingsRulesetShell(data)
	@SidebarFindingsRulesetsOOB(data.Layout)
}

templ FindingsRulesetShell(data viewmodels.FindingsRulesetViewData) {
	<div id="findings-ruleset-shell" class="min-w-0 space-y-6">
		@PageHeader("") {
			if data.Layout.IsAdmin {
				<form
					method="post"
					action={ "/findings/rulesets/" + data.Ruleset.Key + "/override" }
					hx-post={ "/findings/rulesets/" + data.Ruleset.Key + "/override" }
					hx-target="#findings-ruleset-shell"
					hx-disabled-elt="this"
					class="flex items-center gap-2"
				>
						@CSRFInput(data.Layout.CSRFToken)
						if data.OverrideEnabled {
							<input type="hidden" name="enabled" value="false"/>
							<button
								type="submit"
								class="btn-outline"
								data-osspm-confirm-title="Disable ruleset?"
								data-osspm-confirm-body="Disabling forces every rule in this ruleset to report not-applicable."
								data-osspm-confirm-accept-label="Disable"
								data-osspm-confirm-tone="warning"
								hx-confirm=" "
							>Disable ruleset</button>
						} else {
						<input type="hidden" name="enabled" value="true"/>
						<button type="submit" class="btn-primary">Enable ruleset</button>
					}
				</form>
			}
		}

		if data.Alert != nil {
			@Alert(data.Alert.Title, data.Alert.Destructive) {
				<p>{ data.Alert.Message }</p>
			}
		}

		<div class="grid min-w-0 gap-6">
			@FindingsRulesetRulesCard(data)
		</div>

	</div>
}

templ FindingsRulesetRulesCard(data viewmodels.FindingsRulesetViewData) {
	<section id="rules-card" class="min-w-0 space-y-3">
		@BusyInlineIndicator("Updating rules...", false)
				<div class="osspm-list-toolbar min-w-0">
					<div class="osspm-list-section-header min-w-0">
						<h2 class="text-base font-semibold">Rules</h2>
						<p class="text-sm text-muted-foreground">Filter and review the current results for this ruleset.</p>
					</div>
						<form method="get" action={ "/findings/rulesets/" + data.Ruleset.Key } hx-get={ "/findings/rulesets/" + data.Ruleset.Key } hx-trigger="change delay:150ms from:select, submit" hx-sync="this:replace" hx-target="#rules-card" hx-push-url="true" class="min-w-0">
							@FilterPopover("Filters", FindingsRulesetFilterCount(data), FindingsRulesetFilterCount(data) > 0, "left-auto right-0 w-[min(92vw,32rem)] space-y-4 sm:left-auto sm:right-0") {
							<div class="grid gap-4 sm:grid-cols-2">
								<label class="field">
									<span class="label">Status</span>
									<select class="select" name="status">
										<option value="" selected?={ data.StatusFilter == "" }>All</option>
										<option value="pass" selected?={ data.StatusFilter == "pass" }>Pass</option>
										<option value="fail" selected?={ data.StatusFilter == "fail" }>Fail</option>
										<option value="unknown" selected?={ data.StatusFilter == "unknown" }>Unknown</option>
										<option value="error" selected?={ data.StatusFilter == "error" }>Error</option>
										<option value="not_applicable" selected?={ data.StatusFilter == "not_applicable" }>Not applicable</option>
									</select>
								</label>
								<label class="field">
									<span class="label">Severity</span>
									<select class="select" name="severity">
										<option value="" selected?={ data.SeverityFilter == "" }>All</option>
										<option value="critical" selected?={ data.SeverityFilter == "critical" }>Critical</option>
										<option value="high" selected?={ data.SeverityFilter == "high" }>High</option>
										<option value="medium" selected?={ data.SeverityFilter == "medium" }>Medium</option>
										<option value="low" selected?={ data.SeverityFilter == "low" }>Low</option>
										<option value="info" selected?={ data.SeverityFilter == "info" }>Info</option>
									</select>
								</label>
								<label class="field sm:col-span-2">
									<span class="label">Monitoring</span>
									<select class="select" name="monitoring">
										<option value="" selected?={ data.MonitoringFilter == "" }>All</option>
										<option value="automated" selected?={ data.MonitoringFilter == "automated" }>Automated</option>
										<option value="partial" selected?={ data.MonitoringFilter == "partial" }>Partial</option>
										<option value="manual" selected?={ data.MonitoringFilter == "manual" }>Manual</option>
										<option value="unsupported" selected?={ data.MonitoringFilter == "unsupported" }>Unsupported</option>
									</select>
								</label>
							</div>
							if FindingsRulesetFilterCount(data) > 0 {
								<div class="border-t border-border/60 pt-3">
									<a class="text-xs text-muted-foreground no-underline hover:text-foreground" href={ FindingsRulesetClearFiltersHref(data) } hx-get={ FindingsRulesetClearFiltersHref(data) } hx-target="#rules-card" hx-swap="outerHTML show:top" hx-push-url="true">Clear all filters</a>
								</div>
							}
						}
						<button class="sr-only" type="submit">Apply filters</button>
					</form>
				</div>

			if data.HasRules {
				@ColumnsTable("") {
					<table class="table osspm-table-compact osspm-table-list">
						<caption class="sr-only">Rules in this ruleset with severity, monitoring, and current status.</caption>
						<thead>
							<tr>
								<th>Rule</th>
								<th>Severity</th>
								<th>Monitoring</th>
								<th>Status</th>
							</tr>
						</thead>
						<tbody>
							for _, r := range data.Rules {
								<tr data-row-href={ r.Href }>
									<td class="whitespace-normal">
										<a class="osspm-cell-primary no-underline hover:underline" href={ r.Href } title={ r.Key }>{ r.Key }</a>
										if r.Title != "" && r.Title != r.Key {
											<span class="osspm-cell-secondary">{ r.Title }</span>
										} else if r.Summary != "" {
											<span class="osspm-cell-secondary">{ r.Summary }</span>
										}
										if r.EvidenceSummary != "" && r.EvidenceSummary != "Manual check requires attestation" && !strings.HasPrefix(r.EvidenceSummary, "Demo seeded:") && r.EvidenceSummary != r.Summary && r.EvidenceSummary != r.Title {
											<span class="osspm-cell-secondary">{ r.EvidenceSummary }</span>
										}
									</td>
									<td><span class={ templ.Classes("text-sm font-medium", RuleSeverityTextClass(r.Severity)) }>{ r.Severity }</span></td>
									<td><span class={ templ.Classes("text-sm font-medium", RuleMonitoringTextClass(r.MonitoringStatus)) }>{ r.MonitoringStatus }</span></td>
									<td>
										<div class="space-y-1.5 leading-5">
											<div class={ templ.Classes("text-sm font-medium", RuleStatusTextClass(r.Status)) }>{ HumanizeRuleStatus(r.Status) }</div>
										if r.ErrorKind != "" {
											<span class="osspm-cell-secondary">{ r.ErrorKind }</span>
										}
										if r.EvaluatedAt.Label != "" {
											<span class="osspm-cell-secondary">{ r.EvaluatedAt.Label }</span>
										}
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
			} else {
				@EmptyState("No rules found", "This ruleset has no active rules.") {
				}
			}
		</section>
	}
