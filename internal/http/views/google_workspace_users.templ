package views

import (
	"github.com/open-sspm/open-sspm/internal/http/querystate"
	"github.com/open-sspm/open-sspm/internal/http/viewmodels"
)

templ GoogleWorkspaceUserMobileRow(user viewmodels.GoogleWorkspaceUserListItem) {
	<article class="rounded-lg border border-border/70 bg-card p-4">
		<div class="flex items-start justify-between gap-3">
			<div class="min-w-0">
				<div class="font-medium" title={ user.DisplayName }>
						<span class="osspm-truncate" hx-disable>{ user.DisplayName }</span>
				</div>
				if user.Email != "" {
						<div class="text-sm text-muted-foreground break-all" hx-disable>{ user.Email }</div>
					} else if user.ExternalID != "" {
						<div class="text-sm text-muted-foreground break-all" hx-disable>{ user.ExternalID }</div>
					}
			</div>
		</div>
		<div class="mt-3 grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
			<div>
				<div class="text-xs uppercase tracking-wide text-muted-foreground">Groups</div>
				<div><span class="badge-outline">{ FormatInt(user.GroupCount) }</span></div>
			</div>
			<div>
				<div class="text-xs uppercase tracking-wide text-muted-foreground">Admin roles</div>
				<div><span class="badge-outline">{ FormatInt(user.AdminRoleCount) }</span></div>
			</div>
			<div class="col-span-2">
				<div class="text-xs uppercase tracking-wide text-muted-foreground">Identity</div>
				if user.IdentityID > 0 {
					<a class="btn-sm-link px-0" href={ "/identities/" + FormatInt64(user.IdentityID) }>{ "Identity #" }{ FormatInt64(user.IdentityID) }</a>
				} else {
					<div class="text-muted-foreground">—</div>
				}
			</div>
		</div>
	</article>
}

templ GoogleWorkspaceUsersPage(data viewmodels.GoogleWorkspaceUsersViewData) {
	@Layout(data.Layout) {
		@PageHeader("") {
				if data.Layout.GoogleWorkspaceConfigured && data.Layout.GoogleWorkspaceEnabled {
					<a class="btn-sm-outline" href="/accounts/google-workspace/groups">Groups</a>
					<a class="btn-sm-outline" href={ querystate.ConnectedAppsQuery{}.Href() }>OAuth Apps</a>
					<a class="btn-sm-outline" href="/accounts/needs-anchor/google-workspace">Needs anchor</a>
				} else {
					@ConnectorConfigureLink("/settings/connectors?open=google_workspace", "btn-sm-outline") {
						Configure
					}
				}
		}

		if data.Layout.GoogleWorkspaceConfigured && data.Layout.GoogleWorkspaceEnabled {
				@Alert("Linking", false) {
					<p>
						Anchored users let you jump to their identity. Use
						<a class="btn-sm-link px-1" href="/accounts/needs-anchor/google-workspace">Needs anchor</a>
						to resolve users without an authoritative anchor.
					</p>
				}
		} else {
			@Alert("Google Workspace sync disabled", true) {
				<p>
					{ data.EmptyStateMsg } @ConnectorConfigureLink(data.EmptyStateHref, "btn-sm-link px-1") {
						Configure Google Workspace
					}.
				</p>
			}
		}

		@GoogleWorkspaceUsersPageFilters(data)
		@GoogleWorkspaceUsersPageResults(data)
	}
}

templ GoogleWorkspaceUsersPageFilters(data viewmodels.GoogleWorkspaceUsersViewData) {
		<form
			method="get"
			action="/accounts/google-workspace"
			data-enter-only-query="q"
			hx-get="/accounts/google-workspace"
			hx-trigger="change delay:150ms from:[data-table-query-trigger], submit"
			hx-sync="this:replace"
			hx-target="#google-workspace-users-results"
			hx-push-url="true"
			class="osspm-list-form"
		>
			<div class="osspm-list-toolbar">
				<div class="min-w-0 flex-1">
					@AskBar(SearchOnlyAskBar(data.Query, "Search email, name, or Google user ID", "#google-workspace-users-results"))
				</div>
			</div>
			<button class="sr-only" type="submit">Apply filters</button>
		</form>
}

templ GoogleWorkspaceUsersPageResults(data viewmodels.GoogleWorkspaceUsersViewData) {
	<div id="google-workspace-users-results" class="space-y-5">
		@BusyInlineIndicator("Updating results...", false)
		<section class="space-y-3">
			@ListSectionHeader("Google Workspace users", "Google Workspace users with group and admin-role visibility.")
			if data.HasUsers {
				<div class="space-y-3 lg:hidden">
					for _, u := range data.Users {
						@GoogleWorkspaceUserMobileRow(u)
					}
				</div>
			} else {
				<div class="lg:hidden">
					@EmptyState("No users found", data.EmptyStateMsg)
				</div>
			}
			@ColumnsTable("hidden lg:block") {
				<table class="table osspm-table-fixed osspm-table-compact osspm-table-list">
					<caption class="sr-only">Google Workspace users with group and admin-role counts.</caption>
					<thead>
						<tr>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">User</th>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Email</th>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Groups</th>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Admin roles</th>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Identity</th>
						</tr>
					</thead>
					<tbody>
						if data.HasUsers {
							for _, u := range data.Users {
								<tr>
									<td>
										<div class="space-y-1">
												<div class="font-medium" hx-disable>{ u.DisplayName }</div>
												if u.ExternalID != "" {
													<div class="text-xs text-muted-foreground" hx-disable>{ u.ExternalID }</div>
												}
										</div>
									</td>
									<td>
											if u.Email != "" {
												<span hx-disable>{ u.Email }</span>
											} else {
											<span class="text-muted-foreground">&mdash;</span>
										}
									</td>
									<td><span class="badge-outline">{ FormatInt(u.GroupCount) }</span></td>
									<td><span class="badge-outline">{ FormatInt(u.AdminRoleCount) }</span></td>
									<td>
										if u.IdentityID > 0 {
											<a class="btn-sm-link" href={ "/identities/" + FormatInt64(u.IdentityID) }>{ "Identity #" }{ FormatInt64(u.IdentityID) }</a>
										} else {
											<span class="text-muted-foreground">&mdash;</span>
										}
									</td>
								</tr>
							}
						} else {
							<tr>
								<td colspan="5">
									@EmptyState("No users found", data.EmptyStateMsg)
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
			if data.TotalPages > 1 {
				@ListPagination("google-workspace-users-results", data.Page, data.TotalPages, BasicListPageHref(data.Query))
			}
		</section>
	</div>
}
