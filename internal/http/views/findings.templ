package views

import "github.com/open-sspm/open-sspm/internal/http/viewmodels"

templ FindingsPage(data viewmodels.FindingsRulesetsViewData) {
	@Layout(data.Layout) {
		if data.HasRulesets {
			@ColumnsTable("") {
				<table class="table osspm-table-compact osspm-table-list">
					<caption class="sr-only">Rulesets available for evaluation, grouped by source.</caption>
					<thead>
						<tr>
							<th>Ruleset</th>
							<th>Source</th>
							<th>Version</th>
							<th>Status</th>
						</tr>
					</thead>
					<tbody>
						for _, rs := range data.Rulesets {
							<tr data-row-href={ rs.Href }>
								<td class="whitespace-normal">
									<a class="osspm-cell-primary no-underline hover:underline" href={ rs.Href }>{ rs.Name }</a>
									if rs.Description != "" {
										<span class="osspm-cell-secondary">{ rs.Description }</span>
									}
								</td>
								<td class="text-muted-foreground">{ rs.Source }</td>
								<td class="text-muted-foreground">{ rs.SourceVersion }</td>
								<td>
									<span class="badge-outline">{ rs.Status }</span>
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		} else {
			@EmptyState("No rulesets found", "Run open-sspm admin seed-rules to load ruleset definitions into Postgres.") {
			}
		}
	}
}
