package views

import (
	"github.com/open-sspm/open-sspm/internal/http/events"
	"github.com/open-sspm/open-sspm/internal/http/viewmodels"
)

templ IdentityResolutionPage(data viewmodels.IdentityResolutionViewData) {
	@Layout(data.Layout) {
		@IdentityResolutionPageResults(data)
	}
}

templ IdentityResolutionPageResults(data viewmodels.IdentityResolutionViewData) {
		<div
			id="identity-resolution-results"
			class="space-y-6"
			hx-get={ identityResolutionPageHref(data.Page, data.Status, data.Group) }
			hx-trigger={ events.BusTrigger(events.IdentityResolutionChanged) }
			hx-target="this"
			hx-sync="this:replace"
		>
		<section class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
			<div class="min-w-0">
				<h2 class="text-lg font-semibold tracking-tight">{ data.StatusLabel }</h2>
				<p class="text-sm text-muted-foreground">{ FormatInt64(data.TotalCount) }{ " " }{ pluralizeSuffix(int(data.TotalCount), "candidate", "candidates") }</p>
			</div>
		</section>

		<section class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
			<div class="flex flex-wrap gap-2">
				for _, option := range data.StatusTabs {
					if option.Selected {
						<span class="btn-sm-primary">{ option.Label }</span>
					} else {
						<a class="btn-sm-outline" href={ option.Href } hx-get={ option.Href } hx-target="#identity-resolution-results" hx-swap="outerHTML show:top" hx-push-url="true">{ option.Label }</a>
					}
				}
			</div>
			<div class="flex flex-wrap gap-2">
				for _, option := range data.GroupFilters {
					if option.Selected {
						<span class="badge bg-primary text-primary-foreground">{ option.Label }</span>
					} else {
						<a class="badge-outline no-underline hover:bg-muted" href={ option.Href } hx-get={ option.Href } hx-target="#identity-resolution-results" hx-swap="outerHTML show:top" hx-push-url="true">{ option.Label }</a>
					}
				}
			</div>
		</section>

		if data.HasItems {
			<section class="space-y-3">
				for _, item := range data.Items {
						<article id={ "identity-resolution-candidate-" + FormatInt64(item.ID) } class="rounded-md border border-border bg-background p-4 shadow-sm">
						<div class="flex flex-col gap-4 xl:flex-row xl:items-start xl:justify-between">
							<div class="min-w-0 flex-1 space-y-4">
								<div class="flex flex-wrap items-center gap-2">
									<span class={ identityResolutionBandBadgeClass(item.ConfidenceBand) }>{ HumanizeIdentityResolutionToken(item.ConfidenceBand) }</span>
									<span class="badge-outline">{ HumanizeIdentityResolutionToken(item.Status) }</span>
									<span class="badge-outline">{ HumanizeIdentityResolutionToken(item.MatchReason) }</span>
									<span class="text-xs text-muted-foreground">Score { FormatInt(int(item.Score)) }</span>
									if item.RelationshipCount > 0 {
										<span class="text-xs text-muted-foreground">{ FormatInt64(item.RelationshipCount) }{ " " }{ pluralizeSuffix(int(item.RelationshipCount), "relationship", "relationships") }</span>
									}
									if item.CreatedAt.Label != "" {
										<span class="text-xs text-muted-foreground" title={ item.CreatedAt.Title }>{ item.CreatedAt.Label }</span>
									}
								</div>

								<div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
									<section class="min-w-0 space-y-2">
										<div class="text-xs font-medium uppercase text-muted-foreground">Source Account</div>
										<div class="min-w-0">
												<div class="truncate font-medium" hx-disable>{ item.AccountDisplayName }</div>
												if item.AccountEmail != "" {
													<div class="truncate text-sm text-muted-foreground" hx-disable>{ item.AccountEmail }</div>
												}
										</div>
										<div class="flex flex-wrap gap-2 text-xs text-muted-foreground">
											<span>{ HumanizeConnectorKind(item.AccountSourceKind) }</span>
												if item.AccountSourceName != "" {
													<span hx-disable>{ item.AccountSourceName }</span>
												}
												if item.AccountExternalID != "" {
													<span class="truncate" hx-disable>{ item.AccountExternalID }</span>
												}
										</div>
										<div class="flex flex-wrap gap-2">
											if item.AccountKind != "" {
												<span class="badge-outline">{ HumanizeIdentityResolutionToken(item.AccountKind) }</span>
											}
											if item.EntityCategory != "" {
												<span class="badge-outline">{ HumanizeIdentityResolutionToken(item.EntityCategory) }</span>
											}
										</div>
									</section>

									<section class="min-w-0 space-y-2">
											<div class="text-xs font-medium uppercase text-muted-foreground">Candidate Identity</div>
											<a class="block min-w-0 no-underline hover:underline" href={ item.CandidateHref }>
												<div class="truncate font-medium" hx-disable>{ item.CandidateDisplayName }</div>
												if item.CandidatePrimaryEmail != "" {
													<div class="truncate text-sm text-muted-foreground" hx-disable>{ item.CandidatePrimaryEmail }</div>
												}
										</a>
										<div class="flex flex-wrap gap-2">
											if item.CandidateResolutionState != "" {
												<span class="badge-outline">{ HumanizeIdentityResolutionToken(item.CandidateResolutionState) }</span>
											}
											if item.CandidateIdentityKind != "" {
												<span class="badge-outline">{ HumanizeIdentityResolutionToken(item.CandidateIdentityKind) }</span>
											}
										</div>
									</section>
								</div>

								<div class="grid gap-3 md:grid-cols-2">
									<section class="rounded-md border border-border/70 p-3">
											<div class="text-xs font-medium uppercase text-muted-foreground">Current Rollup</div>
											if item.CurrentIdentityID > 0 {
												<a href={ item.CurrentIdentityHref } class="mt-1 block truncate font-medium no-underline hover:underline"><span hx-disable>{ item.CurrentIdentityDisplayName }</span></a>
												if item.CurrentIdentityPrimaryEmail != "" {
													<div class="truncate text-sm text-muted-foreground" hx-disable>{ item.CurrentIdentityPrimaryEmail }</div>
												}
											<div class="mt-2 flex flex-wrap gap-2">
												if item.CurrentLinkState != "" {
													<span class="badge-outline">{ HumanizeIdentityResolutionToken(item.CurrentLinkState) }</span>
												}
												if item.CurrentLinkReason != "" {
													<span class="badge-outline">{ viewmodels.HumanLinkReason(item.CurrentLinkReason) }</span>
												}
											</div>
										} else {
											<div class="mt-1 text-sm text-muted-foreground">—</div>
										}
									</section>
									<section class="rounded-md border border-border/70 p-3">
											<div class="text-xs font-medium uppercase text-muted-foreground">Provisional Identity</div>
											if item.ProvisionalIdentityID > 0 {
												<a href={ item.ProvisionalHref } class="mt-1 block truncate font-medium no-underline hover:underline"><span hx-disable>{ item.ProvisionalDisplayName }</span></a>
												if item.ProvisionalPrimaryEmail != "" {
													<div class="truncate text-sm text-muted-foreground" hx-disable>{ item.ProvisionalPrimaryEmail }</div>
												}
										} else {
											<div class="mt-1 text-sm text-muted-foreground">—</div>
										}
									</section>
								</div>

								if item.HasEvidence {
									<details class="rounded-md border border-border/70 p-3">
										<summary class="cursor-pointer text-sm font-medium">Evidence</summary>
										<div class="mt-3 overflow-x-auto">
											<table class="table osspm-table-compact">
												<thead>
													<tr>
														<th>Type</th>
														<th>Account</th>
														<th>Identity</th>
														<th>Source</th>
														<th class="osspm-num">Strength</th>
													</tr>
												</thead>
												<tbody>
													for _, evidence := range item.Evidence {
														<tr>
															<td>
																<span class={ identityResolutionEvidenceBadgeClass(evidence.IsPositive) }>{ HumanizeIdentityResolutionToken(evidence.EvidenceType) }</span>
																if evidence.EvidenceKey != "" {
																	<span class="osspm-cell-secondary">{ HumanizeIdentityResolutionToken(evidence.EvidenceKey) }</span>
																}
															</td>
																<td class="max-w-[16rem] truncate" hx-disable>{ evidence.AccountValue }</td>
																<td class="max-w-[16rem] truncate" hx-disable>{ evidence.IdentityValue }</td>
															<td>
																if evidence.SourceKind != "" {
																	<span>{ HumanizeConnectorKind(evidence.SourceKind) }</span>
																		if evidence.SourceName != "" {
																			<span class="osspm-cell-secondary" hx-disable>{ evidence.SourceName }</span>
																		}
																} else {
																	<span class="text-muted-foreground">—</span>
																}
															</td>
															<td class="osspm-num">{ FormatInt(int(evidence.Strength)) }</td>
														</tr>
													}
												</tbody>
											</table>
										</div>
									</details>
								}
							</div>

							<div class="flex shrink-0 flex-col gap-2 xl:w-44">
								if data.Layout.IsAdmin {
									@identityResolutionActions(data.Layout.CSRFToken, item)
								} else {
									<span class="text-sm text-muted-foreground">Admin required</span>
								}
							</div>
						</div>
					</article>
				}
			</section>

			if data.TotalPages > 1 {
				<div class="osspm-list-pagination-split">
					<p class="text-sm text-muted-foreground">Page { FormatInt(data.Page) }{ " of " }{ FormatInt(data.TotalPages) }</p>
					<div class="flex items-center gap-2">
						if data.Page > 1 {
							<a class="btn-sm-outline" href={ identityResolutionPageHref(data.Page - 1, data.Status, data.Group) } hx-get={ identityResolutionPageHref(data.Page - 1, data.Status, data.Group) } hx-target="#identity-resolution-results" hx-swap="outerHTML show:top" hx-push-url="true">Previous</a>
						} else {
							<span class="btn-sm-outline opacity-50" aria-disabled="true">Previous</span>
						}
						if data.Page < data.TotalPages {
							<a class="btn-sm-outline" href={ identityResolutionPageHref(data.Page + 1, data.Status, data.Group) } hx-get={ identityResolutionPageHref(data.Page + 1, data.Status, data.Group) } hx-target="#identity-resolution-results" hx-swap="outerHTML show:top" hx-push-url="true">Next</a>
						} else {
							<span class="btn-sm-outline opacity-50" aria-disabled="true">Next</span>
						}
					</div>
				</div>
			}
		} else {
			@EmptyState("No pending candidates", data.EmptyStateMsg)
		}
	</div>
}

// identityResolutionActions consolidates the six per-candidate decision forms
// into one form whose buttons each carry their own hx-post + structured
// confirm metadata. The styled confirm modal (confirm.js) picks up the
// data-osspm-confirm-* attributes and presents a real dialog instead of a
// browser confirm/prompt.
templ identityResolutionActions(csrfToken string, item viewmodels.IdentityResolutionCandidateItem) {
	{{ actionFormID := "identity-resolution-actions-" + FormatInt64(item.ID) }}
	{{ mutationAttrs := ScopedMutationAttrs(actionFormID, "button[type='submit']") }}
	{{ acceptMergeConfirmation := ConfirmAttrs(ConfirmConfig{
		Title: "Accept and merge?",
		Body: "Accepts the match and merges the provisional identity into the candidate.",
		AcceptLabel: "Accept + merge",
	}) }}
	{{ rejectConfirmation := ConfirmAttrs(ConfirmConfig{
		Title: "Reject candidate?",
		Body: "The candidate stays suppressed until its evidence changes.",
		AcceptLabel: "Reject",
		Tone: ConfirmToneWarning,
		ReasonLabel: "Optional reason",
		ReasonName: "review_note",
	}) }}
	{{ markServiceConfirmation := ConfirmAttrs(ConfirmConfig{
		Title: "Classify as service account?",
		Body: "Marks the source account as a service identity and rejects the candidate.",
		AcceptLabel: "Mark service",
	}) }}
	{{ markCustodianConfirmation := ConfirmAttrs(ConfirmConfig{
		Title: "Classify as service custodian?",
		Body: "Records the source account as a service custodian, not a primary owner.",
		AcceptLabel: "Mark custodian",
	}) }}
	{{ markSharedConfirmation := ConfirmAttrs(ConfirmConfig{
		Title: "Classify as shared account?",
		Body: "Marks the source account as shared and rejects the candidate.",
		AcceptLabel: "Mark shared",
	}) }}
	<form
		id={ actionFormID }
		method="post"
		action={ item.AcceptHref }
		hx-target={ "#identity-resolution-candidate-" + FormatInt64(item.ID) }
		hx-swap="swap:200ms"
		{ mutationAttrs... }
		class="flex flex-col gap-2"
	>
		@CSRFInput(csrfToken)
		if item.CanAccept {
			<button
				type="submit"
				class="btn-sm-primary w-full"
				hx-post={ item.AcceptHref }
			>Accept</button>
		}
		if item.CanMergeProvisional {
			<button
				type="submit"
				class="btn-sm-outline w-full"
				hx-post={ item.AcceptMergeHref }
				name="merge_provisional"
				value="true"
				{ acceptMergeConfirmation... }
			>Accept + merge</button>
		}
		if item.CanReject {
			<button
				type="submit"
				class="btn-sm-outline w-full"
				formaction={ item.RejectHref }
				hx-post={ item.RejectHref }
				{ rejectConfirmation... }
			>Reject</button>
		}
		if item.CanMarkService {
			<button
				type="submit"
				class="btn-sm-outline w-full"
				formaction={ item.MarkServiceHref }
				hx-post={ item.MarkServiceHref }
				{ markServiceConfirmation... }
			>Mark service</button>
		}
		if item.CanMarkServiceCustodian {
			<button
				type="submit"
				class="btn-sm-outline w-full"
				formaction={ item.MarkServiceCustodianHref }
				hx-post={ item.MarkServiceCustodianHref }
				name="relationship_type"
				value="custodian"
				{ markCustodianConfirmation... }
			>Service custodian</button>
		}
		if item.CanMarkShared {
			<button
				type="submit"
				class="btn-sm-outline w-full"
				formaction={ item.MarkSharedHref }
				hx-post={ item.MarkSharedHref }
				{ markSharedConfirmation... }
			>Mark shared</button>
		}
	</form>
}
