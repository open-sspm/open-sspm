package views

import "github.com/open-sspm/open-sspm/internal/http/viewmodels"

templ DiscoveryAppsPage(data viewmodels.DiscoveryAppsViewData) {
	@Layout(data.Layout) {
		@DiscoveryAppsPageFilters(data)
		@DiscoveryAppsPageResults(data)
	}
}

templ DiscoveryAppMobileRow(item viewmodels.DiscoveryAppListItem) {
	<a href={ templ.SafeURL("/discovery/apps/" + FormatInt64(item.ID)) } class="osspm-identity-card">
		<div class="flex items-start justify-between gap-3">
			<div class="flex min-w-0 items-start gap-3">
				@ProductIcon(item.DisplayName, item.VendorName, item.Domain, "size-8")
				<div class="min-w-0">
					<div class="font-medium truncate">{ item.DisplayName }</div>
					if item.Domain != "" {
						<div class="osspm-token text-sm text-muted-foreground break-all">{ item.Domain }</div>
					}
					<div class="mt-1 flex flex-wrap items-center gap-2 text-xs">
						if item.ManagedState == "unmanaged" {
							<span class="text-sm leading-none" aria-label="Unmanaged" title="Unmanaged">❌</span>
						} else {
							<span class={ DiscoveryManagedBadgeClass(item.ManagedState) }>{ HumanizeDiscoveryManagedState(item.ManagedState) }</span>
						}
						<span class={ templ.Classes("font-medium", DiscoveryReviewDispositionTextClass(item.ReviewDisposition)) }>{ HumanizeDiscoveryReviewDisposition(item.ReviewDisposition) }</span>
					</div>
				</div>
			</div>
			<span
				class={ templ.Classes(CredentialRiskBadgeClass(item.RiskLevel), "cursor-help") }
				data-tooltip={ "Score " + FormatInt(int(item.RiskScore)) }
				data-side="top"
				data-align="end"
				title={ "Score " + FormatInt(int(item.RiskScore)) }
			>{ HumanizeCredentialRisk(item.RiskLevel) }</span>
		</div>
		<dl class="mt-3 grid grid-cols-3 gap-x-3 gap-y-2 text-sm">
			<div>
				<dt class="osspm-stat-label">Owner</dt>
				<dd class="truncate">
					if item.Owner != "" {
						{ item.Owner }
					} else {
						<span class="text-muted-foreground">—</span>
					}
				</dd>
			</div>
			<div>
				<dt class="osspm-stat-label">Actors 30d</dt>
				<dd class="tabular-nums">{ FormatInt64(item.Actors30d) }</dd>
			</div>
			<div>
				<dt class="osspm-stat-label">Last seen</dt>
				<dd class="truncate">{ item.LastSeen.Label }</dd>
			</div>
		</dl>
	</a>
}

templ DiscoveryAppsPageFilters(data viewmodels.DiscoveryAppsViewData) {
		<form
			method="get"
			action="/discovery/apps"
			data-enter-only-query="q"
			hx-get="/discovery/apps"
			hx-trigger="change delay:150ms from:[data-table-query-trigger], submit"
			hx-target="#discovery-apps-results"
			hx-swap="outerHTML"
			hx-push-url="true"
				class="osspm-list-form"
			>
					<div class="osspm-list-toolbar">
						<div class="min-w-0 flex-1">
							@AskBar(DiscoveryAppsAskBar(data))
						</div>
					</div>
				<button class="sr-only" type="submit">Apply filters</button>
			</form>
}

templ DiscoveryAppsPageResults(data viewmodels.DiscoveryAppsViewData) {
	<div id="discovery-apps-results" class="space-y-6">
		@BusyInlineIndicator("Updating results...", false)
			<section class="space-y-3">
				if data.HasItems {
					<div class="space-y-3 lg:hidden">
						for _, item := range data.Items {
							@DiscoveryAppMobileRow(item)
						}
					</div>
				} else {
					<div class="lg:hidden">
						@EmptyState("No discovery apps found", data.EmptyStateMsg)
					</div>
				}
				@ColumnsTable("hidden lg:block") {
					<table class="table osspm-table-fixed osspm-table-compact osspm-table-list">
						<caption class="sr-only">Discovered SaaS applications with managed state and risk posture.</caption>
						<thead>
							<tr>
								<th>App</th>
								<th>Managed</th>
								<th>Risk</th>
								<th>Owner</th>
								<th>Review</th>
								<th class="osspm-num">Actors 30d</th>
								<th>Last seen</th>
							</tr>
						</thead>
						<tbody>
							if data.HasItems {
								for _, item := range data.Items {
									<tr data-row-href={ "/discovery/apps/" + FormatInt64(item.ID) }>
										<td>
											<a class="osspm-identity-link" href={ templ.SafeURL("/discovery/apps/" + FormatInt64(item.ID)) }>
												<span class="flex min-w-0 items-center gap-3">
													@ProductIcon(item.DisplayName, item.VendorName, item.Domain, "size-8")
													<span class="min-w-0 flex-1">
														<span class="osspm-identity-name">{ item.DisplayName }</span>
														<span class="osspm-identity-meta">
															if item.Domain != "" {
																<span class="osspm-token truncate">{ item.Domain }</span>
															} else if item.VendorName != "" {
																<span class="truncate">{ item.VendorName }</span>
															}
														</span>
													</span>
												</span>
											</a>
										</td>
										<td>
											if item.ManagedState == "unmanaged" {
												<span class="text-sm leading-none" aria-label="Unmanaged" title="Unmanaged">❌</span>
											} else {
												<span class={ DiscoveryManagedBadgeClass(item.ManagedState) }>{ HumanizeDiscoveryManagedState(item.ManagedState) }</span>
											}
										</td>
										<td>
											<span
												class={ templ.Classes(CredentialRiskBadgeClass(item.RiskLevel), "cursor-help") }
												data-tooltip={ "Score " + FormatInt(int(item.RiskScore)) }
												data-side="top"
												data-align="start"
												title={ "Score " + FormatInt(int(item.RiskScore)) }
											>{ HumanizeCredentialRisk(item.RiskLevel) }</span>
										</td>
										<td>
											if item.Owner != "" {
												<span class="osspm-cell-primary font-normal truncate" title={ item.Owner }>{ item.Owner }</span>
											} else {
												<span class="text-muted-foreground">—</span>
											}
										</td>
										<td class="whitespace-normal">
											<span class={ templ.Classes("text-sm font-medium", DiscoveryReviewDispositionTextClass(item.ReviewDisposition)) }>{ HumanizeDiscoveryReviewDisposition(item.ReviewDisposition) }</span>
											if item.FollowUpDueDate.Label != "" || item.TicketRef != "" || (item.ReviewOwner != "" && item.ReviewOwner != "—") || item.ReplacementDisplayName != "" {
												<span class="osspm-cell-secondary">
													if item.FollowUpDueDate.Label != "" {
														if item.IsFollowUpOverdue {
															<span class="text-rose-700 dark:text-rose-400">{ "Due " }{ item.FollowUpDueDate.Label }</span>
														} else {
															{ "Due " }{ item.FollowUpDueDate.Label }
														}
													} else if item.TicketRef != "" {
														{ item.TicketRef }
													} else if item.ReviewOwner != "" && item.ReviewOwner != "—" {
														{ item.ReviewOwner }
													} else if item.ReplacementDisplayName != "" {
														{ "Replace: " }{ item.ReplacementDisplayName }
													}
												</span>
											}
										</td>
										<td class="osspm-num tabular-nums">{ FormatInt64(item.Actors30d) }</td>
										<td class="text-muted-foreground">{ item.LastSeen.Label }</td>
									</tr>
								}
							} else {
								<tr>
									<td colspan="7">
										@EmptyState("No discovery apps found", data.EmptyStateMsg)
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
				if data.TotalPages > 1 {
						<div class="osspm-list-pagination">
						<div class="text-sm text-muted-foreground">{ "Page " }{ FormatInt(data.Page) }{ " of " }{ FormatInt(data.TotalPages) }</div>
						<div class="button-group ml-auto">
							if data.Page > 1 {
								<a class="btn-sm-outline" href={ data.Query.WithPage(data.Page-1).Href() } hx-get={ data.Query.WithPage(data.Page-1).Href() } hx-target="#discovery-apps-results" hx-swap="outerHTML" hx-push-url="true">Previous</a>
							} else {
								<span class="btn-sm-outline opacity-50" aria-disabled="true">Previous</span>
							}
							if data.Page < data.TotalPages {
								<a class="btn-sm-outline" href={ data.Query.WithPage(data.Page+1).Href() } hx-get={ data.Query.WithPage(data.Page+1).Href() } hx-target="#discovery-apps-results" hx-swap="outerHTML" hx-push-url="true">Next</a>
							} else {
								<span class="btn-sm-outline opacity-50" aria-disabled="true">Next</span>
							}
						</div>
					</div>
				}
		</section>
	</div>
}
