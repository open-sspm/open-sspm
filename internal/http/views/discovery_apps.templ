package views

import "github.com/open-sspm/open-sspm/internal/http/viewmodels"

templ DiscoveryAppsPage(data viewmodels.DiscoveryAppsViewData) {
	@Layout(data.Layout) {
		@PageHeader("Discovered SaaS inventory from IdP SSO and OAuth evidence.") {
		}
		@DiscoveryAppsPageResults(data)
	}
}

templ DiscoveryAppMobileRow(item viewmodels.DiscoveryAppListItem) {
	<article class="rounded-lg border border-border/70 bg-card p-4">
		<div class="flex items-start justify-between gap-3">
			<div class="min-w-0">
				<a class="block font-medium text-foreground no-underline hover:underline" href={ "/discovery/apps/" + FormatInt64(item.ID) } title={ item.DisplayName }>
					<span class="osspm-truncate">{ item.DisplayName }</span>
				</a>
				if item.Domain != "" {
					<div class="text-sm text-muted-foreground break-all">{ item.Domain }</div>
				}
				if item.VendorName != "" {
					<div class="osspm-truncate text-sm text-muted-foreground" title={ item.VendorName }>{ item.VendorName }</div>
				}
			</div>
			<div class="shrink-0 text-right">
				<span class={ CredentialRiskBadgeClass(item.RiskLevel) }>{ HumanizeCredentialRisk(item.RiskLevel) }</span>
				<div class={ RiskScoreClass(item.RiskLevel) }>{ "Score " }{ FormatInt(int(item.RiskScore)) }</div>
			</div>
		</div>
		<div class="mt-2 flex flex-wrap items-center gap-2">
			<span class={ DiscoveryManagedBadgeClass(item.ManagedState) }>{ HumanizeDiscoveryManagedState(item.ManagedState) }</span>
			<span class={ DiscoveryReviewDispositionBadgeClass(item.ReviewDisposition) }>{ HumanizeDiscoveryReviewDisposition(item.ReviewDisposition) }</span>
			if item.TicketRef != "" {
				<span class="badge-outline">{ item.TicketRef }</span>
			}
			if item.FollowUpDueDate.Label != "" {
				<span class={ DiscoveryFollowUpBadgeClass(item.IsFollowUpOverdue) }>{ DiscoveryFollowUpLabel(item.FollowUpDueDate.Label, item.IsFollowUpOverdue) }</span>
			}
		</div>
		<div class="mt-2 text-sm text-muted-foreground">{ HumanizeDiscoveryManagedReason(item.ManagedReason) }</div>
		<div class="mt-3 grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
			<div>
				<div class="text-xs uppercase tracking-wide text-muted-foreground">Owner</div>
				<div class="osspm-truncate" title={ item.Owner }>{ item.Owner }</div>
			</div>
			<div>
				<div class="text-xs uppercase tracking-wide text-muted-foreground">Actors (30d)</div>
				<div>{ FormatInt64(item.Actors30d) }</div>
			</div>
			<div>
				<div class="text-xs uppercase tracking-wide text-muted-foreground">Last seen</div>
				<div>{ item.LastSeen.Label }</div>
			</div>
			<div>
				<div class="text-xs uppercase tracking-wide text-muted-foreground">Review</div>
				if item.ReviewOwner != "—" {
					<div class="osspm-truncate" title={ item.ReviewOwner }>{ item.ReviewOwner }</div>
				} else {
					<div class="text-muted-foreground">—</div>
				}
			</div>
		</div>
		if item.ReplacementDisplayName != "" {
			<div class="mt-3 border-t border-border/60 pt-3 text-sm">
				<div class="text-xs uppercase tracking-wide text-muted-foreground">Replacement</div>
				<div class="osspm-truncate" title={ item.ReplacementDisplayName }>{ item.ReplacementDisplayName }</div>
			</div>
		}
		<div class="mt-3 border-t border-border/60 pt-3">
			<a class="btn-sm-link px-0" href={ "/discovery/apps/" + FormatInt64(item.ID) } aria-label={ "View details for " + item.DisplayName }>View details</a>
		</div>
	</article>
}

templ DiscoveryAppsPageResults(data viewmodels.DiscoveryAppsViewData) {
	<div id="discovery-apps-results" class="space-y-6">
		@BusyInlineIndicator("Updating results...", false)
		<form
			method="get"
			action="/discovery/apps"
			data-enter-only-query="q"
			hx-get="/discovery/apps"
			hx-trigger="change delay:150ms from:select, submit"
			hx-target="#discovery-apps-results"
			hx-swap="outerHTML"
			hx-push-url="true"
				class="osspm-list-form"
			>
					<div class="osspm-list-toolbar">
						<div class="flex flex-1 items-center gap-2 lg:max-w-xl">
							<label class="field flex-1">
								<span class="sr-only">Query</span>
								<div class="relative">
									<input type="search" name="q" class="input pr-10" placeholder="Search name, domain, vendor, or key" value={ data.Query.Q }/>
									if data.Query.Q != "" {
										<a class="btn-icon-ghost absolute right-2 top-1/2 -translate-y-1/2" aria-label="Clear query" href={ data.Query.ClearQuery().Href() } hx-get={ data.Query.ClearQuery().Href() } hx-target="#discovery-apps-results" hx-swap="outerHTML" hx-push-url="true">
											<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
												<path fill-rule="evenodd" d="M4.293 4.293a1 1 0 0 1 1.414 0L10 8.586l4.293-4.293a1 1 0 1 1 1.414 1.414L11.414 10l4.293 4.293a1 1 0 0 1-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 0 1-1.414-1.414L8.586 10 4.293 5.707a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"></path>
											</svg>
										</a>
									}
								</div>
							</label>
							@FilterPopover("Filters", data.Query.FilterCount(), data.Query.FilterCount() > 0, "w-[min(92vw,36rem)] space-y-4") {
								<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
									<label class="field">
										<span class="label">Source kind</span>
										<select class="select" name="source_kind">
											<option value="" selected?={ data.Query.Source.Kind == "" }>All configured</option>
											for _, source := range data.SourceOptions {
												<option value={ source.SourceKind } selected?={ source.SourceKind == data.Query.Source.Kind } title={ source.Label }>{ source.Label }</option>
											}
										</select>
									</label>
									<label class="field">
										<span class="label">Managed state</span>
										<select class="select" name="managed_state">
											<option value="" selected?={ data.Query.ManagedState == "" }>Any</option>
											<option value="managed" selected?={ data.Query.ManagedState == "managed" }>Managed</option>
											<option value="unmanaged" selected?={ data.Query.ManagedState == "unmanaged" }>Unmanaged</option>
										</select>
									</label>
									<label class="field">
										<span class="label">Risk level</span>
										<select class="select" name="risk_level">
											<option value="" selected?={ data.Query.RiskLevel == "" }>Any</option>
											<option value="critical" selected?={ data.Query.RiskLevel == "critical" }>Critical</option>
											<option value="high" selected?={ data.Query.RiskLevel == "high" }>High</option>
											<option value="medium" selected?={ data.Query.RiskLevel == "medium" }>Medium</option>
											<option value="low" selected?={ data.Query.RiskLevel == "low" }>Low</option>
										</select>
									</label>
								</div>
								if data.Query.FilterCount() > 0 {
									<div class="border-t border-border/60 pt-3">
										<a class="text-xs text-muted-foreground no-underline hover:text-foreground" href={ data.Query.ClearFilters().Href() } hx-get={ data.Query.ClearFilters().Href() } hx-target="#discovery-apps-results" hx-swap="outerHTML" hx-push-url="true">Clear all filters</a>
									</div>
								}
							}
						</div>
						<div class="osspm-list-summary">
							if data.TotalCount > 0 {
								{ "Showing " }{ FormatInt(data.ShowingFrom) }{ "-" }{ FormatInt(data.ShowingTo) }{ " of " }{ FormatInt64(data.TotalCount) }
							} else {
								Showing 0
							}
						</div>
					</div>
				<button class="sr-only" type="submit">Apply filters</button>
			</form>

			<section class="space-y-3">
					<div class="osspm-list-section-header">
					<div>
						<h2 class="text-base font-semibold">Discovered Apps</h2>
						<p class="text-sm text-muted-foreground">Discovered SaaS inventory from IdP SSO and OAuth evidence.</p>
					</div>
				</div>
				if data.HasItems {
					<div class="space-y-3 lg:hidden">
						for _, item := range data.Items {
							@DiscoveryAppMobileRow(item)
						}
					</div>
				} else {
					<div class="lg:hidden">
						@EmptyState("No discovery apps found", data.EmptyStateMsg)
					</div>
				}
				@ColumnsTable("hidden lg:block") {
						<table class="table osspm-table-fixed osspm-table-compact osspm-table-list">
							<caption class="sr-only">Discovered SaaS applications with managed state and risk posture.</caption>
						<thead>
							<tr>
								<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">App</th>
								<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Managed</th>
								<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Risk</th>
								<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Owner</th>
								<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Governance</th>
								<th class="osspm-num text-xs font-medium uppercase tracking-wide text-muted-foreground">Actors (30d)</th>
								<th class="osspm-num text-xs font-medium uppercase tracking-wide text-muted-foreground">Last seen</th>
							</tr>
						</thead>
							<tbody>
								if data.HasItems {
									for _, item := range data.Items {
										<tr data-row-href={ "/discovery/apps/" + FormatInt64(item.ID) } class="cursor-pointer hover:bg-muted/50">
											<td>
												<a class="btn-sm-link px-0 osspm-cell-primary osspm-truncate" href={ "/discovery/apps/" + FormatInt64(item.ID) } title={ item.DisplayName }>{ item.DisplayName }</a>
												if item.Domain != "" {
													<span class="osspm-cell-secondary osspm-token" title={ item.Domain }>{ item.Domain }</span>
												}
												if item.VendorName != "" {
													<span class="osspm-cell-secondary osspm-truncate" title={ item.VendorName }>{ item.VendorName }</span>
												}
											</td>
											<td>
												<span class={ DiscoveryManagedBadgeClass(item.ManagedState) }>{ HumanizeDiscoveryManagedState(item.ManagedState) }</span>
												<span class="osspm-cell-secondary">{ HumanizeDiscoveryManagedReason(item.ManagedReason) }</span>
											</td>
											<td>
												<span class={ CredentialRiskBadgeClass(item.RiskLevel) }>{ HumanizeCredentialRisk(item.RiskLevel) }</span>
												<span class="osspm-cell-secondary">{ FormatInt(int(item.RiskScore)) }</span>
											</td>
											<td><span class="osspm-truncate" title={ item.Owner }>{ item.Owner }</span></td>
											<td class="whitespace-normal">
												<div class="flex flex-wrap items-center gap-2">
													<span class={ DiscoveryReviewDispositionBadgeClass(item.ReviewDisposition) }>{ HumanizeDiscoveryReviewDisposition(item.ReviewDisposition) }</span>
													if item.TicketRef != "" {
														<span class="badge-outline">{ item.TicketRef }</span>
													}
													if item.FollowUpDueDate.Label != "" {
														<span class={ DiscoveryFollowUpBadgeClass(item.IsFollowUpOverdue) }>{ DiscoveryFollowUpLabel(item.FollowUpDueDate.Label, item.IsFollowUpOverdue) }</span>
													}
												</div>
												if item.ReviewOwner != "—" {
													<div class="osspm-cell-secondary">{ "Review: " }{ item.ReviewOwner }</div>
												}
												if item.ReplacementDisplayName != "" {
													<div class="osspm-cell-secondary">{ "Replace with " }{ item.ReplacementDisplayName }</div>
												}
											</td>
											<td class="osspm-num"><span class="badge-outline">{ FormatInt64(item.Actors30d) }</span></td>
											<td class="osspm-num text-muted-foreground">{ item.LastSeen.Label }</td>
										</tr>
									}
								} else {
								<tr>
									<td colspan="7">
										@EmptyState("No discovery apps found", data.EmptyStateMsg)
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
				if data.TotalPages > 1 {
						<div class="osspm-list-pagination">
						<div class="text-sm text-muted-foreground">{ "Page " }{ FormatInt(data.Page) }{ " of " }{ FormatInt(data.TotalPages) }</div>
						<div class="button-group ml-auto">
							if data.Page > 1 {
								<a class="btn-sm-outline" href={ data.Query.WithPage(data.Page-1).Href() } hx-get={ data.Query.WithPage(data.Page-1).Href() } hx-target="#discovery-apps-results" hx-swap="outerHTML" hx-push-url="true">Previous</a>
							} else {
								<span class="btn-sm-outline opacity-50" aria-disabled="true">Previous</span>
							}
							if data.Page < data.TotalPages {
								<a class="btn-sm-outline" href={ data.Query.WithPage(data.Page+1).Href() } hx-get={ data.Query.WithPage(data.Page+1).Href() } hx-target="#discovery-apps-results" hx-swap="outerHTML" hx-push-url="true">Next</a>
							} else {
								<span class="btn-sm-outline opacity-50" aria-disabled="true">Next</span>
							}
						</div>
					</div>
				}
		</section>
	</div>
}
