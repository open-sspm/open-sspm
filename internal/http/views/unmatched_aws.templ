package views

import "github.com/open-sspm/open-sspm/internal/http/viewmodels"

templ UnmatchedAWSPage(data viewmodels.UnmatchedAWSViewData) {
	@Layout(data.Layout) {
		@PageHeader("") {
			if data.Layout.AWSIdentityCenterConfigured {
				<span class="badge-outline">{ data.Layout.AWSIdentityCenterName }</span>
			} else {
				<span class="badge-outline">Not configured</span>
			}
			<a class="btn-sm-outline" href="/identities">Identities</a>
		}

		if data.Layout.AWSIdentityCenterConfigured && data.Layout.AWSIdentityCenterEnabled {
			@Alert("Manual linking", false) {
				<p>
					Open-SSPM will auto-link identities by email when possible. Use this list to link users with missing or mismatched emails.
				</p>
			}
		} else {
			@Alert("AWS Identity Center sync disabled", true) {
				<p>
					{ data.EmptyStateMsg } <a class="btn-sm-link px-1" href={ data.EmptyStateHref }>Configure AWS Identity Center</a>.
				</p>
			}
		}

			<form method="get" class="osspm-list-form">
				<div class="osspm-list-toolbar">
				<div class="min-w-0 flex-1">
					@TableQueryBar(SearchOnlyBasicListQueryBar(data.Query, "Search email, name, or user ID"))
				</div>
					<div class="osspm-list-summary">
					if data.TotalCount > 0 {
						{ "Showing " }{ FormatInt(data.ShowingFrom) }{ "-" }{ FormatInt(data.ShowingTo) }{ " of " }{ FormatInt64(data.TotalCount) }
					} else {
						Showing 0
					}
				</div>
			</div>
			<button class="sr-only" type="submit">Apply filters</button>
		</form>

		<section class="space-y-3">
				<div class="osspm-list-section-header">
				<div>
					<h2 class="text-base font-semibold">Unlinked AWS Identity Center users</h2>
					<p class="text-sm text-muted-foreground">Unlinked AWS Identity Center users awaiting identity linking.</p>
				</div>
			</div>
			@ColumnsTable("") {
			<table class="table osspm-table-fixed osspm-table-compact osspm-table-list">
				<caption class="sr-only">Unlinked AWS Identity Center users and actions to link each user to an identity.</caption>
				<thead>
					<tr>
						<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">User</th>
						<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Email</th>
						<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">User ID</th>
						<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Link</th>
					</tr>
				</thead>
					<tbody>
						if data.HasUsers {
							for _, u := range data.Users {
								<tr>
									<td class="font-medium">{ u.DisplayName }</td>
									<td>
										if u.Email != "" {
											{ u.Email }
										} else {
											<span class="text-muted-foreground">&mdash;</span>
										}
									</td>
									<td class="text-muted-foreground">{ u.ExternalID }</td>
									<td>
										if data.Layout.IsAdmin {
											<form method="post" action="/links" class="flex flex-col gap-2 sm:flex-row sm:items-end">
												@CSRFInput(data.Layout.CSRFToken)
												<input type="hidden" name="account_id" value={ FormatInt64(u.ID) }/>
												<label class="field w-full sm:w-32">
													<span class="label sr-only">Identity ID</span>
													<input type="text" name="identity_id" placeholder="Identity ID" required class="input w-full"/>
												</label>
												<button type="submit" class="btn-sm-primary w-full sm:w-auto">Link</button>
											</form>
										} else {
											<span class="text-sm text-muted-foreground">Admin required</span>
										}
									</td>
								</tr>
							}
						} else if data.Layout.AWSIdentityCenterConfigured && data.Layout.AWSIdentityCenterEnabled && data.Query.Q == "" {
							<tr>
								<td colspan="4">
									@EmptyState("All caught up", "No unlinked AWS Identity Center users found. All detected identities are linked.")
								</td>
							</tr>
						} else {
							<tr>
								<td colspan="4">
									@EmptyState("No unlinked users", data.EmptyStateMsg)
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
			if data.TotalPages > 1 {
					<div class="osspm-list-pagination">
						<div class="text-sm text-muted-foreground">{ "Page " }{ FormatInt(data.Page) }{ " of " }{ FormatInt(data.TotalPages) }</div>
						<div class="button-group ml-auto">
							if data.Page > 1 {
								<a class="btn-sm-outline" href={ data.Query.WithPage(data.Page-1).Href() }>Previous</a>
							} else {
								<span class="btn-sm-outline opacity-50" aria-disabled="true">Previous</span>
							}
							if data.Page < data.TotalPages {
								<a class="btn-sm-outline" href={ data.Query.WithPage(data.Page+1).Href() }>Next</a>
							} else {
								<span class="btn-sm-outline opacity-50" aria-disabled="true">Next</span>
							}
					</div>
				</div>
			}
		</section>
	}
}
