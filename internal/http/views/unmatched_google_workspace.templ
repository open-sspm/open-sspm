package views

import "github.com/open-sspm/open-sspm/internal/http/viewmodels"

templ UnmatchedGoogleWorkspacePage(data viewmodels.UnmatchedGoogleWorkspaceViewData) {
	@Layout(data.Layout) {
		@PageHeader("") {
			if data.Layout.GoogleWorkspaceConfigured {
				<span class="badge-outline cursor-help" title={ "Customer ID: " + data.Layout.GoogleWorkspaceCustomerID }>Google customer</span>
			} else {
				<span class="badge-outline">Not configured</span>
			}
			<a class="btn-sm-outline" href="/identities">Identities</a>
		}

		if data.Layout.GoogleWorkspaceConfigured && data.Layout.GoogleWorkspaceEnabled {
			@Alert("Manual linking", false) {
				<p>Use this list to link users when automatic email matching cannot infer identity ownership.</p>
			}
		} else {
			@Alert("Google Workspace sync disabled", true) {
				<p>
					{ data.EmptyStateMsg } <a class="btn-sm-link px-1" href={ data.EmptyStateHref }>Configure Google Workspace</a>.
				</p>
			}
		}

		@UnmatchedGoogleWorkspacePageResults(data)
	}
}

templ UnmatchedGoogleWorkspacePageResults(data viewmodels.UnmatchedGoogleWorkspaceViewData) {
	<div id="unmatched-google-workspace-results" class="space-y-5">
		@BusyInlineIndicator("Updating results...", false)
		<form
			method="get"
			action="/accounts/unlinked/google-workspace"
			data-enter-only-query="q"
			hx-get="/accounts/unlinked/google-workspace"
			hx-trigger="change delay:150ms from:[data-table-query-trigger], submit"
			hx-target="#unmatched-google-workspace-results"
			hx-swap="outerHTML"
			hx-push-url="true"
			class="osspm-list-form"
		>
			<div class="osspm-list-toolbar">
				<div class="min-w-0 flex-1">
					@TableQueryBar(SearchOnlyBasicListQueryBar(data.Query, "Search email, name, or Google user ID"))
				</div>
				<div class="osspm-list-summary">
					if data.TotalCount > 0 {
						{ "Showing " }{ FormatInt(data.ShowingFrom) }{ "-" }{ FormatInt(data.ShowingTo) }{ " of " }{ FormatInt64(data.TotalCount) }
					} else {
						Showing 0
					}
				</div>
			</div>
			<button class="sr-only" type="submit">Apply filters</button>
		</form>

		<section class="space-y-3">
			@ListSectionHeader("Unlinked Google Workspace users", "Unlinked Google Workspace users awaiting identity linking.")
			@ColumnsTable("") {
				<table class="table osspm-table-fixed osspm-table-compact osspm-table-list">
					<caption class="sr-only">Unlinked Google Workspace users with linking actions.</caption>
					<thead>
						<tr>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">User</th>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Email</th>
							<th class="osspm-col-id-wide text-xs font-medium uppercase tracking-wide text-muted-foreground">User ID</th>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Link</th>
						</tr>
					</thead>
					<tbody>
						if data.HasUsers {
							for _, u := range data.Users {
								<tr>
									<td class="font-medium"><span class="osspm-cell-primary osspm-truncate" title={ u.DisplayName }>{ u.DisplayName }</span></td>
									<td>
										if u.Email != "" {
											<span class="osspm-cell-primary osspm-truncate" title={ u.Email }>{ u.Email }</span>
										} else {
											<span class="text-muted-foreground">&mdash;</span>
										}
									</td>
									<td class="osspm-col-id-wide text-muted-foreground"><code class="osspm-token" title={ u.ExternalID }>{ u.ExternalID }</code></td>
									<td>
										if data.Layout.IsAdmin {
											<form method="post" action="/links" class="flex flex-col gap-2 sm:flex-row sm:items-end">
												@CSRFInput(data.Layout.CSRFToken)
												<input type="hidden" name="account_id" value={ FormatInt64(u.ID) }/>
												<label class="field w-full sm:w-32">
													<span class="label sr-only">Identity ID</span>
													<input type="text" name="identity_id" placeholder="Identity ID" required class="input w-full osspm-token"/>
												</label>
												<button type="submit" class="btn-sm-primary w-full sm:w-auto">Link</button>
											</form>
										} else {
											<span class="text-sm text-muted-foreground">Admin required</span>
										}
									</td>
								</tr>
							}
						} else if data.Layout.GoogleWorkspaceConfigured && data.Layout.GoogleWorkspaceEnabled && data.Query.Q == "" {
							<tr>
								<td colspan="4">
									@EmptyState("All caught up", "No unlinked Google Workspace users found. All detected identities are linked.")
								</td>
							</tr>
						} else {
							<tr>
								<td colspan="4">
									@EmptyState("No unlinked users", data.EmptyStateMsg)
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
			if data.TotalPages > 1 {
				@ListPagination("unmatched-google-workspace-results", data.Page, data.TotalPages, data.Query.WithPage(data.Page-1).Href(), data.Query.WithPage(data.Page+1).Href())
			}
		</section>
	</div>
}
