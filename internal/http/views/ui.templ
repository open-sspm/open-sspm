package views

import "github.com/open-sspm/open-sspm/internal/http/viewmodels"

templ PageHeader(description string) {
	<div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
		if description != "" {
			<div class="space-y-2">
				<p class="text-muted-foreground">{ description }</p>
			</div>
		}
		<div class="flex flex-wrap items-center justify-start gap-2 md:ml-auto md:justify-end empty:hidden">
			{ children... }
		</div>
	</div>
}

templ Alert(title string, destructive bool) {
	<div
		role={ AlertRole(destructive) }
		aria-live={ AlertAriaLive(destructive) }
		aria-atomic="true"
		class={ templ.Classes("alert", templ.KV("alert-destructive", destructive)) }
	>
		if title != "" {
			<h3>{ title }</h3>
		}
		<section class="empty:hidden">
			{ children... }
		</section>
	</div>
}

templ EmptyState(title, description string) {
	<div class="flex flex-col items-center justify-center gap-2 py-12 text-center">
		@IconInfo("size-4 text-muted-foreground")
		<h2 class="text-lg font-semibold">{ title }</h2>
		if description != "" {
			<p class="max-w-md text-muted-foreground">{ description }</p>
		}
		<div class="pt-2 empty:hidden">
			{ children... }
		</div>
	</div>
}

templ BusyInlineIndicator(label string, initiallyVisible bool) {
	<div
		data-busy-inline-indicator
		data-busy-inline-indicator-active?={ initiallyVisible }
		role="status"
		aria-live="polite"
		aria-atomic="true"
		class="items-center gap-2 text-xs text-muted-foreground"
	>
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-3.5 w-3.5 animate-spin" aria-hidden="true">
			<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" fill="none" class="opacity-25"></circle>
			<path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round" fill="none" class="opacity-90"></path>
		</svg>
		<span>{ label }</span>
	</div>
}

templ ListSectionHeader(title, description string) {
	<div class="osspm-list-section-header">
		<div>
			<h2 class="text-base font-semibold">{ title }</h2>
			if description != "" {
				<p class="text-sm text-muted-foreground">{ description }</p>
			}
		</div>
	</div>
}

templ ListPagination(targetID string, page, totalPages int, hrefForPage func(int) string) {
	<div class="osspm-list-pagination">
		<div class="text-sm text-muted-foreground">{ "Page " }{ FormatInt(page) }{ " of " }{ FormatInt(totalPages) }</div>
		<div class="button-group ml-auto">
			if page > 1 {
				{{ prevHref := hrefForPage(page - 1) }}
				<a class="btn-sm-outline" href={ prevHref } hx-get={ prevHref } hx-target={ "#" + targetID } hx-swap="outerHTML" hx-push-url="true">Previous</a>
			} else {
				<span class="btn-sm-outline opacity-50" aria-disabled="true">Previous</span>
			}
			if page < totalPages {
				{{ nextHref := hrefForPage(page + 1) }}
				<a class="btn-sm-outline" href={ nextHref } hx-get={ nextHref } hx-target={ "#" + targetID } hx-swap="outerHTML" hx-push-url="true">Next</a>
			} else {
				<span class="btn-sm-outline opacity-50" aria-disabled="true">Next</span>
			}
		</div>
	</div>
}

templ TableCard(title, description string) {
	<article class="card min-w-0">
		if title != "" || description != "" {
			<header>
				if title != "" {
					<h2>{ title }</h2>
				}
				if description != "" {
					<p>{ description }</p>
				}
			</header>
		}
		<section class="min-w-0">
			<div class="min-w-0 overflow-x-auto">
				{ children... }
			</div>
		</section>
	</article>
}

templ ColumnsTable(containerClass string) {
	<div class={ templ.Classes("min-w-0", templ.KV(containerClass, containerClass != "")) }>
		<div class="min-w-0 overflow-x-auto">
			{ children... }
		</div>
	</div>
}

templ FilterPopover(label string, activeCount int, open bool, panelClass string) {
	<details class="relative osspm-filters-disclosure" open?={ open }>
		<summary class="osspm-filter-summary">
			@IconFilter("h-4 w-4 text-muted-foreground")
			<span>{ label }</span>
			if activeCount > 0 {
				<span class="flex h-5 min-w-5 items-center justify-center rounded-full bg-primary px-1 text-[11px] font-medium text-primary-foreground">
					{ FormatInt(activeCount) }
				</span>
			}
		</summary>
		<div class={ templ.Classes("filter-popover osspm-filter-panel-popover", templ.KV(panelClass, panelClass != "")) }>
			{ children... }
		</div>
	</details>
}

templ TableQueryBar(data viewmodels.TableQueryBarData) {
	<div class="osspm-table-query-bar" data-table-query-bar>
		<div class="osspm-table-query-bar-row">
			if data.HasSearch() {
				<label class="field osspm-table-query-bar-search">
					<span class="sr-only">Query</span>
					<div class="relative">
						<input
							type="search"
							name={ data.Search.Name }
							value={ data.Search.Value }
							placeholder={ data.Search.Placeholder }
							class="input pr-10"
						/>
						if data.Search.Value != "" {
							<button
								type="button"
								class="btn-icon-ghost absolute right-2 top-1/2 -translate-y-1/2"
								aria-label="Clear query"
								data-table-query-clear-search
							>
								@IconX("size-4")
							</button>
						}
					</div>
				</label>
			}
			<div class="osspm-table-query-actions">
				if data.HasActiveFilters() {
					<button type="button" class="btn-sm-ghost osspm-table-query-clear" data-table-query-clear-filters>Clear filters</button>
				}
				if data.HasAddFilter() {
					<button
						type="button"
						class="btn-sm-outline osspm-table-query-add"
						aria-expanded="false"
						aria-haspopup="dialog"
						data-table-query-add-trigger
					>+ Add filter</button>
				}
			</div>
		</div>
		if len(data.Fields) > 0 {
			<div class="osspm-table-query-chip-list" data-table-query-chip-list>
				for _, chip := range data.ActiveChips {
					<div class="osspm-table-query-chip" data-table-query-chip data-field-id={ chip.FieldID }>
						<button
							type="button"
							class="osspm-table-query-chip-trigger"
							aria-expanded="false"
							aria-haspopup="dialog"
							data-table-query-chip-trigger
							data-field-id={ chip.FieldID }
						>
							<span>{ chip.Label }</span>
						</button>
						<button
							type="button"
							class="osspm-table-query-chip-remove"
							aria-label={ "Remove " + chip.Label }
							data-table-query-chip-remove
							data-field-id={ chip.FieldID }
						>
							@IconX("size-3.5")
						</button>
					</div>
				}
			</div>
		}
		<div class="hidden" aria-hidden="true" data-table-query-controls data-table-query-trigger>
			for _, control := range data.HiddenControls {
				<input type="hidden" name={ control.Name } value={ control.Value } data-table-query-control data-table-query-control-name={ control.Name }/>
			}
		</div>
		<div class="hidden" aria-hidden="true" data-table-query-fields>
			for _, field := range data.Fields {
				<div
					data-table-query-field
					data-field-id={ field.ID }
					data-field-label={ field.Label }
					data-field-kind={ string(field.Kind) }
					data-field-active-value={ field.ActiveValue }
					data-field-picker-visible?={ field.PickerVisible }
				>
					for _, inputName := range field.InputNames {
						<input type="hidden" value={ inputName } data-table-query-input-name/>
					}
					for _, option := range field.Options {
						<div data-table-query-option data-option-value={ option.Value } data-option-label={ option.Label }>
							for _, control := range option.Controls {
								<input type="hidden" value={ control.Value } data-table-query-option-control data-control-name={ control.Name }/>
							}
						</div>
					}
				</div>
			}
		</div>
		if data.HasAddFilter() {
			<div class="osspm-table-query-floating osspm-table-query-picker" hidden data-table-query-picker data-state="closed" role="dialog" aria-label="Add filter">
				<div class="osspm-table-query-picker-search">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 text-muted-foreground" aria-hidden="true">
						<path fill-rule="evenodd" d="M8.5 3a5.5 5.5 0 1 0 3.473 9.765l3.63 3.631a1 1 0 0 0 1.414-1.414l-3.63-3.63A5.5 5.5 0 0 0 8.5 3Zm-4 5.5a4 4 0 1 1 8 0 4 4 0 0 1-8 0Z" clip-rule="evenodd"></path>
					</svg>
					<input type="search" placeholder="Filter by..." data-table-query-picker-search-input/>
				</div>
				<div class="osspm-table-query-picker-list" data-table-query-picker-list>
					for _, field := range data.Fields {
						if field.PickerVisible {
							<button type="button" class="osspm-table-query-picker-item" data-table-query-picker-item data-field-id={ field.ID }>
								<span class="osspm-table-query-picker-item-label">{ field.Label }</span>
								<span class="osspm-table-query-picker-item-action">Add</span>
							</button>
						}
					}
				</div>
			</div>
		}
		if len(data.Fields) > 0 {
			<div class="osspm-table-query-floating osspm-table-query-editor" hidden data-table-query-editor data-state="closed" role="dialog" aria-label="Edit filter">
				<div class="osspm-table-query-editor-header">
					<h3 class="osspm-table-query-editor-title" data-table-query-editor-title></h3>
					<button type="button" class="btn-icon-ghost osspm-table-query-editor-close" aria-label="Close" data-table-query-editor-close>
						@IconX("size-4")
					</button>
				</div>
				<label class="field">
					<span class="sr-only">Filter value</span>
					<select class="select" data-table-query-editor-select></select>
				</label>
			</div>
		}
	</div>
}

templ CSRFInput(token string) {
	<input type="hidden" name="csrf" value={ token }/>
}

templ CopyTextButton(value string, label string) {
	if CopyableValue(value) {
		<button
			type="button"
			class="btn-icon-ghost h-5 w-5 shrink-0 rounded-sm"
			aria-label={ label }
			title={ label }
			data-copy-text={ value }
			data-copy-label={ label }
		>
			@IconCopy("size-3.5")
		</button>
	}
}

templ FormDialog(id string, open bool, title string, description string, closeHref string, formAction string, submitLabel string, csrfToken string) {
	<dialog id={ id } class="dialog" data-open?={ open } data-close-href={ closeHref } aria-labelledby={ id + "-title" } aria-describedby={ id + "-description" }>
		<form method="post" action={ formAction }>
			@CSRFInput(csrfToken)
			<button type="button" class="btn-icon-ghost" aria-label="Close" data-dialog-close>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
					<path fill-rule="evenodd" d="M4.293 4.293a1 1 0 0 1 1.414 0L10 8.586l4.293-4.293a1 1 0 1 1 1.414 1.414L11.414 10l4.293 4.293a1 1 0 0 1-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 0 1-1.414-1.414L8.586 10 4.293 5.707a1 1 0 0 1 0-1.414Z" clip-rule="evenodd"/>
				</svg>
			</button>
			<header>
				<h2 id={ id + "-title" }>{ title }</h2>
				<p id={ id + "-description" } class={ templ.Classes(templ.KV("sr-only", description == "")) }>{ description }</p>
			</header>
			<section class="space-y-4">
				{ children... }
			</section>
			<footer>
				<button type="button" class="btn-ghost" data-dialog-close>Cancel</button>
				<button type="submit" class="btn-primary">{ submitLabel }</button>
			</footer>
		</form>
	</dialog>
}
