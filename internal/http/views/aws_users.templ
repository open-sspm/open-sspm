package views

import "github.com/open-sspm/open-sspm/internal/http/viewmodels"

templ AWSUserMobileRow(user viewmodels.AWSUserListItem) {
	<article class="rounded-lg border border-border/70 bg-card p-4">
		<div class="flex items-start justify-between gap-3">
			<div class="min-w-0">
				<div class="font-medium" title={ user.DisplayName }>
					<span class="osspm-truncate">{ user.DisplayName }</span>
				</div>
				if user.Email != "" {
					<div class="text-sm text-muted-foreground break-all">{ user.Email }</div>
				} else if user.ExternalID != "" {
					<div class="text-sm text-muted-foreground break-all">{ user.ExternalID }</div>
				}
			</div>
		</div>
		<div class="mt-3 grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
			<div>
				<div class="text-xs uppercase tracking-wide text-muted-foreground">AWS accounts</div>
				<div><span class="badge-outline">{ FormatInt(user.AccountCount) }</span></div>
			</div>
			<div>
				<div class="text-xs uppercase tracking-wide text-muted-foreground">Assignments</div>
				<div>{ FormatInt(user.AssignmentCount) }</div>
			</div>
			<div class="col-span-2">
				<div class="text-xs uppercase tracking-wide text-muted-foreground">Identity</div>
				if user.IdentityID > 0 {
					<a class="btn-sm-link px-0" href={ "/identities/" + FormatInt64(user.IdentityID) }>{ "Identity #" }{ FormatInt64(user.IdentityID) }</a>
				} else {
					<div class="text-muted-foreground">—</div>
				}
			</div>
		</div>
	</article>
}

templ AWSUsersPage(data viewmodels.AWSUsersViewData) {
	@Layout(data.Layout) {
		@PageHeader("") {
			if data.Layout.AWSIdentityCenterConfigured && data.Layout.AWSIdentityCenterEnabled {
				<a class="btn-sm-outline" href="/accounts/unlinked/aws">Unlinked</a>
			} else {
				<a class="btn-sm-outline" href="/settings/connectors?open=aws_identity_center">Configure</a>
			}
		}

		if data.Layout.AWSIdentityCenterConfigured && data.Layout.AWSIdentityCenterEnabled {
			@Alert("Linking", false) {
				<p>
					Linked users let you jump straight to their identity page. Unlinked users show “—”. Use
					<a class="btn-sm-link px-1" href="/accounts/unlinked/aws">Unlinked</a>
					to link.
				</p>
			}
		} else {
			@Alert("AWS Identity Center sync disabled", true) {
				<p>
					{ data.EmptyStateMsg } <a class="btn-sm-link px-1" href={ data.EmptyStateHref }>Configure AWS Identity Center</a>.
				</p>
			}
		}

		@AWSUsersPageResults(data)
	}
}

templ AWSUsersPageResults(data viewmodels.AWSUsersViewData) {
	<div id="aws-users-results" class="space-y-5">
		@BusyInlineIndicator("Updating results...", false)
		<form
			method="get"
			action="/accounts/aws"
			data-enter-only-query="q"
			hx-get="/accounts/aws"
			hx-trigger="change delay:150ms from:[data-table-query-trigger], submit"
			hx-target="#aws-users-results"
			hx-swap="outerHTML"
			hx-push-url="true"
			class="osspm-list-form"
		>
			<div class="osspm-list-toolbar">
				<div class="min-w-0 flex-1">
					@TableQueryBar(SearchOnlyBasicListQueryBar(data.Query, "Search email, name, or user ID"))
				</div>
				<div class="osspm-list-summary">
					if data.TotalCount > 0 {
						{ "Showing " }{ FormatInt(data.ShowingFrom) }{ "-" }{ FormatInt(data.ShowingTo) }{ " of " }{ FormatInt64(data.TotalCount) }
					} else {
						Showing 0
					}
				</div>
			</div>
			<button class="sr-only" type="submit">Apply filters</button>
		</form>

		<section class="space-y-3">
			@ListSectionHeader("AWS Identity Center users", "AWS Identity Center users and their account assignments.")
			if data.HasUsers {
				<div class="space-y-3 lg:hidden">
					for _, u := range data.Users {
						@AWSUserMobileRow(u)
					}
				</div>
			} else {
				<div class="lg:hidden">
					@EmptyState("No users found", data.EmptyStateMsg)
				</div>
			}
			@ColumnsTable("hidden lg:block") {
				<table class="table osspm-table-fixed osspm-table-compact osspm-table-list">
					<caption class="sr-only">AWS Identity Center users with account assignment counts and linked identities.</caption>
					<thead>
						<tr>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">User</th>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Email</th>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">AWS accounts</th>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Identity</th>
						</tr>
					</thead>
					<tbody>
						if data.HasUsers {
							for _, u := range data.Users {
								<tr>
									<td>
										<div class="space-y-1">
											<div class="font-medium">{ u.DisplayName }</div>
											if u.ExternalID != "" {
												<div class="text-xs text-muted-foreground">{ u.ExternalID }</div>
											}
										</div>
									</td>
									<td>
										if u.Email != "" {
											{ u.Email }
										} else {
											<span class="text-muted-foreground">&mdash;</span>
										}
									</td>
									<td>
										<div class="space-y-1">
											<span class="badge-outline">{ FormatInt(u.AccountCount) }</span>
											<span class="block text-xs text-muted-foreground">{ FormatInt(u.AssignmentCount) }{ " assignments" }</span>
										</div>
									</td>
									<td>
										if u.IdentityID > 0 {
											<a class="btn-sm-link" href={ "/identities/" + FormatInt64(u.IdentityID) }>{ "Identity #" }{ FormatInt64(u.IdentityID) }</a>
										} else {
											<span class="text-muted-foreground">&mdash;</span>
										}
									</td>
								</tr>
							}
						} else {
							<tr>
								<td colspan="4">
									@EmptyState("No users found", data.EmptyStateMsg)
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
			if data.TotalPages > 1 {
				@ListPagination("aws-users-results", data.Page, data.TotalPages, data.Query.WithPage(data.Page-1).Href(), data.Query.WithPage(data.Page+1).Href())
			}
		</section>
	</div>
}
