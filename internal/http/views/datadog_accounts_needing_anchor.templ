package views

import "github.com/open-sspm/open-sspm/internal/http/viewmodels"

templ DatadogAccountsNeedingAnchorPage(data viewmodels.DatadogAccountsNeedingAnchorViewData) {
	@Layout(data.Layout) {
		@PageHeader("") {
			if data.Layout.DatadogConfigured {
				<span class="badge-outline">{ data.Layout.DatadogSite }</span>
			} else {
				<span class="badge-outline">Not configured</span>
			}
			<a class="btn-sm-outline" href="/identities">Identities</a>
		}
		if data.Layout.DatadogConfigured && data.Layout.DatadogEnabled {
			@Alert("Manual anchoring", false) {
				<p>
					Use identity IDs from the Identities list. Most Datadog users have an email that matches Okta, so auto-anchoring should cover the majority of cases.
				</p>
			}
		} else {
			@Alert("Datadog sync disabled", true) {
				<p>
					{ data.EmptyStateMsg } @ConnectorConfigureLink(data.EmptyStateHref, "btn-sm-link px-1") {
						Configure Datadog
					}.
				</p>
			}
		}
		@DatadogAccountsNeedingAnchorPageFilters(data)
		@DatadogAccountsNeedingAnchorPageResults(data)
	}
}

templ DatadogAccountsNeedingAnchorPageFilters(data viewmodels.DatadogAccountsNeedingAnchorViewData) {
	<form
		method="get"
		action={ "/accounts/needs-anchor/datadog/" + data.Layout.DatadogSite }
		data-enter-only-query="q"
		hx-get={ "/accounts/needs-anchor/datadog/" + data.Layout.DatadogSite }
		hx-trigger="change delay:150ms from:[data-table-query-trigger], submit"
		hx-sync="this:replace"
		hx-target="#datadog-needs-anchor-results"
		hx-push-url="true"
		class="osspm-list-form"
	>
		<div class="osspm-list-toolbar">
			<div class="min-w-0 flex-1">
				@AskBar(SearchOnlyAskBar(data.Query, "Search email, name, or Datadog ID", "#datadog-needs-anchor-results"))
			</div>
		</div>
		<button class="sr-only" type="submit">Apply filters</button>
	</form>
}

templ DatadogAccountsNeedingAnchorPageResults(data viewmodels.DatadogAccountsNeedingAnchorViewData) {
	<div id="datadog-needs-anchor-results" class="space-y-5">
		@BusyInlineIndicator("Updating results...", false)
		<section class="space-y-3">
			@ListSectionHeader("Datadog users needing anchor", "Datadog users awaiting an authoritative identity anchor.")
			@ColumnsTable("") {
				<table class="table osspm-table-fixed osspm-table-compact osspm-table-list">
					<caption class="sr-only">Datadog users needing anchors and actions to link each account to an identity.</caption>
					<thead>
						<tr>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Email</th>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Name</th>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Datadog ID</th>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Link</th>
						</tr>
					</thead>
					<tbody>
						if data.HasUsers {
							for _, u := range data.Users {
								<tr>
									<td class="font-medium">
											if u.Email != "" {
												<span hx-disable>{ u.Email }</span>
											} else {
											<span class="text-muted-foreground">&mdash;</span>
										}
									</td>
										<td class="text-muted-foreground" hx-disable>{ u.DisplayName }</td>
										<td class="text-xs font-mono text-muted-foreground" hx-disable>{ u.ExternalID }</td>
									<td>
										@sourceAccountNeedsAnchorLinkAction(data.Layout.IsAdmin, data.Layout.CSRFToken, u.ID, "input w-full")
									</td>
								</tr>
							}
						} else if data.Layout.DatadogConfigured && data.Layout.DatadogEnabled && data.Query.Q == "" {
							<tr>
								<td colspan="4">
									@EmptyState("All caught up", "No Datadog users need an anchor. All detected accounts belong to an anchored identity.")
								</td>
							</tr>
						} else {
							<tr>
								<td colspan="4">
									@EmptyState("No users need an anchor", data.EmptyStateMsg)
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
			if data.TotalPages > 1 {
				@ListPagination("datadog-needs-anchor-results", data.Page, data.TotalPages, BasicListPageHref(data.Query))
			}
		</section>
	</div>
}
