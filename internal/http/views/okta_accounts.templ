package views

import (
	"github.com/open-sspm/open-sspm/internal/db/gen"
	"github.com/open-sspm/open-sspm/internal/http/viewmodels"
)

templ OktaAccountMobileRow(account gen.Account) {
	<article class="rounded-lg border border-border/70 bg-card p-4">
		<div class="flex items-start justify-between gap-3">
			<div class="min-w-0">
				<a class="block font-medium no-underline hover:underline break-all" href={ "/accounts/okta/" + FormatInt64(account.ID) }>
					if account.Email != "" {
						{ account.Email }
					} else if account.DisplayName != "" {
						{ account.DisplayName }
					} else {
						{ "Account #" }{ FormatInt64(account.ID) }
					}
				</a>
				if account.DisplayName != "" {
					<div class="text-sm text-muted-foreground" title={ account.DisplayName }>
						<span class="osspm-truncate">{ account.DisplayName }</span>
					</div>
				}
			</div>
			<span class={ StatusBadgeClass(account.Status) }>{ account.Status }</span>
		</div>
	</article>
}

templ OktaAccountsPage(data viewmodels.OktaAccountsViewData) {
	@Layout(data.Layout) {
		@PageHeader("") {
		}

		@OktaAccountsPageResults(data)
	}
}

templ OktaAccountsPageResults(data viewmodels.OktaAccountsViewData) {
	<div id="okta-accounts-results" class="space-y-5">
		@BusyInlineIndicator("Updating results...", false)
		<form
			method="get"
			action="/accounts/okta"
			data-enter-only-query="q"
			hx-get="/accounts/okta"
			hx-trigger="change delay:150ms from:[data-table-query-trigger], submit"
			hx-target="#okta-accounts-results"
			hx-swap="outerHTML"
			hx-push-url="true"
			class="osspm-list-form"
		>
			<div class="osspm-list-toolbar">
				<div class="min-w-0 flex-1">
					@TableQueryBar(ActiveInactiveStateTableQueryBar(data.Query, "Search name, email, or Okta ID"))
				</div>
				<div class="osspm-list-summary">
					if data.TotalCount > 0 {
						{ "Showing " }{ FormatInt(data.ShowingFrom) }{ "-" }{ FormatInt(data.ShowingTo) }{ " of " }{ FormatInt64(data.TotalCount) }
					} else {
						Showing 0
					}
				</div>
			</div>
			<button class="sr-only" type="submit">Apply filters</button>
		</form>

		<section class="space-y-3">
			@ListSectionHeader("Okta Accounts", "Okta accounts synced from your Okta source.")
			if data.HasUsers {
				<div class="space-y-3 lg:hidden">
					for _, u := range data.Users {
						@OktaAccountMobileRow(u)
					}
				</div>
			} else {
				<div class="lg:hidden">
					@EmptyState("No accounts found", data.EmptyStateMsg)
				</div>
			}
			@ColumnsTable("hidden lg:block") {
				<table class="table osspm-table-fixed osspm-table-compact osspm-table-list">
					<caption class="sr-only">Okta user accounts with email, name, and account status.</caption>
					<thead>
						<tr>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Email</th>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Name</th>
							<th class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Status</th>
						</tr>
					</thead>
					<tbody>
						if data.HasUsers {
							for _, u := range data.Users {
								<tr>
									<td class="font-medium">
										<a class="btn-sm-link" href={ "/accounts/okta/" + FormatInt64(u.ID) }>{ u.Email }</a>
									</td>
									<td class="text-muted-foreground">{ u.DisplayName }</td>
									<td>
										<span class={ StatusBadgeClass(u.Status) }>{ u.Status }</span>
									</td>
								</tr>
							}
						} else {
							<tr>
								<td colspan="3">
									@EmptyState("No accounts found", data.EmptyStateMsg)
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
			if data.TotalPages > 1 {
				@ListPagination("okta-accounts-results", data.Page, data.TotalPages, data.Query.WithPage(data.Page-1).Href(), data.Query.WithPage(data.Page+1).Href())
			}
		</section>
	</div>
}
