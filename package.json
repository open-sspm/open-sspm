{
  "name": "open-sspm-ui",
  "private": true,
  "scripts": {
    "vendor:sync": "node ./scripts/vendor-sync.mjs",
    "vendor:check": "node ./scripts/vendor-check.mjs",
    "postinstall": "node ./scripts/vendor-sync.mjs --allow-missing-manifest",
    "build:css": "NODE_OPTIONS='--disable-warning=DEP0205' npx -y @tailwindcss/cli -i ./web/static/src/input.css -o ./web/static/app.css --minify",
    "watch:css": "NODE_OPTIONS='--disable-warning=DEP0205' npx -y @tailwindcss/cli -i ./web/static/src/input.css -o ./web/static/app.css --watch",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "pretest:js": "npm run vendor:check",
    "test:js": "vitest run",
    "test:js:watch": "vitest"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.2",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "htmx-ext-sse": "^2.2.4",
    "htmx.org": "^2.0.10",
    "idiomorph": "^0.7.4",
    "simple-icons": "^16.26.0"
  }
}
